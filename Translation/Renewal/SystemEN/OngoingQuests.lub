    },
    [18219] = {
        Title = "報告する",
        IconName = "ico_ep.bmp",
        Description = {
            "一連の出来事は終わりを迎えた。今、<NAVI>[ニヒル]<INFO>prt_cas_q,21,39,0,101,0</INFO></NAVI>がどうしているか気になる。プロンテラ城へ行って確かめよう！"
        },
        Summary = "ニヒルと会話する"
    },
    [18220] = {
        Title = "氷の城へ",
        IconName = "ico_ep.bmp",
        Description = {
            "ナヤ卿の支援を受けた。<NAVI>[レオン]<INFO>icas_in,111,228,0,101,0</INFO></NAVI>と仲間たちの様子を見るため、氷の城へ戻ろう。"
        },
        Summary = "レオンと会話する"
    },
    [18221] = {
        Title = "レラールを探せ…！",
        IconName = "ico_ep.bmp",
        Description = {
            "蛇の根の1階でレラールを探すことにした。<NAVI>[目印]<INFO>jor_root1,32,75,0,101,0</INFO></NAVI>を調査しよう。"
        },
        Summary = "目印を調査する"
    },
    [18222] = {
        Title = "調査、調査、調査",
        IconName = "ico_ep.bmp",
        Description = {
            "蛇の根に残された目印を調査した後、レラールは神聖な根で情報を交換することを提案した。目印は全部で3箇所ある。"
        },
        Summary = "3つの目印を調査する"
    },
    [18223] = {
        Title = "レラールの目印 1",
        IconName = "ico_ep.bmp",
        Description = {
            "蛇の根の1階に残されたレラールの<NAVI>[目印]<INFO>jor_root1,69,128,0,101,0</INFO></NAVI>の一つ。奥へと続く長い道がある。バゴスの実験室があるか確認しよう。"
        },
        Summary = "目印を調査する"
    },
    [18224] = {
        Title = "レラールの目印 2",
        IconName = "ico_ep.bmp",
        Description = {
            "蛇の根の1階に残されたレラールの<NAVI>[目印]<INFO>jor_root1,35,211,0,101,0</INFO></NAVI>の一つ。奥へと続く長い道がある。バゴスの実験室があるか確認しよう。"
        },
        Summary = "目印を調査する"
    },
    [18225] = {
        Title = "レラールの目印 3",
        IconName = "ico_ep.bmp",
        Description = {
            "蛇の根の1階に残されたレラールの<NAVI>[目印]<INFO>jor_root1,254,66,0,101,0</INFO></NAVI>の一つ。奥へと続く長い道がある。バゴスの実験室があるか確認しよう。"
        },
        Summary = "目印を調査する"
    },
    [18226] = {
        Title = "それはただの嘘。次の場所へ。",
        IconName = "ico_ep.bmp",
        Description = {
            "蛇の根の1階に残された痕跡をすべて調べたが、バゴスの研究室への入り口は見つからなかった。<NAVI>[聖なる根]<INFO>jor_sanct,133,86,0,101,0</INFO></NAVI>でレアールとミリアムに会おう。"
        },
        Summary = "痕跡を調べる"
    },
    [18227] = {
        Title = "聖なる根の調査",
        IconName = "ico_ep.bmp",
        Description = {
            "レアールとミリアムは聖なる根の内部を一緒に調査することになった。中央エリアへ行き、情報を集めるために<NAVI>[司教レルガン]<INFO>jor_sanct,150,207,0,101,0</INFO></NAVI>に話を聞こう。"
        },
        Summary = "司教との会話"
    },
    [18228] = {
        Title = "ニャルの呼び声",
        IconName = "ico_ep.bmp",
        Description = {
            "巨大な振動に誘われて小さな枝の巣に到着した。小さな枝の巣にいる<NAVI>[白い猫]<INFO>jor_twig,187,198,0,101,0</INFO></NAVI>が何かを言いたそうだ。急ぎのようだ。"
        },
        Summary = "白い猫との会話"
    },
    [18229] = {
        Title = "猫たちの背中を踏んで走れ！",
        IconName = "ico_ep.bmp",
        Description = {
            "またしても巨大な振動が発生した。小さな枝の巣の<NAVI>[内部エリア]<INFO>jor_twig,180,123,0,101,0</INFO></NAVI>で何かが起きているようだ。確認しに行こう！"
        },
        Summary = "白い猫との会話"
    },
    [18230] = {
        Title = "皆ここにいたのか？",
        IconName = "ico_ep.bmp",
        Description = {
            "探していたバゴスとラスガンドがどういうわけか小さな枝の巣に侵入していた。ラスガンドと対峙している<NAVI>[ニャル]<INFO>jor_twig,142,153,0,101,0</INFO></NAVI>とレオンを助けなければならない。"
        },
        Summary = "白い猫との会話"
    },
    [18231] = {
        Title = "それで、何があった？",
        IconName = "ico_ep.bmp",
        Description = {
            "小さな枝の巣に侵入したラスガンドは、<NAVI>[ニャル]<INFO>jor_twig,142,153,0,101,0</INFO></NAVI>のドッペルゲンガーと共に消えた。<NAVI>[レオン]<INFO>jor_twig,138,157,0,101,0</INFO></NAVI>にラスガンドの行方を聞いてみよう。"
        },
        Summary = "レオンと会話する"
    },
    [18232] = {
        Title = "分断された聖域",
        IconName = "ico_ep.bmp",
        Description = {
            "ラスガンドが世界樹と巣の力を奪う前に、彼は別次元に隔離された。ラスガンドを強制的に分断したニャルは結界の維持に苦戦しているようだ。<NAVI>[オレッリ]<INFO>jor_twig,138,152,0,101,0</INFO></NAVI>を通じて「分断された聖域」へ向かい、ラスガンドを止めよう。"
        },
        Summary = "ラスガンドの無力化"
    },
    [18233] = {
        Title = "不滅の者",
        IconName = "ico_ep.bmp",
        Description = {
            "イミルの心臥の欠片の力を吸収したラスガンドは、我々が敵わない相手だった。しかし、今は汚染されたイミルの心臥の欠片を持っている。<NAVI>[氷の城]<INFO>icecastle,158,204,0,101,0</INFO></NAVI>に戻ろう。チチリンは<NAVI>[ボックリンデ]<INFO>icecastle,75,126,0,101,0</INFO></NAVI>の居場所を知っている。"
        },
        Summary = "ボックリンデとの会話"
    },
    [18234] = {
        Title = "アウィンのアウィンな悩み",
        IconName = "ico_dq.bmp",
        Description = {
            "氷の城の<NAVI>[チチリン]<INFO>icecastle,75,126,0,101,0</INFO></NAVI>からの依頼。古代の氷の風の安全を確保するため、深い根の洞窟のモンスターを討伐しなければならない。"
