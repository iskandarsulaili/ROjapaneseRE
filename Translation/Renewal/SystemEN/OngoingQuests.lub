		Title = "バードへの転職",
		IconName = "ico_jq.bmp",
		Description = {
			"美しい歌声で歌う<NAVI>[バード]<INFO>comodo,211,155,0,101,0</INFO></NAVI>に会った。あんなカッコいいバードになりたいな…頼んでみようかな？"
