		IconName = "ico_ep.bmp",
		Description = {
			"会議に参加する"
		},
		Summary = ""
	},
	[8207] = {
		Title = "ハンセンヌは無実",
		IconName = "ico_ep.bmp",
		Description = {
			"私が望んでいたのは、あの人たちが親しくなり、もっと仲良くなることだったのに…。でも、毎回問題が起きてしまうの。あの人たちを仲直りさせる方法、何か思いつかない？"
