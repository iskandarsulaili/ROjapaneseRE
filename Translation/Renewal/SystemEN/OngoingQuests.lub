	},
	[8698] = {
		Title = "遅い移住",
		IconName = "ico_ep.bmp",
		Description = {
			"ラヘルのホテルで出会った従業員のホリムは、グレイウルフ村へ行きたいと考えている。彼女を手伝うため、<NAVI>[ラヘル西門の外]<INFO>ra_fild11,358,229,0,101,0</INFO></NAVI>で会うことに同意した。"
		},
		Summary = "ホリムに話しかける"
	},
	[8699] = {
		Title = "街の外への第一歩",
		IconName = "ico_ep.bmp",
		Description = {
			"ホリムは、生涯ずっと住んでいた場所に帰属感を感じたことがないと言った。まだ躊躇している彼女を<NAVI>[案内]<INFO>ra_fild10,375,293,0,101,0</INFO></NAVI>しなければならない。"
		},
		Summary = "ホリムに話しかける"
	},
	[8700] = {
		Title = "半分も来ていない。",
		IconName = "ico_ep.bmp",
		Description = {
			"ホリムはケチなようだが、単に初めての道だからのようだ。体力はあるので、思ったよりずっとついてくるのは簡単だ。<NAVI>[案内]<INFO>oz_dun01,285,170,0,101,0</INFO></NAVI>を続けられると思う。"
		},
		Summary = "ホリムに話しかける"
	},
	[8701] = {
		Title = "初めて見る",
		IconName = "ico_ep.bmp",
		Description = {
			"ホリムは大自然に圧倒され、灰色狼の森がどんな場所か尋ねてきた。しかし、ホリムが聞いた話と現実に大差はないだろう。ホリムは案内を続けるよう促している。<NAVI>[案内する]<INFO>gw_fild01,275,338,0,101,0</INFO></NAVI>"
		},
		Summary = "ホリムに話しかける"
	},
	[8702] = {
		Title = "灰の匂い",
		IconName = "ico_ep.bmp",
		Description = {
			"不用心な連中があちこちで軍事基地の秘密を話しているらしい。ともかく、匂いで場所がわかるほど危険な場所だ。彼女を<NAVI>[案内する]<INFO>gw_fild01,38,99,0,101,0</INFO></NAVI>しかない。"
		},
		Summary = "ホリムに話しかける"
	},
	[8703] = {
		Title = "簡単な道",
		IconName = "ico_ep.bmp",
		Description = {
			"ホリムは帰るべき場所が必要だと言う。それは、家が彼女の帰りたかった場所ではなかったということだろうか？彼女は長く座ってはいられない。<NAVI>[案内]<INFO>wolfvill,266,26,0,101,0</INFO></NAVI>を続けよう。"
		},
		Summary = "ホリムに話しかける"
	},
	[8704] = {
		Title = "神殿の閉鎖（1）",
		Description = {
			"神殿の扉が突然閉ざされてしまった。心配する聖職者ネマのため、別の入り口がないか<NAVI>[聞き込み]<INFO>rachel,243,37,0,101,0</INFO></NAVI>をしよう。"
		},
		Summary = "別の入り口を知る人物を探そう"
	},
	[8705] = {
		Title = "神殿の閉鎖（2）",
		Description = {
			"神殿には鍵のかかっていない<NAVI>[窓]<INFO>ra_temple,67,209,0,101,0</INFO></NAVI>があり、そこから忍び込めるという……。"
		},
		Summary = "開いている窓を探そう"
	},
	[8706] = {
		Title = "神殿の閉鎖（3）",
		Description = {
			"無事に神殿へ忍び込むことに成功した。<NAVI>[入り口の方]<INFO>que_rachel,59,112,0,101,0</INFO></NAVI>へ向かおう。"
		},
		Summary = "神殿内部の探索"
	},
	[8707] = {
		Title = "神殿の閉鎖（4）",
		Description = {
			"どこからか<NAVI>[音]<INFO>que_rachel,94,138,0,101,0</INFO></NAVI>が聞こえる。その音を追ってみよう。"
		},
		Summary = "礼拝堂へ続く廊下へ向かおう"
	},
	[8708] = {
		Title = "神殿の閉鎖（5）",
		Description = {
			"奇妙な音が聞こえる。<NAVI>[階段の横]<INFO>que_rachel,132,70,0,101,0</INFO></NAVI>から聞こえてくるようだ。"
		},
		Summary = "階段の方へ進もう"
	},
	[8709] = {
		Title = "神殿の閉鎖（6）",
		Description = {
			"<NAVI>[音]<INFO>que_rachel,239,258,0,101,0</INFO></NAVI>は階段の上から聞こえてくるようだ。上の階へ行こう。"
		},
		Summary = "階段を上ろう"
	},
	[8710] = {
		Title = "神殿の閉鎖（7）",
		Description = {
			"<NAVI>[音]<INFO>que_rachel,28,315,0,101,0</INFO></NAVI>が聞こえた方へ進んでみよう。"
		},
		Summary = "神殿内部の探索"
	},
	[8711] = {
		Title = "神殿の閉鎖（8）",
		Description = {
			"何かを探している最中に誰かに見つかったらどうしようか？血痕をもう一度調べることにした。"
		},
		Summary = "血痕の調査"
	},
	[8712] = {
		Title = "神殿の閉鎖（9）",
		Description = {
			"これ以上長居して誰かに出くわしたらどうなるかわからない。まずは<NAVI>[扉]<INFO>que_rachel,169,18,0,101,0</INFO></NAVI>へ向かおう。"
		},
		Summary = "神殿のロビーへ向かおう"
	},
	[8713] = {
		Title = "神殿の閉鎖（10）",
		Description = {
			"無事に扉が開き、外に出ることができた。<NAVI>[聖職者ネマ]<INFO>rachel,116,174,0,101,0</INFO></NAVI>と話そう。"
		},
		Summary = "聖職者ネマと話そう"
	},
	[8714] = {
		Title = "神殿の閉鎖（11）",
		Description = {
			"神殿にいる<NAVI>[聖職者ファノ]<INFO>ra_temin,170,46,0,101,0</INFO></NAVI>に聞きたいことがある。"
		},
		Summary = "聖職者ファノと話そう"
	},
	[8715] = {
		Title = "神殿の閉鎖（12）",
		Description = {
			"神殿にいる<NAVI>[聖職者ファノ]<INFO>ra_temin,170,46,0,101,0</INFO></NAVI>に聞きたいことがある。"
		},
		Summary = "聖職者ファノと話そう"
	},
	[8716] = {
		Title = "神殿の閉鎖（13）",
		Description = {
			"<NAVI>[聖職者ネマ]<INFO>rachel,116,174,0,101,0</INFO></NAVI>は本当に何も知らないのだろうか？"
		},
		Summary = "聖職者ネマと話そう"
	},
	[8717] = {
		Title = "神殿の閉鎖（14）",
		Description = {
			"<NAVI>[聖職者ネマ]<INFO>rachel,116,174,0,101,0</INFO></NAVI>が<ITEM>[花火]<INFO>12018</INFO></ITEM>を20個持ってきてほしいと頼んできた。"
		},
		Summary = "物資の納品"
	},
	[8718] = {
		Title = "友人の別れ",
		IconName = "ico_ep.bmp",
		Description = {
			"灰色狼の村のアルベルトは、ラヘルのホテルで働く友人<NAVI>[ホリム]<INFO>ra_in01,388,59,0,101,0</INFO></NAVI>の身を案じている。"
		},
		Summary = "ホリムに話しかける"
	},
	[8719] = {
		Title = "アントヘルのどこかにある新エリア",
		Description = {
			"アントヘル2階を探索していたミルコとヨランダが、ダンジョンのどこかに新たな蟻の巣穴を発見したという。だが、その場所は……。"
		},
		Summary = "ミルコに話しかける"
	},
	[8720] = {
		Title = "ミルコの依頼（1）",
		Description = {
			"ミルコによると、仲間の冒険者ブリアシェンが行方不明になったという。少し前に発見された知覚の庭園の探索へ向かったブリアシェンは、戻ってこなかったのだ。"
		},
		Summary = "ミルコに話しかける"
	},
	[8721] = {
		Title = "ブリアシェンはどこに",
		Description = {
			"知覚の庭園でブリアシェンを探そう。ただ、無事でいてほしいと願っている。"
		},
		Summary = "ブリアシェンに話しかける"
	},
	[8722] = {
		Title = "ブリアシェンの伝言",
		Description = {
			"ブリアシェンは今すぐ戻ることはできないと言い、無事だと<NAVI>[ミルコ]<INFO>anthell02,177,190,0,101,0</INFO></NAVI>に伝えてほしいと頼んできた。彼は妙に元気そうに見える。"
		},
		Summary = "ミルコに話しかける"
	},
