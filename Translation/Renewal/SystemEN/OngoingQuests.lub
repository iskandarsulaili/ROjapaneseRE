		IconName = "ico_dq.bmp",
		Description = {
			"これはデイリークエストであり、タイマー終了後に再受注可能です。楽園のチャンピオン討伐クエストは<NAVI>掲示板<INFO>moc_para01,16,33,0,101,0</INFO></NAVI>で可能です。"
		},
		Summary = "04:00にリセット",
		CoolTimeQuest = 1
	},
	[21900] = {
		Title = "こんにちは！",
		Description = {
			"イズルードには冒険者を支援するアカデミーやギルドがあります。北イズルードにあるクリエイターアカデミーの<NAVI>スプラキ<INFO>iz_ac01,102,44,0,101,0</INFO></NAVI>に会いに行きましょう。"
		},
		Summary = "スプラキに話しかける"
	},
	[21901] = {
		Title = "知っておくべきサービス",
		Description = {
			"スプラキは冒険するために知っておくべきことがあると言い、イズルード中心部にいる<NAVI>カプラ職員<INFO>izlude,128,148,0,101,0</INFO></NAVI>に会うよう頼みました。"
		},
		Summary = "カプラ職員に話しかける"
	},
	[21902] = {
		Title = "初めての依頼ですか？",
		Description = {
			"カプラ職員から<NAVI>モリス<INFO>izlude_in,69,116,0,101,0</INFO></NAVI>へ配達箱を届けるよう頼まれました。モリスはイズルードの道具屋にいます。"
		},
		Summary = "箱をモリスに届ける"
	},
	[21903] = {
		Title = "レノを見ていない人は？",
		Description = {
			"道具屋のモリスから、薬草を見に行った「赤髪の検察官レノ」の行方を探してほしいと頼まれました。「レノ」に関する情報を集めましょう。"
		},
		Summary = "ウルに話しかける"
	},
	[21904] = {
		Title = "薬草追跡者の行方",
		Description = {
			"修行に没頭するレノに代わって薬草畑を確認することにしました。実は、レノの代わりに彼に会いに行った友達がいるのですが……。"
		},
		Summary = "子供に話しかける"
	},
	[21905] = {
		Title = "????????",
		Description = {
			"ルナティックを倒して「クローバー」を手に入れる賭けをしました。一方的ですが……。「ルナティック」は近くにいるので、さっそく倒しましょう。"
		},
		Summary = "子供へのクローバーのお返し"
	},
	[21906] = {
		Title = "????????",
		Description = {
			"ルミンから、子供の近くに薬草があると教えてもらいました。集めた薬草と共に修行中の<NAVI>レノとウル<INFO>prt_fild08,320,230,0,101,0</INFO></NAVI>の元へ戻りましょう。"
		},
		Summary = "ウルに話しかける"
	},
	[21907] = {
		Title = "?????",
		Description = {
			"ウルから検察官のことを聞きました。手に入れた薬草を<NAVI>モリス<INFO>izlude_in, 69,116,0,101,0</INFO></NAVI>に届けましょう。"
		},
		Summary = "モリスに話しかける"
	},
	[21908] = {
		Title = "緊急の時のために",
		Description = {
			"道具屋のモリスから「応急処置キット」を受け取りました。「クリエイターアカデミー」の保健室にいる<NAVI>治療師<INFO>iz_ac01,60,43,0,101,0</INFO></NAVI>に会い、使い方を教わってきましょう。"
		},
		Summary = "治療師に話しかける"
	},
	[21909] = {
		Title = "ゼロピーでできること",
		Description = {
			"イズルードで出会った弓使いの<NAVI>マルブロン<INFO>izlude,115,103,0,101,0</INFO></NAVI>は、矢分裂のスキルに使う素材として「ゼロピー」を3個欲しがっています。「ゼロピー」は「ポリン」から入手できます。"
		},
		Summary = "ゼロピー3個をマルブロンに届ける"
	},
	[21910] = {
		Title = "プロンテラへ！",
		Description = {
			"立派な楽園の一員となり、「プロンテラ大聖堂」の難題を解決することになりました。<NAVI>仲間<INFO>prt_fild08,182,359,0,101,0</INFO></NAVI>に会い、合流しましょう。"
		},
		Summary = "レノに話しかける"
	},
	[21911] = {
		Title = "3枚のビラ",
		Description = {
			"プロンテラ北側の内壁にビラを貼ることにしました。大通りを上がると、「ブラン」の目印がついた壁が見えるかもしれません……。"
		},
		Summary = "ビラを貼る"
	},
	[21912] = {
		Title = "ビラの内容",
		Description = {
