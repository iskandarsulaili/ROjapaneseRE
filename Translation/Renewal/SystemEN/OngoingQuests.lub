	[18118] = {
		Title = "神秘の楽器",
		Description = {
			"老人が楽器を作ってくれるのを待とう。"
		},
		Summary = "老いた見知らぬ人"
	},
	[18119] = {
		Title = "北風の客1",
		IconName = "ico_ep.bmp",
		Description = {
			"北方の地に関する情報が集まったらしい。マラムとミリアムはヴァルムントの屋敷へ向かうことにした。ヴァルムントの屋敷の応接間で待つ<NAVI>[エリー]<INFO>ba_in01,384,114,0,101,0</INFO></NAVI>と今後の予定について話そう。"
		},
		Summary = "ヴァルムントの屋敷へ向かう"
	},
	[18120] = {
		Title = "北風の客2",
		IconName = "ico_ep.bmp",
		Description = {
			"プロンテラ城からイズガルドに関する情報を得ることにした。ヴァルムントの屋敷にいる<NAVI>[クルックス]<INFO>ba_in01,386,110,0,101,0</INFO></NAVI>の案内でプロンテラ王宮へ向かおう。"
		},
		Summary = "プロンテラ城へ向かう"
	},
	[18121] = {
		Title = "守護者の箱と招待状1",
		IconName = "ico_ep.bmp",
		Description = {
			"レハールによれば、守護者の箱を通じてイズガルドの守護者から訪問許可を得る必要がある。プロンテラ城の<NAVI>[ニヒル]<INFO>prt_cas,331,343,0,101,0</INFO></NAVI>の部屋に保管されている守護者の箱を使い、招待状を受け取ることにした。"
		},
		Summary = "部屋にいるニヒルに話しかける"
	},
	[18122] = {
		Title = "守護者の箱と招待状2",
		IconName = "ico_ep.bmp",
		Description = {
			"招待状を手に入れた。<NAVI>[ヴァルムントの屋敷]<INFO>ba_maison,186,251,0,101,0</INFO></NAVI>に戻り、一行に合流しよう。"
		},
		Summary = "ヴァルムントの屋敷へ向かう"
	},
	[18123] = {
		Title = "守護者の箱と招待状3",
		IconName = "ico_ep.bmp",
		Description = {
			"ヴァルムントの屋敷に到着したら、<NAVI>[飛行船乗り場]<INFO>ba_in01,30,264,0,101,0</INFO></NAVI>からいつでも出発できるという。飛行船に乗り込み、招待状をジンジャーに届けよう。"
		},
		Summary = "ジンジャーに話しかける"
	},
	[18124] = {
		Title = "守護者の箱と招待状5",
		IconName = "ico_ep.bmp",
		Description = {
			"飛行船に乗り込み、招待状の加護により無事にイズガルドへ着陸した。飛行船を降りて周囲を確認し、<NAVI>[レハール]<INFO>jor_tail,221,53,0,101,0</INFO></NAVI>の案内を受けよう。"
		},
		Summary = "レハルと話す"
	},
	[18125] = {
		Title = "氷の奥へ",
		IconName = "ico_ep.bmp",
		Description = {
			"レハールの案内で氷の城と呼ばれる場所へ移動することにした。氷の城に到着したら、<NAVI>[レハール]<INFO>icas_in,141,216,0,101,0</INFO></NAVI>を通じて守護者に紹介してもらおう。"
		},
		Summary = "レハルと話す"
	},
	[18126] = {
		Title = "氷の城での出会い",
		IconName = "ico_ep.bmp",
		Description = {
			"イズガルドの氷の城で、守護者のレオンとオレリ、そしてアーヴィンたちが封印を監視していた。<NAVI>[レオン]<INFO>icas_in,138,220,0,101,0</INFO></NAVI>と話を続けよう。"
		},
		Summary = "レオンに話しかける"
	},
	[18127] = {
		Title = "アーヴィンの斥候に会う",
		IconName = "ico_ep.bmp",
		Description = {
			"レオンは、イズガルド周辺を定期的に偵察しているアーヴィンの斥候と会うのが有益だと助言した。氷の城の入り口にいる<NAVI>[巡回隊長]<INFO>icecastle,23,115,0,101,0</INFO></NAVI>に会おう。"
		},
		Summary = "アーヴィンの斥候と話す"
	},
	[18128] = {
		Title = "ヴォグリンデに会おう",
		IconName = "ico_ep.bmp",
		Description = {
			"ヴォグリンデが何か質問があるようだ。氷の城で待っている<NAVI>[ヴォグリンデ]<INFO>icas_in,162,224,0,101,0</INFO></NAVI>に会おう。"
		},
		Summary = "ヴォグリンデと話す"
	},
	[18129] = {
		Title = "守護者の箱と招待状4",
		IconName = "ico_ep.bmp",
		Description = {
			"到着するまで、飛行船で仲間たちと会話を楽しもう。"
		},
		Summary = "仲間たちと話す"
	},
	[18130] = {
		Title = "ヴェルグンデの研究材料調達",
		IconName = "ico_dq.bmp",
		Description = {
			"氷の城でイェルムンガルドの呪いを研究しているヴェルグンデは、材料として大量の精製魔法コアを必要としている。Rganを倒して手に入るRganの下級魔法コアをフリーデリケを通じて精製し、ヴェルグンデに届けよう。"
		},
		Summary = "精製魔法コア 3個"
	},
	[18131] = {
		Title = "[待機] ヴェルグンデの研究材料調達",
		IconName = "ico_dq.bmp",
		Description = {
			"このクエストはデイリークエストで、待機時間が終了すると再び受けられる。氷の城にいる<NAVI>[ヴェルグンデ]<INFO>icas_in,185,63,0,101,0</INFO></NAVI>からクエストの指示を受けることができる。"
		},
		Summary = "04:00にリセット",
		CoolTimeQuest = 1
	},
	[18132] = {
		Title = "誰かが必要だ",
		IconName = "ico_ep.bmp",
		Description = {
			"氷の城のロビーで出会ったレハールが、レオンが急いで助けを求めていると教えてくれた。<NAVI>[レオン]<INFO>icas_in,42,252,0,101,0</INFO></NAVI>に会い、話を聞こう。"
		},
		Summary = "レオンに話しかける"
	},
	[18133] = {
		Title = "レオンの物語",
		IconName = "ico_ep.bmp",
		Description = {
			"イズガルドの過酷な氷の平原を彷徨う生存者を救出する方法について、<NAVI>[ミリアム]<INFO>icas_in,48,252,0,101,0</INFO></NAVI>と相談しよう。"
