	[7172] = {
		Title = "幻影の鍵",
		IconName = "ico_jq.bmp",
		Description = {
			"氷の洞窟の奥深くで見つけたのは幻影の鍵だった。しかし、そこにも財宝は隠されていなかった。ラヘルにいる<NAVI>[ポール]<INFO>s_atelier,168,65,0,101,0</INFO></NAVI>のもとへ戻り、報告しよう。"
