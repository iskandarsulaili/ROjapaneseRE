	},
	[7212] = {
		Title = "ロキが探しているもの",
		IconName = "ico_ep.bmp",
		Description = {
			"<NAVI>[霧の森]<INFO>bif_fild01,161,355,0,101,0</INFO></NAVI>で偶然出会ったロキという名の男は、誰かを探しているようだ。紫の髪の人物。どういう意味だろうか？ もし似たような人物を見つけたら、ロキに伝えてみようか？"
		},
		Summary = ""
	},
	[7213] = {
		Title = "さまよえる守護者",
		IconName = "ico_ep.bmp",
		Description = {
			"ロキが探していたのは、霧の森をさまよっていた守護者<NAVI>[ニーズヘッグ]<INFO>mora,46,152,0,101,0</INFO></NAVI>だった。彼らは森を出て、モラ村で再会することにした。"
		},
		Summary = "ロキに話しかける"
	},
	[7214] = {
		Title = "上級訓練 第1段階 コモド討伐",
		Description = {
			"コモド北の洞窟の前で、イードゥン・グループから派遣されたメンバー「ロメオ」が次の訓練生を待っている。"
		},
		Summary = "コモドでロメオを見つける"
	},
	[7215] = {
		Title = "第1段階 第1部 - 討伐",
		Description = {
			"ロメオは洞窟内の雰囲気と敵を知るために、スタラクティックゴーレムを倒すよう依頼した。周囲の他のモンスターに気をつけながら、スタラクティックゴーレムを処理しよう。"
		},
		Summary = "スタラクティックゴーレム 3体討伐"
	},
	[7216] = {
		Title = "第1段階 第2部 - 北の洞窟突破",
		Description = {
			"洞窟の様子と敵の様子が分かったら、次は敵を突破して洞窟を抜ける任務だ。ロメオは洞窟の反対側で待っている。"
		},
		Summary = "ゴーレムを倒して洞窟を突破する。スタラクティックゴーレム 10体。"
	},
	[7217] = {
		Title = "第1段階 第3部 - フィールドの掃除",
		Description = {
			"ロメオは洞窟を突破した私の能力を称賛し、次の任務を与えた。ウータンファイターとドライアドを倒して戦利品を入手し、森に平和をもたらすことが目標だ。"
		},
		Summary = "ショルダープロテクター 5個、鋭い葉 7個"
	},
	[7218] = {
		Title = "ウル教官に報告",
		Description = {
			"イードゥン・グループの上級訓練コース第1段階のコモド討伐の任務をすべて完了した。残るはイードゥン・グループ本部に戻り、ウル教官に報告することだ。"
		},
		Summary = "ウル教官に報告"
	},
	[7219] = {
		Title = "上級訓練 第2段階 グラストヘイム",
		Description = {
			"イードゥン・グループの上級訓練の第2段階はグラストヘイムで始まる。グラストヘイム修道院の前で「ヨハン」に会い、訓練の課題を受けよう。"
		},
		Summary = "グラストヘイムでヨハンを見つける"
	},
	[7220] = {
		Title = "第2段階 第1部 - レイス",
		Description = {
			"ヨハンは修道院の1階に出現した強力なレイスを倒す任務を与えた。"
		},
		Summary = "レイス 20体討伐"
	},
	[7221] = {
		Title = "第2段階 第2部 - イビルドルイド",
		Description = {
			"グラストヘイム修道院には、かつて苦行を積んでいた腐敗した聖職者たちがいる。しかし、腐敗した聖職者はもはや人々を救うことができない。だから彼らは再び目覚める……。"
		},
		Summary = "イビルドルイド 10体討伐"
	},
	[7222] = {
		Title = "ウル教官に報告",
		Description = {
			"いくつか不明な点はあるが、ヨハンは十分だと宣言し、すべての訓練課題は終了した。イードゥン・グループ本部に戻り、ウル教官に報告しよう。"
		},
		Summary = "ウル教官に報告"
	},
	[7223] = {
		Title = "上級訓練 第3段階 アインブロック",
		Description = {
			"アインブロックの南で、イードゥン・グループから派遣されたメンバー「キレン」が次の訓練課題を伝えるために待っている。ウル教官は休憩だと思って気楽に行ってこいと言ったが……。"
		},
		Summary = "キレンに話しかける"
	},
	[7224] = {
		Title = "第3段階 第1部 - ポルチェリオ",
		Description = {
			"キレンはかなりお気楽な性格で、近くのフィールドを軽く歩き回ってポルチェリオを倒すという課題を出した。どうやら近隣住民からの依頼のようだ。"
		},
		Summary = "ポルチェリオ 30体討伐"
	},
	[7225] = {
		Title = "第3段階 第2部 - これは悪夢だ(1)",
		Description = {
			"アインブロックの苦情を100%反映した訓練事業でノクシャスを倒す依頼だったが、キレンが一方的に依頼を取り下げた。"
		},
		Summary = "ノクシャスを倒す必要はない。"
	},
	[7226] = {
		Title = "第3段階 第2部 - これは悪夢だ(1)",
		Description = {
			"アインブロック住民の陳情を100%反映した訓練課題。やるべきことは街の北にある煤の原因を処理することだ。"
		},
		Summary = "ベノマス 30体討伐"
	},
	[7227] = {
		Title = "第3段階 第2部 - これは悪夢だ(2)",
		Description = {
			"アインブロック住民の苦情の中で最大の問題の一つ。兵器として生産され、廃棄されたテディベアの駆除。キレンは非常に強力な敵だから気をつける必要があると言っていた。"
		},
		Summary = "テディベア 5体討伐"
	},
	[7228] = {
		Title = "ウル教官に報告",
		Description = {
			"訓練生として、アインブロック住民からの依頼をすべて完了した。イードゥン・グループ本部に戻り、ウル教官に報告しよう。"
		},
		Summary = "ウル教官に報告"
	},
	[7229] = {
		Title = "上級訓練 第4段階 氷の洞窟",
		Description = {
			"訓練の最終段階は、ラヘルの北東、アイダ平原の果てにある氷の洞窟だ。ナオミという名のメンバーが洞窟の入り口で待っている。"
		},
		Summary = "ナオミに話しかける"
	},
	[7230] = {
		Title = "第4段階 第1部 - シロマ",
		Description = {
			"近隣住民の要望を100%反映した訓練課題もあった。氷採取の邪魔になるシロマを排除しよう。"
		},
		Summary = "シロマ 30体討伐"
	},
	[7231] = {
		Title = "第4段階 第2部 - 氷！",
		Description = {
			"増殖速度がかなり速いシロマを追加で駆除することになった。ナオミ個人の依頼も受けた。ナオミは違うと言ったが、これは絶対にかき氷の材料だ。氷のキューブ 30個、スイートソース 1個、牛乳 1個。"
		},
		Summary = "シロマ 30体を討伐し、かき氷の材料を持ってくる"
	},
	[7232] = {
		Title = "ウル教官に報告",
		Description = {
			"かき氷のことはさておき、氷採取の邪魔だったシロマもほどほどに処理した。すべてのクエストと訓練を完了した。イードゥン・グループ本部に戻り、ウル教官に報告しよう。"
		},
		Summary = "ウル教官に報告"
	},
	[7233] = {
		Title = "上級訓練 第4段階 灰の荒野",
		Description = {
			"ウル教官は最後の訓練課題として灰の荒野探検隊に向かったイードゥン・グループのメンバー、マーガレットに会い、彼女の仕事を手伝うよう私に頼んだ。"
		},
		Summary = "マーガレットに話しかける"
	},
	[7234] = {
		Title = "マーガレットの頼み",
		Description = {
			"探検隊のキャンプで出会ったマーガレットは、同僚のミルとマインが戻らないためとても心配している。ミルとマインを探し出し、何があったのか確かめよう。ミルは東に、マインは西にいる。ミルに会った後、マインに会おう。"
		},
		Summary = "ミルとマインを探す"
	},
	[7235] = {
		Title = "第4段階 ミルの事情",
		Description = {
			"双子の兄弟ミルとマインは、些細な口論のせいで反対方向に偵察に出かけた。ミルは約束していたウツボカズラの捕獲を手伝ってほしいと頼んできた。"
		},
		Summary = "ウツボカズラ 1体討伐"
	},
	[7236] = {
		Title = "第4段階 マインの事情",
		Description = {
			"ミルとの摩擦により、マインは一人でムシトリスレを倒さなければならなくなった。マインがムシトリスレを倒す方法を見つけるのを手伝おう。"
		},
		Summary = "ピンギキュラを5体討伐する"
	},
	[7237] = {
		Title = "ウル教官に報告",
		Description = {
			"マーガレットから、悩みが解決したことと訓練は十分であることをイーデン団本部のウル教官に報告するよう言われた。"
		},
		Summary = "ウル教官に報告"
	},
	[7238] = {
		Title = "ソーンの用事（Easy）",
		Description = {
			"イーデン団の鍛冶師ソーンからの依頼だ。この用事の核心は、ソーンが必要としている「鉄鉱石20個と鉄10個」を入手することである。"
		},
		Summary = "鉄鉱石20個、鉄10個"
	},
	[7239] = {
		Title = "ソーンの用事（Normal）",
		Description = {
			"イーデン団の鍛冶師ソーンからの依頼だ。この用事の核心は、ソーンが必要としている「使用済みの鉄板20個」を入手することである。もちろん、その途中でピットマンを倒せればさらによし！"
		},
		Summary = "使用済みの鉄板20個"
	},
	[7240] = {
		Title = "ソーンの装備強化チケット",
		Description = {
			"ソーンの依頼を解決した報酬として保証された装備強化チケット。イーデン団マントⅡ、イーデン団制服Ⅳ、イーデン団ブーツⅣのいずれか一つを強化できる。強化効果は毎回ランダムに変化するので、よく考える必要がある。"
		},
		Summary = ""
	},
	[7241] = {
		Title = "[待機中] ソーンの用事",
		Description = {
			"当面、ソーンには十分な量のアイテムがあるようだ。1日後にまた戻ろう。"
		},
		Summary = "04:00にリセット",
		CoolTimeQuest = 1
	},
	[7242] = {
		Title = "子猫たちと遊ぶ",
		Description = {
			"マラン島で出会ったベテラン船乗りのラトからの依頼だ。彼は子猫たちのことが心配で、彼らを見つけて遊んでほしいと頼んだ。ラトが言う<NAVI>[子猫たち]<INFO>malangdo,213,202,0,101,0</INFO></NAVI>を探そう。白いのがロージー、黒いのがロク、金色のがチャロだ。"
		},
		Summary = ""
	},
	[7243] = {
		Title = "ニャ冒険 - ドゥルドゥルコンパス",
		Description = {
			"自らを「ニャ勇気隊」と名乗る子猫たちから冒険カードAを受け取った。このカードは彼らが作った装置を動かすのに必要なようだ。<NAVI>[始まりのコンパス]<INFO>malangdo,213,202,0,101,0</INFO></NAVI>にカードを挿入すると、ゲームが始まる。"
		},
		Summary = ""
	},
	[7244] = {
		Title = "ニャ冒険 - ドゥルドゥルレース",
		Description = {
			"ドゥルドゥルコンパスレースが始まった。制限時間内に正しい順序でレースを完走しなければならない。コンパスの順序は（赤い炎）->（青い炎）->（金色の炎）->（森）->（雲）だ。"
		},
		Summary = "制限時間：3分"
	},
	[7245] = {
		Title = "ニャ冒険 - ドゥルドゥルレース",
		Description = {
			"ドゥルドゥルコンパスレースが始まった。制限時間内に正しい順序でレースを完走しなければならない。コンパスの順序は（金色の炎）->（青い炎）->（雲）->（森）->（赤い炎）だ。"
		},
		Summary = "制限時間：3分"
	},
	[7246] = {
		Title = "ニャ冒険 - 今行くニャ。",
		Description = {
			"チャロによると、マランドの中心にある船ナビの近くに<NAVI>[探偵]<INFO>malangdo,172,178,0,101,0</INFO></NAVI>がいるらしい。名探偵とその仲間たちに会いに行こう。"
		},
		Summary = ""
	},
	[7247] = {
		Title = "ニャ冒険 - バンバン止まれ！",
		Description = {
			"本当に探偵なのか疑問だが、自称探偵だというホムニャと彼女のニャンソンは、目の前の<NAVI>[機械]<INFO>malangdo,174,178,0,101,0</INFO></NAVI>が爆発するとマランド全体が破壊されてしまうと言って、止めるよう頼んできた。機械を止めてほしいと頼まれた。"
		},
		Summary = ""
	},
	[7248] = {
		Title = "",
		Description = { "" },
		Summary = ""
	},
	[7249] = {
		Title = "[待機中] ニャ冒険 - バン！また会おう",
		Description = {
			"<NAVI>[ホムニャ]<INFO>malangdo,172,178,0,101,0</INFO></NAVI>とニャンソンによると、バンという名のこの機械は毎回発作を起こすらしい。いつまた暴走するか分からないので、明日また訪れることにした。"
		},
		Summary = "04:00にリセット",
		CoolTimeQuest = 1
	},
	[7250] = {
		Title = "ニャ冒険 - 隠された財宝？",
		Description = {
			"バンが止まると、ホムニャとニャンソンが有益な情報を教えてくれた。財宝について何か話している。ホムニャによると、その財宝は船ナビの中にあるらしい。冗談かもしれないが、試してみる価値はある。"
		},
		Summary = ""
	},
	[7251] = {
