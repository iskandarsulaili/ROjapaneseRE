	[7416] = {
		Title = "面会を待つ",
		IconName = "ico_ep.bmp",
		Description = {
			"参謀と話した後、ラピネスの王である<NAVI>[村長ジュン]<INFO>ecl_in03,41,90,0,101,0</INFO></NAVI>との面会を申し込まれた。待ち時間が終わったら、さらに道順を尋ねるためにもう一度<NAVI>[エクルラージュ衛兵]<INFO>ecl_in01,82,70,0,101,0</INFO></NAVI>に聞こう。"
