		Summary = "ポールに話しかける"
	},
	[7173] = {
		Title = "ポールからハレドへの伝言",
		IconName = "ico_jq.bmp",
		Description = {
			"ポールは財宝ではなかったことにひどく失望し、ジュノーのシャドウ工房にいる<NAVI>[ハレド]<INFO>s_atelier,167,129,0,101,0</INFO></NAVI>の元へ行くよう告げた。もし彼が協力してくれないなら、ポールからのこの伝言を渡してくれ：^4d4dffI know what you did last summer!^000000"
		},
		Summary = "ジュノーのシャドウ工房の管理者ハレドの元へ"
	},
	[7174] = {
		Title = "謎の暗号文 - 第4",
		IconName = "ico_jq.bmp",
		Description = {
			"<NAVI>[ハレド]<INFO>s_atelier,167,129,0,101,0</INFO></NAVI>が持っていた手がかりは短い歌だった。この歌が示す場所を見つける必要がある。(^4d4dff生命の樹の細い根 / あらゆる生き物の涙 / あらゆる死者のため息 / 彼らはかつて我々だったが、今は違う / 夜の忘れられた住人たち / 真夜中に奏でられる絶望のワルツ^000000)"
