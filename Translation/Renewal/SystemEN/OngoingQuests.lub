		Summary = "氷の城へ"
	},
	[11810] = {
		Title = "浄化の聖人",
		IconName = "ico_ep.bmp",
		Description = {
			"氷の城にある<NAVI>[フリーデリケ]<INFO>icecastle,59,213,0,101,0</INFO></NAVI>の部屋へ行こう。"
		},
		Summary = "フリーデリケと話す"
	},
	[11811] = {
		Title = "浄化の聖人",
		IconName = "ico_ep.bmp",
		Description = {
			"ヴォグリンデが氷の城とフリーデリケの部屋を訪ね、フリーデリケが無事に到着したことを確認して戻った。次の任務は<NAVI>[レハル]<INFO>icas_in,35,118,0,101,0</INFO></NAVI>に任されているようだ。話してみよう。"
		},
		Summary = "レハルと話す"
	},
	[11812] = {
		Title = "フリーデリケの日",
		IconName = "ico_ep.bmp",
		Description = {
			"氷の城のフリーデリケの部屋にいる<NAVI>[フリーデリケ]<INFO>icas_in,32,120,0,101,0</INFO></NAVI>は、ヴォグリンデからルガンの魔力核を浄化する任務を与えられたという。詳しく話を聞こう。"
		},
		Summary = "フリーデリケと話す"
	},
	[11813] = {
		Title = "フリーデリケの日",
		IconName = "ico_dq.bmp",
		Description = {
			"蛇神の温もりで原始および最下級ルガンをそれぞれ10体ずつ倒し、ルガンの魔力核を10個集めて、<NAVI>[フリーデリケ]<INFO>icas_in,32,120,0,101,0</INFO></NAVI>の元へ戻ろう。"
		},
		Summary = "ルガンの魔力核を集める"
	},
	[11814] = {
		Title = "フリーデリケの日",
		IconName = "ico_dq.bmp",
		Description = {
			"フリーデリケの作業を手伝った。また明日挑戦しよう。"
		},
		Summary = "04:00にリセット",
		CoolTimeQuest = 1
	},
	[11815] = {
		Title = "凍った海",
		IconName = "ico_ep.bmp",
		Description = {
			"サーによって氷の城のフリーデリケの部屋に運ばれてきたタマリンは、フリーデリケの力で治療された。目を覚ました<NAVI>[タマリン]<INFO>icas_in,28,119,0,101,0</INFO></NAVI>から状況を聞こう。"
		},
		Summary = "タマリンに話しかける"
	},
	[11816] = {
		Title = "凍った海",
		IconName = "ico_ep.bmp",
		Description = {
			"タマリンは落ちた穴を調査する必要があると言う。穴を調べる前に、フローズンスケイルヒルの周囲にある<NAVI>[狩猟用罠]<INFO>jor_back1,300,272,0,101,0</INFO></NAVI>を確認し、おかしな点がないか見てみよう。"
		},
		Summary = "狩猟用罠の調査"
	},
	[11817] = {
		Title = "凍った海",
		IconName = "ico_ep.bmp",
		Description = {
			"狩猟用罠に問題はなかった。フローズンスケイルヒルにある別の<NAVI>[狩猟用罠]<INFO>jor_back2,346,203,0,101,0</INFO></NAVI>を確認し、おかしな点がないか見てみよう。"
		},
		Summary = "狩猟用罠の調査"
	},
	[11818] = {
		Title = "凍った海",
		IconName = "ico_ep.bmp",
		Description = {
			"狩猟用罠に問題はなかった。穴の近くにあるフローズンスケイル平原の<NAVI>[狩猟用罠]<INFO>jor_back2,260,294,0,101,0</INFO></NAVI>を確認しよう。"
		},
		Summary = "狩猟用罠の調査"
	},
	[11819] = {
		Title = "凍った海",
		IconName = "ico_ep.bmp",
		Description = {
			"狩猟用罠に腐敗の痕跡が見つかった。フローズンスケイル平原の穴の近くにいる<NAVI>[サー]<INFO>jor_back2,255,312,0,101,0</INFO></NAVI>に狩猟用罠のことを報告しよう。"
		},
		Summary = "サーと話す"
	},
	[11820] = {
		Title = "凍った海",
		IconName = "ico_ep.bmp",
		Description = {
			"タマリンが落ちた穴は毒が強く、ウェットスuitsを着ていても入れないという。氷の城のフリーデリケの部屋にいる<NAVI>[フリーデリケ]<INFO>icas_in,32,120,0,101,0</INFO></NAVI>の元へ戻り、助けを求めよう。"
		},
		Summary = "フリーデリケと話す"
	},
	[11821] = {
		Title = "凍った海",
		IconName = "ico_ep.bmp",
		Description = {
			"フリーデリケを説得した。フローズンスケイル平原の<NAVI>[穴]<INFO>jor_back2,258,314,0,101,0</INFO></NAVI>に戻り、毒を浄化しよう。"
		},
		Summary = "穴へ戻る"
	},
	[11822] = {
		Title = "凍った海",
		IconName = "ico_ep.bmp",
		Description = {
			"穴をきれいにした。危険に備え、ウェットスーツを着たサーが先に調査すると言った。サーが穴を調査している間、モンスターが近づかないようにフローズンスケイル平原周辺でモンスターを10体倒し、フローズンミートを3個集めて、調査を終えたら<NAVI>[サー]<INFO>jor_back2,255,312,0,101,0</INFO></NAVI>と話そう。"
		},
		Summary = "フローズンミート 3個"
	},
	[11823] = {
		Title = "凍った海",
		IconName = "ico_ep.bmp",
		Description = {
			"フローズンスケイル平原のサーが<NAVI>[穴]<INFO>jor_back2,258,314,0,101,0</INFO></NAVI>の調査について話し、一緒に降りようと提案してきた。"
		},
		Summary = "穴へ向かう"
	},
	[11824] = {
		Title = "凍った海",
		IconName = "ico_ep.bmp",
		Description = {
