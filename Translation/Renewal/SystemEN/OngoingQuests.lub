		},
		Summary = ""
	},
	[8170] = {
		Title = "生の水と死の水",
		Description = {
			"「生の水」を作るには聖水1個とユグドラシルの葉2枚、「死の水」を作るには呪われた水1個とヒナレの葉10枚を持っていく必要がある。"
		},
		Summary = ""
	},
	[8171] = {
		Title = "生の水と死の水",
		Description = {
			"ババ・ヤーガから「生の水」と「死の水」を受け取った。急いでマリアの元へ向かおう。まず「死の水」を注いで傷と呪いを取り除き、その後「生の水」を注いで彼女の魂を呼び戻さなければならない。"
		},
		Summary = ""
	},
	[8172] = {
		Title = "ババ・ヤーガの使い",
		Description = {
			"これからは人に害を与えるようなことはせず、善行に努めます！この家を守る守護者になります！家の幽霊と共に過ごしたあなたの優しい心を、決して忘れません。改めて感謝します。"
		},
		Summary = "ババ・ヤーガの元へ戻る"
	},
	[8173] = {
		Title = "ババ・ヤーガの使い",
		Description = {
			"パヨンの祖母に箒を買ってきた。掃除する時間がなかったが、時間がなかったから持てなかった。さあ、動け！遅かったら魂を取るぞ！へへへへへへへ。"
		},
		Summary = "パヨンで箒を買う"
	},
	[8174] = {
		Title = "ババ・ヤーガの使い",
		Description = {
			"つい先日、ゴブリンから作りたての箒を盗んだ。ゴブリンの作りがしっかりしているのは嬉しいし、盗まれたのは残念だが……息子は何度も箒を取りに行った。私が木に隠れて遊んでいるから、ただ無駄になってしまう。"
		},
		Summary = ""
	},
	[8175] = {
		Title = "ババ・ヤーガの使い",
		Description = {
			"ああ。負けた。楽しかった。それじゃあ楽しかったし、約束通り箒をくれてやろう。面白いやつだ。また機会があれば遊ぼう。それじゃあこれを持っていけ。"
		},
		Summary = "ババ・ヤーガの元へ戻る"
	},
	[8176] = {
		Title = "黄金の鍵",
		Description = {
			"よく来た。『黄金の鍵』も完成したぞ！さあ、これでマリア・モレヴナを助けよう。コシェイには気をつけろ。ヒヒヒヒヒ。"
		},
		Summary = "マリア・モレヴナの解放"
	},
	[8177] = {
		Title = "不死のコシェイ",
		Description = {
			"よし……今ならマリア・モレヴナを救える。私がマリア・モレヴナを連れて避難するから、コシェイを頼む！！"
		},
		Summary = "コシェイの討伐"
	},
	[8178] = {
		Title = "生の水と死の水",
		Description = {
			"マリアはまだ死んではいないが、生きてもいない。彼女を救うには「生の水」と「死の水」が必要だ。ババ・ヤーガの元へ行けば救えるはずだ。私がマリアを死から守る。ババ・ヤーガから「生の水」と「死の水」を受け取ってくれ。頼む。"
		},
		Summary = "生の水と死の水を持ち帰る"
	},
	[8179] = {
		Title = "生の水と死の水",
		Description = {
			"「生の水」……いつか聞いたことがある。^0000ff聖水1個^000000と^0000ff世界を構成する木の葉2枚^000000から作れる。そして「死の水」……これは^0000ff呪われた水1個^000000と^0000ffヒナレの花10個^000000で作れる。"
		},
		Summary = "材料をババ・ヤーガに持ち帰る"
	},
	[8180] = {
		Title = "生の水と死の水",
		Description = {
			"さあ、マリア・モレヴナを助けるためにこれを持っていけ、小僧。ヒヒ。まず「死の水」をマリア・モレヴナにかけて、傷と呪いを取り除く。それから「生の水」をかければマリアは生き返る。手に入れたらさっさと行け！"
		},
		Summary = "マリア・モレヴナの元へ向かう"
	},
	[8181] = {
		Title = "サイトブラスター",
		IconName = "ico_jq.bmp",
