	[1300] = {
		Title = "支援物資の痕跡",
		Description = {
			"ボランティア「ヘルピングハンド」は近隣住民にヴァンショー（ホットワイン）を振る舞おうとしているが、材料の配達が遅れている。ヴァレリーを助けるため、人々を訪ねて何が起きたのか確かめよう。"
		},
		Summary = "材料の支援者に会う"
