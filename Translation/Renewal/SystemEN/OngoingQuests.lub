		Summary = "狐の尾を持ってソンジュの元へ戻る"
	},
	[8136] = {
		Title = "灰色狼の警告",
		Description = {
			"君は「不死者コシェイ」という名の人物に気をつけるよう警告する灰色狼に出会った。だが、このコシェイとは一体何者なのだ？ もしかすると灰色狼が戻きて、もう少し詳しく説明してくれるかもしれない……"
		},
		Summary = ""
	},
	[8137] = {
		Title = "鍵職人を探す",
		Description = {
			"コシェイはマリアという少女によって封印された不滅の邪悪な存在のようだ。マリアを石の牢獄から解放するには、鍵職人を探して^0000ff黄金の鍵^000000を作ってもらう必要がある。"
		},
		Summary = ""
	},
	[8138] = {
		Title = "鍛冶屋の依頼",
		Description = {
			"鍛冶屋が鋼鉄を25個持ってくるよう頼んできた。鋼鉄を持ってくれば「黄金の鍵」の作り方を教えてくれるそうだ。"
		},
		Summary = ""
	},
	[8139] = {
		Title = "黄金の鍵",
		Description = {
			"鍛冶屋によると、黄金の鍵を作るには^0000ff呪われたルビー2個、黄金3個、赤い指輪1個、ルサルカの髪2個、黄金の糸10個^000000が必要だそうだ。鍛冶屋に話しかければ材料の入手方法を教えてくれるだろう。それと、強い鋼鉄のブーツを装備するのを忘れないように。"
		},
		Summary = ""
	},
	[8140] = {
		Title = "赤い指輪",
		Description = {
			"ヴァシリおじいさんによると、彼は赤い指輪を持っていたが、亡くなってしまった娘のマシェンカに渡してしまったそうだ。だが、彼にはリュババというもう一人の娘がいて、赤い指輪について何か知っているかもしれない。"
		},
		Summary = "リュババ"
	},
	[8141] = {
		Title = "マシェンカの赤い指輪",
		Description = {
			"リュババは、妹のマシェンカが沼地の付近で姿を消した時、おそらく赤い指輪を身につけていたとあなたに語った。"
		},
		Summary = ""
	},
	[8142] = {
		Title = "沼地の捜索",
		Description = {
			"沼地の近くで羊飼いの女性と話し、彼女からマシェンカと赤い指輪を探す間に^0000ff25本の尖った枝^000000を持ってきてほしいと頼まれた。"
		},
		Summary = ""
	},
	[8143] = {
		Title = "笛の声",
		Description = {
			"羊飼いの女性は、あなたが持ってきた枝で木の笛を作ってくれた。その笛を吹くと、奇妙な声が悲しい歌を歌う。笛の中で歌うその声について、リュババに尋ねるべきだ。"
