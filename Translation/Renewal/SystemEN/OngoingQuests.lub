	},
	[12073] = {
		Title = "クルーザー狩り",
		Description = {
			"おもちゃが人を襲っているらしいです。馬鹿げていますね！我々の力を奴らに見せつけましょう！ルティエのおもちゃ工場でクルーザーを15体討伐する必要があります。"
		},
		Summary = "クルーザーを15体討伐"
	},
	[12074] = {
		Title = "ククレ討伐",
		Description = {
			"ビーチの近くで強盗被害が出たそうです！容疑者はククレと呼ばれる犯罪モンスターのようです。イズルード海底洞窟でククレを30体討伐してください。"
