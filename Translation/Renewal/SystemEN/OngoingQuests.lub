		RewardJEXP ="480000",
		RewardItemList = {
			{ItemID = 25739, ItemNum = 3}
		}
	},
	[12460] = {
		Title = "陥落の後遺症",
		Description = {
			"陥落の光景をどう見るにしても辛いものがある。後遺症が残っている間は^ff0000グラストヘイム浄化^000000に入場し、作成することは不可能だ。"
		},
		Summary = "04:00にリセット",
		CoolTimeQuest = 1
	},
	[12461] = {
		Title = "強力な死の後遺症",
		Description = {
			"この後遺症は陥落の後遺症を伴う。休息中は^ff0000グラストヘイム浄化（上級）^000000に関連するメニューが表示されず、利用できない。"
		},
		Summary = "3日後の4時にリセットされる。",
		CoolTimeQuest = 1
	},
	[12462] = {
		Title = "王の思念を鎮める（上級）",
		Description = {
			"無数の命を救うため、シュミットは自らの命を球体に投じた。しかし、その過程で球体の力が彼の思念を体現し、後世に屈辱の記録を残そうとしている。彼の思念を鎮めることがあなたの使命だ。"
		},
		Summary = "シュミットの思念（上級）排除",
		NpcSpr = "4_ED_SCHMIDT",
		RewardEXP = "2800000",
		RewardJEXP ="1900000",
		RewardItemList = {
			{ItemID = 25740, ItemNum = 6}
		}
	},
	[12470] = {
		Title = "アンドレアの復讐 I",
		Description = {
			"アンドレアは膝ほどの大きさしかない小さな生き物が振り回す鎌で致命傷を負った。彼はその小さな生き物に同じ死の安らぎを与えたいと願っている。^Ff0000「奴の可愛らしい見た目に騙されてはいけない。奴は悪魔以上だ。」^000000本当に可愛いのか確かめるべきだ。"
		},
		Summary = "カオスバフォメットJr.を倒す",
		RewardEXP = "1750000",
		RewardJEXP = "1137500",
		RewardItemList = {
			{ItemID = 25271, ItemNum = 1}
		}
	},
	[12471] = {
		Title = "アンドレアの復讐 Ⅱ",
		Description = {
			"アンドレアは肉体の致命傷を負った後、自身の霊力で治癒を試みたが、この混沌とした存在の魂に圧倒され、復活を諦めざるを得なかった。これらの邪悪な存在を浄化することが彼の願いだ。^Ff0000「おそらく私より長く死んでいる冒険者の魂だろう。他に何が、どうして？」"
		},
		Summary = "カオスゴーストリングを倒す",
		RewardEXP = "1750000",
		RewardJEXP = "1137500",
		RewardItemList = {
			{ItemID = 25271, ItemNum = 1}
		}
	},
	[12472] = {
		Title = "アネスの復讐 I",
		Description = {
			"この素早く邪悪な虫は、死にかけていたアネスに致命的な一撃を与えた。彼女は世界中の翼を持つすべての虫を根絶やしにすべきだと信じている。^Ff0099「ハエに見えるからといって油断してはいけない。奴らの獲物には『生きている』人間も含まれる。」^000000彼女とこの虫の間には非常に悪い記憶があるようだ。"
		},
		Summary = "カオスハンターフライを倒す",
		RewardEXP = "1750000",
		RewardJEXP = "1137500",
		RewardItemList = {
			{ItemID = 25271, ItemNum = 1}
		}
	},
	[12473] = {
		Title = "アネスの復讐 Ⅱ",
		Description = {
			"どういうわけか道に迷い、茂みから飛び出してきたこの残酷な捕食者に襲われ、致命傷を負った。不幸なことに、それは彼女が探索のために夜明けから作っていたサンドイッチを一口かじった瞬間だった。^Ff0099「あの忌々しい奴を見つけたら、全部の脚をもぎ取って泥の山に放り込んでやれ。」^000000食事中に邪魔をする者がいれば大変なことになる。"
		},
		Summary = "カオスキラーマンティスを倒す",
		RewardEXP = "1750000",
		RewardJEXP = "1137500",
		RewardItemList = {
			{ItemID = 25271, ItemNum = 1}
		}
	},
	[12474] = {
		Title = "シラノの復讐 I",
		Description = {
			"シルバーノは、自分を襲い死に追いやった相手が誰かをはっきりと覚えている。彼の記憶にある敵はアネスを襲ったモンスターと似ていたが、異なる特徴を持っていた。^Ff0077「アネス姉さんが何を望んでいたの？ああ、君も皆を根絶やしにしたかったのか。それなら私も同じだ。」^000000"
		},
		Summary = "カオスマンティスを倒す",
		RewardEXP = "1750000",
		RewardJEXP = "1137500",
		RewardItemList = {
			{ItemID = 25781, ItemNum = 1}
		}
	},
	[12475] = {
		Title = "シラノの復讐 Ⅱ",
		Description = {
			"瀕死の状態だったシルバーノは回復魔法を詠唱する時間もなくポーションを使おうとしたが、インベントリのポーションはすべてこのしつこいモンスターに飲み込まれてしまった。^Ff0077「うまくいくかな？まだ早いだろう。ただ冒険者に同じ被害を受けてほしくないだけだ。」^000000彼の小さな希望に耳を傾けるかどうかは次の冒険者次第だ。"
		},
		Summary = "カオスの協会",
		RewardEXP = "1750000",
		RewardJEXP = "1137500",
		RewardItemList = {
			{ItemID = 25782, ItemNum = 1}
		}
	},
	[12476] = {
		Title = "セシリアの復讐 I",
		Description = {
			"^0000ff「蛇に気をつけて、見た目よりずっと獰猛だから。少しでも気を取られるとすぐに襲いかかってくる。」^000000 セシリアは一瞬の隙をつかれてその場でこのモンスターに噛みつかれた。瞬時に体に広がった麻痺毒のせいで動けなくなっている。^0000ff「迷宮で休憩したいなら止めない。でも私が生きているなら、あれは避けたい……」^000000"
		},
		Summary = "カオスサイドワインダーを倒す",
		RewardEXP = "1750000",
		RewardJEXP = "1137500",
		RewardItemList = {
			{ItemID = 25783, ItemNum = 1}
		}
	},
	[12477] = {
		Title = "セシリアの復讐 Ⅱ",
		Description = {
			"彼女は麻痺毒で動けない状態に追い込まれ、この尖ったモンスターに串刺しにされた。^0000ff「串刺しの傷が塞がって手足が使えない感覚がわかるか？ただ麻痺していただけなら生きられたのに、あの忌々しい串刺しモンスターのせいで！」^000000彼女の怒りは理解できる。"
		},
		Summary = "カオスステムワームを倒す",
		RewardEXP = "1750000",
		RewardJEXP = "1137500",
		RewardItemList = {
			{ItemID = 25784, ItemNum = 1}
		}
	},
	[12478] = {
		Title = "思念浄化",
		Description = {
			"迷宮を彷徨う四人の司祭の思念のうち、一つを根絶やしにする依頼だ。この思念は魂の浄化の過程で、魂の意志とは無関係に怨念と憎悪が凝縮されて生まれた。^Ff0000この任務は週に一度のみ実行可能。^000000 ^ff00cc浄化対象は毎週変わる可能性がある。^000000"
		},
