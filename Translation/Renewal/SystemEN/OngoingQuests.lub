		Summary = "04:00にリセット",
		CoolTimeQuest = 1
	},
	[21030] = {
		Title = "子供たちのための行動",
		Description = {
			"パヨン東部の森からやってくるボアのせいで子供が怪我をするのではないかと心配している少女のために、ボアを倒そう。"
		},
		Summary = "ボア狩り"
	},
	[21031] = {
		Title = "プロの蛇ハンター",
		IconName = "ico_dq.bmp",
		Description = {
