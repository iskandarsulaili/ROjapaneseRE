	[7091] = {
		Title = "ダオラの助言 01",
		IconName = "ico_jq.bmp",
		Description = {
			"ぜひ調査したい。街で目の良い人といえば、酒場のマデレ、自警団のトロバン、仲買人のクレイブが役立つだろう。クレイブは道具屋にいるはずだ。"
		},
		Summary = ""
	},
	[7092] = {
		Title = "ダオラの助言 02",
		IconName = "ico_jq.bmp",
		Description = {
			"なら、手伝いの女性を探さなければならない。町の通りを見下ろせる場所にメリッサという少女がいるはずだ。彼女は特殊な能力を持っているので、会ってみよう。きっと力になってくれる。"
		},
		Summary = ""
	},
	[7093] = {
		Title = "ダオラの助言 03",
		IconName = "ico_jq.bmp",
		Description = {
