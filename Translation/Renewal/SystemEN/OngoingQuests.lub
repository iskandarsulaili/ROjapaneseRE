	[8681] = {
		Title = "教会へ (1)",
		IconName = "ico_ep.bmp",
		Description = {
			"ヴァルムント邸の自動人形たちが、ついに届いた信号の正体を確認した。発信源は<NAVI>[ラヘル]<INFO>rachel,182,176,0,101,0</INFO></NAVI>であり、急いで向かった方がよさそうだ。"
		},
		Summary = "ラヘルへ向かう"
	},
	[8682] = {
		Title = "教会へ (2)",
		IconName = "ico_ep.bmp",
		Description = {
			"ラヘルは以前来た時よりもずっと険悪な雰囲気になっている。誰かが演説をしているのが聞こえたかと思うと、野次馬の間で喧嘩が勃発し、<NAVI>[1人]<INFO>rachel,183,170,0,101,0</INFO></NAVI>が目立っている。"
		},
		Summary = "聖職者に話しかける"
	},
	[8683] = {
		Title = "喧嘩を止める",
		IconName = "ico_ep.bmp",
		Description = {
			"焦った聖職者は喧嘩を止めてほしいと頼むが、どうすればいいのだろうか？"
		},
		Summary = "聖職者に話しかける"
	},
	[8684] = {
		Title = "終わった",
		IconName = "ico_ep.bmp",
		Description = {
			"ずっと緊張を隠せないでいたユノク聖職者は、現在のアルナフェルツについて話すと言い、<NAVI>[神殿の前]<INFO>ra_temple,72,54,0,101,0</INFO></NAVI>で会ってほしいと頼んだ。"
		},
		Summary = "神殿へ向かう"
	},
	[8685] = {
		Title = "神殿で不審な動きを検知",
		IconName = "ico_ep.bmp",
		Description = {
			"ユノク聖職者と警備員たちが、セスルムニルに最近侵入者が現れたという不穏な知らせを聞いた矢先、<NAVI>[神殿の西側]<INFO>ra_temple,30,142,0,101,0</INFO></NAVI>に不審者が現れたという連絡が入った。"
		},
		Summary = "警備員についていく"
	},
	[8686] = {
		Title = "神殿の侵入者",
		IconName = "ico_ep.bmp",
		Description = {
			"どこかで見たことのある彼らの正体は、ハートハンターだった。邸宅に侵入した者たちが壊滅したという知らせを、まだ聞いていないようだ。"
		},
		Summary = "聖職者に話しかける"
	},
	[8687] = {
		Title = "粉砕した？",
		IconName = "ico_ep.bmp",
		Description = {
			"奇妙なことに、ハートハンターの力は弱い。芝居のような一幕は不審に思われることなく終わり、この人物が誰であるかを知っている様子の警備員は、<NAVI>[ニレン]<INFO>ra_temin,173,40,0,101,0</INFO></NAVI>に会いに行くようにと言った。"
		},
		Summary = "ニーレンに話しかける"
	},
	[8688] = {
		Title = "今日の糧",
		IconName = "ico_ep.bmp",
		Description = {
			"グレイウルフ村の<NAVI>[エルイン]<INFO>wolfvill,202,166,0,101,0</INFO></NAVI>が、彼が仕掛けた罠を確認して5個回収するようにと言ってきた。"
		},
		Summary = "罠を5個回収する"
	},
	[8689] = {
