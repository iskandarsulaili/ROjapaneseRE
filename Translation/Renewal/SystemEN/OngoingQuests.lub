		Summary = "オークウォリアーを20体討伐"
	},
	[12077] = {
		Title = "バドン討伐",
		Description = {
			"分厚い殻を持ったカニを見たことがありますか？あれはバドンです。イズルード海底洞窟でバドンを15体討伐してください。"
