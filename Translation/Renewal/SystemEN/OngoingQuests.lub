		},
		Summary = "飲み物を注文してビクターに近づこう。"
	},
	[11064] = {
		Title = "臆病な少年ミハイル",
		Description = {
			"強力な接着剤を作るには、船で長時間移動するような辺境の湿地帯で材料を集める必要がある。マトリョーシカを売しただけで怯えている子供が、あの恐ろしい場所に入る勇気を持てるかな？"
		},
		Summary = "ミハイルはどこへ行ったのだ？湿地帯へ何をしに行ったのだろう。"
	},
	[11065] = {
		Title = "臆病な少年ミハイル",
		Description = {
			"見ただけで体がべとべとしそうな大きな湿地帯が広がっている。膨らんだ泡が浮き上がり、非常に恐ろしい雰囲気だ。"
		},
		Summary = "誰かが来た形跡はない。ミハイルの家へ戻ろう。"
	},
	[11066] = {
		Title = "臆病な少年ミハイル",
		Description = {
			"家の中を探してみると、ミハイルはかまどの中に隠れていた。接着剤を手に入れて、マトリョーシカの修復を手伝ってあげよう。"
		},
		Summary = "接着剤の正確な材料について、酒場のビクターに聞いてみよう。"
	},
	[11067] = {
		Title = "臆病な少年ミハイル",
		Description = {
			"モスコビアの近くに大きな島がある。そこから森の奥へ進むと湿地帯が見える。^0000FFその湿地帯に生えているもの^000000を10個。そして^0000FF薬鉢^000000も忘れずに持ってきてくれ。"
		},
		Summary = "10個採取してビクターの元へ戻ろう。薬鉢も忘れずに持っていこう！"
	},
	[11068] = {
		Title = "臆病な少年ミハイル",
		Description = {
			"よし、これで完了だ！接着剤は渡したから、これ以上俺を巻き込むなよ。行け！"
		},
		Summary = "接着剤を手に入れた。ミハイルの元へ戻って伝えよう。"
	},
	[11069] = {
		Title = "臆病な少年ミハイル",
		Description = {
			"それじゃあ、マトリョーシカを母さんに返しに行くよ。"
		},
		Summary = "ミハイルがかまどから出てきた。ガルムの元へ戻ろう。"
	},
	[11070] = {
		Title = "毒王",
		Description = {
			"なぜそれについて学びたいのだ？私が教えたいと思っても、年老いてすべてを覚えておるわけではない。私の最後の弟子^0000FF「宋之毒」^000000を探してみよ。彼なら何か役に立つことを教えてくれるかもしれん。"
		},
		Summary = "医者で働いている宋之毒を探し、毒の使い方について聞いてみよう。"
	},
	[11071] = {
		Title = "毒王",
		Description = {
			"元々やるつもりだったことをやりに行ってくれ。ただ残念だ……。"
		},
		Summary = "宋之毒は今、怒っているようだ。何か持っていけば機嫌を直せるかもしれない。"
	},
	[11072] = {
		Title = "毒王",
		Description = {
			"本当に私に申し訳ないと思うなら、私の復讐に協力してくれ！行って^0000FF4個の蜂の針、10個の毒の牙、10個の空のポーション、30個の緑ポーション^000000を持ってきてくれ。"
		},
		Summary = "宋之毒が求めた材料を持って彼の元へ戻ろう。"
	},
	[11073] = {
