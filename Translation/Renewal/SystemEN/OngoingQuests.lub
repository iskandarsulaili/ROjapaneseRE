		Summary = "ヴィンセンテに話しかける"
	},
	[7180] = {
		Title = "ドゥームクからのメッセージ",
		IconName = "ico_jq.bmp",
		Description = {
			"近いうちにギルドから補給物資が支給される予定だ。だが、いつになるかは分からない。いずれ支給されたら、君の分も受け取っておこう。だから、いつか必ず立ち寄るのを忘れないように。"
