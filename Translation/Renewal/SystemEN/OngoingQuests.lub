		Summary = "ディワタにブーケを供える"
	},
	[7399] = {
		Title = "幽霊ディワタの物語",
		Description = {
			"ディワタは、村の外から来たという理由で先住の幽霊たちにいじめられていたそうだ。渡し船はディワタの強力な魂のせいで動けなくなっている。"
		},
		Summary = "この情報をペドロに共有する"
