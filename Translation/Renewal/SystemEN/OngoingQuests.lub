	[7211] = {
		Title = "[待機] 霧の森探索",
		IconName = "ico_ep.bmp",
		Description = {
			"<NAVI>[霧の森]<INFO>bif_fild01,161,355,0,101,0</INFO></NAVI>を探索しよう。霧の森はあなたを覚えており、無理に再侵入しようとすると拒絶されることがある。"
