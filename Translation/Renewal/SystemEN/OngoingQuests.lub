	},
	[7184] = {
		Title = "エル・ディカステスへ！",
		IconName = "ico_ep.bmp",
		Description = {
			"アバランチからマヌクとエル・ディカステス間のトンネルを使用する許可が下りた。ついにサファの首都へ行ける！マヌクのトンネル入り口にいる<NAVI>[入り口管理者]<INFO>dic_in01,39,261,0,101,0,</INFO></NAVI>を探そう。"
		},
		Summary = "入り口管理者からの許可"
	},
	[7185] = {
		Title = "調査官ドーハ",
		IconName = "ico_ep.bmp",
		Description = {
			"首都へ出発する前、ヒバ・アジプ隊長から<NAVI>[調査官ドーハ]<INFO>mid_campin,168,170,0,101,0,</INFO></NAVI>に会うよう言われた。理由は分からないが、マヌクへ向かう前にこのドーハという人物に会わなければならない。ドーハはヴィハヌスの隣の部屋にいる。"
		},
		Summary = "調査官ドーハに会う"
	},
	[7186] = {
		Title = "ドーハからの密命 - 調査",
		IconName = "ico_ep.bmp",
		Description = {
			"ドーハは盗まれた報告書の容疑者を探しているという。彼は密かに、エル・ディカステスの<NAVI>[酒場]<INFO>dic_in01,245,119,0,101,0,</INFO></NAVI>で情報を集めるよう命じ、容疑者の服装について説明してくれた。容疑者は動物の耳をつけた男だ。"
		},
		Summary = "情報を集める"
	},
	[7187] = {
		Title = "ドーハからの密命 - シェイ",
		IconName = "ico_ep.bmp",
		Description = {
			"<NAVI>[シェイ]<INFO>dic_in01,245,119,0,101,0,</INFO></NAVI>はエル・ディカステスの酒場「バーマン・フローネ」の店長だ。彼は首都に住むサファから「動物の耳をつけた男」について情報を得るよう提案してくれた。",
			"<NAVI>[サファの広場]<INFO>dicastes01,207,210,0,101,0,</INFO></NAVI>",
			"<NAVI>[サファの工場]<INFO>dicastes01,112,248,0,101,0,</INFO></NAVI>",
			"<NAVI>[サファの近衛隊]<INFO>dicastes01,249,140,0,101,0,</INFO></NAVI>"
		},
		Summary = "エル・ディカステスのサファに話しかけて情報を集める"
	},
	[7188] = {
		Title = "情報収集 - 広場にて",
		IconName = "ico_ep.bmp",
		Description = {
			"猫耳？猫手商会のことじゃない？全く分からないな。ところで、もうアハトには会った？彼は本当に美しくて高貴だよ。"
		},
		Summary = "情報収集 1"
	},
	[7189] = {
		Title = "情報収集 - 工場にて",
		IconName = "ico_ep.bmp",
		Description = {
			"猫耳の男？聞いたことがないな。そんな当てにならないものを探さずに、ただアハトに会いに行きなよ。彼は本当に素晴らしい！サファの手本だよ！"
		},
		Summary = "情報収集 2"
	},
	[7190] = {
		Title = "情報収集 - 近衛隊にて",
		IconName = "ico_ep.bmp",
		Description = {
			"猫耳？本当か？人間はいつもそうなのか？なぜただアハトに会いに行かないんだ。彼はとても強いサファだ。書類の山を処理するジャルートかもしれないが、本当の力を隠しているに違いない！！"
		},
		Summary = "情報収集 3"
	},
	[7191] = {
		Title = "シェイの指名 - BK",
		IconName = "ico_ep.bmp",
		Description = {
			"情報収集を円滑に進めるため、シェイは猫手商会の<NAVI>[BK]<INFO>dic_fild01,231,174,0,101,0,</INFO></NAVI>を紹介してくれた。もしBKが協力してくれないなら、「シェイの特製ドリンクを届ける」と伝える必要がある……"
		},
		Summary = "BKに会う"
	},
	[7192] = {
		Title = "BKからの情報",
		IconName = "ico_ep.bmp",
		Description = {
			"BKの情報によると、猫耳の男はエル・ディカステスで人気のアハトと密接に関係しているという。しかしアハトはサファではなく、亀裂の近くで見つかったらしい。亀裂と何の関係があるのだろうか？エル・ディカステスの酒場にいる<NAVI>[シェイ]<INFO>dic_in01,245,119,0,101,0</INFO></NAVI>に話しかけよう。"
		},
		Summary = "シェイに話しかける"
	},
	[7193] = {
		Title = "次元の狭間調査",
		IconName = "ico_ep.bmp",
		Description = {
			"シェイに話した後、真実を確かめるため南のカミダル山の麓にある<NAVI[次元の狭間]<INFO>dic_fild02,175,130,0,101,0,</INFO></NAVI>を調査しよう。調査に役立ちそうな手がかりを探そう。"
		},
		Summary = "次元の狭間を調査する"
	},
	[7194] = {
		Title = "この血痕は何？",
		IconName = "ico_ep.bmp",
		Description = {
			"亀裂の近くの土に固まった血を見つけた。これはアハトと何か関係があるのだろうか？エル・ディカステスの酒場にいる<NAVI>[シェイ]<INFO>dic_in01,245,119,0,101,0</INFO></NAVI>に見せよう。"
		},
		Summary = ""
	},
	[7195] = {
		Title = "この皮の破片は何？",
		IconName = "ico_ep.bmp",
		Description = {
			"亀裂の近くで、生物のものと思われる凍った皮の破片を見つけた。これはアハトと何か関係があるのだろうか？"
		},
		Summary = ""
	},
	[7196] = {
		Title = "この怪しい魔力は何",
		IconName = "ico_ep.bmp",
		Description = {
			"怪しげな魔法の石の欠片を見つけた。ひび割れから魔力が漏れている。これはアハットと関係があるのだろうか？"
		},
		Summary = ""
	},
	[7197] = {
		Title = "サファの認証書？",
		IconName = "ico_ep.bmp",
		Description = {
			"アハットに面会するためにサファの証明書を持参する必要はない。首都のあちこちで見つけられるクエストをこなして証明書を集め、エル・ディカステスの<NAVI>[入場管理官]<INFO>dic_in01,39,261,0,101,0,</INFO></NAVI>の元へ行こう。"
		},
		Summary = "サファの証明書 3個収集"
	},
	[7198] = {
		Title = "アハットへの面会",
		IconName = "ico_ep.bmp",
		Description = {
			"サファの証明書 3個を支払うと<NAVI>[アハット]<INFO>dic_in01,300,280,0,101,0,</INFO></NAVI>に面会できる。ディカステス・ディエルの行政室へ上がってアハットに会おう。"
		},
		Summary = ""
	},
	[7199] = {
		Title = "アハットからの密命",
		IconName = "ico_ep.bmp",
		Description = {
			"アハットは<NAVI>[亀裂の周辺]<INFO>dic_fild02,175,130,0,101,0,</INFO></NAVI>の様々な痕跡を消去するよう命じた。凝固した血痕、凍った皮膚の欠片、奇妙な魔力石をそれぞれ10個ずつ集め、<NAVI>[チェシャー]<INFO>dic_in01,294,276,0,101,0,</INFO></NAVI>に報告しよう。"
		},
		Summary = "痕跡の消去"
	},
	[7200] = {
		Title = "[待機] チェシャーの呼び出し",
		IconName = "ico_ep.bmp",
		Description = {
			"亀裂の痕跡を消去する作業は、目立たないように毎日少しずつ行われている。<NAVI>[チェシャー]<INFO>dic_in01,294,276,0,101,0,</INFO></NAVI>に会う時間になったら、エル・ディカステスへ行こう。"
		},
		Summary = "04:00にリセット",
		CoolTimeQuest = 1
	},
	[7201] = {
		Title = "亀裂の痕跡除去",
		IconName = "ico_ep.bmp",
		Description = {
			"エル・ディカステスのアハットと<NAVI>[チェシャー]<INFO>dic_in01,294,276,0,101,0,</INFO></NAVI>の指示に従い、カミダル山の麓にある<NAVI>[亀裂]<INFO>dic_fild02,71,357,0,101,0,</INFO></NAVI>の痕跡を毎日消去しよう。いつも通り、凝固した血痕、凍った皮膚の欠片、奇妙な魔力石をそれぞれ10個ずつ集めよう。"
		},
		Summary = "痕跡の消去"
	},
	[7202] = {
		Title = "ドハからの密命 - 証拠収集",
		IconName = "ico_ep.bmp",
		Description = {
			"チェシャーとアハットに気づかれないように、各亀裂の痕跡をドハに提出する証拠として隠し、報告書にまとめよう。凝固した血痕 1個、凍った皮膚の欠片 1個、怪しい魔力石 1個を集めよう。"
		},
		Summary = "証拠収集"
	},
	[7203] = {
		Title = "ドハからの密命 - 最終報告",
		IconName = "ico_ep.bmp",
		Description = {
			"ジャルテ、ヘスランタといくつかの事柄について話し合った。ヘスランタとの会話を終えたら、調査結果を報告書にまとめて、探検隊キャンプの<NAVI>[ドハ]<INFO>mid_campin,168,170,0,101,0,</INFO></NAVI>に届けよう。"
		},
		Summary = "ドハ調査官に最終報告書を提出"
	},
	[7204] = {
		Title = "春を運ぶ花",
		Description = {
			"ルティエで「ボミ」に会った。彼女は春を運ぶ花に興味を持っていた。彼女のために、春の花を一束持ってくると約束した。 (巨大な花束) 5個あれば十分だろうか。"
		},
		Summary = "ボミに春をプレゼント"
	},
	[7206] = {
		Title = "チェシャーの新しい日々",
		IconName = "ico_dq.bmp",
		Description = {
			"^4d4dffカミダルトンネル^000000のスカラバホール入口付近に積まれている箱の中から、印のついた<NAVI>[アイテムボックス]<INFO>dic_dun01,273,113,0,101,0</INFO></NAVI>を見つけ、箱に記された場所へ移動させよう。"
		},
		Summary = "カミダルトンネルで箱を見つける"
	},
	[7207] = {
		Title = "チェシャーの箱",
		IconName = "ico_dq.bmp",
		Description = {
			"カミダルトンネルでチェシャーが言っていた箱を見つけた。箱の底には^4d4dffビフロストの亀裂の前^000000と書かれている。ビフロストのどこかにいる<NAVI>[チェシャー]<INFO>bif_fild01,335,168,0,101,0</INFO></NAVI>に届けなければならない。"
