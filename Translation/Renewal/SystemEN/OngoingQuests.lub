		Summary = ""
	},
	[8022] = {
		Title = "工場の点検",
		Description = {
			"メイン制御盤には問題がないように見える。しかし、表面を叩くと、がっかりさせるような空洞音が聞こえた。部品が不足しているようだ……調査結果をゼルメトに報告しよう。"
		},
		Summary = ""
	},
	[8023] = {
		Title = "工場の点検",
		Description = {
