	[12000] = {
		Title = "昔の友達",
		Description = {
			"マクの昔の友達を探して話しかけよう。"
		},
		Summary = ""
	},
	[12001] = {
		Title = "マクの昔の友達、ディゴッツ",
		Description = {
			"マクの幼馴染であるディゴッツと話した。マクの元へ戻って話しかけよう。"
		},
		Summary = "マク"
	},
	[12002] = {
		Title = "友情の使者",
		Description = {
			"マクとディゴッツの永遠の友情のため、二人の間を往復する使者になろう。"
		},
		Summary = "メッセージを届けるため往復する"
	},
	[12003] = {
		Title = "ディゴッツのメッセージ",
		Description = {
			"ディゴッツのメッセージをマクに届けよう。「-救いようのないバカ野郎！ -お前はまだのろまな奴だ！ -最低3回分の昼飯を返せ！ -謝るのも忘れるな！ -だがお前がどう思おうと知ったことか！ -お前のいない今、俺は最高に幸せだ！」"
		},
		Summary = "マク"
	},
	[12004] = {
		Title = "マクのもう一人の友達",
		Description = {
			"落ち着いた後、マクは友達のベンカイシュタインがいつも喧嘩をしないように気を配ってくれたと言う。ディゴッツもこのベンカイシュタインのことを知っているかもしれない……。"
		},
		Summary = "ディゴッツ"
	},
	[12005] = {
		Title = "ベンカイシュタイン",
		Description = {
			"ディゴッツによると、ベンカイシュタインは自分とマクのような状況に対する答えを知っているらしい。彼は本のたくさんある場所で勉強しているそうだ……。"
		},
		Summary = "ベンカイシュタインの居場所を探す"
	},
	[12006] = {
		Title = "ベンカイシュタインの失くし物",
		Description = {
			"ベンカイシュタインが失くしたものを見つけて、彼に届けよう。"
		},
		Summary = ""
	},
	[12007] = {
		Title = "カジエン",
		Description = {
			"リヒタルゼンのある老人が、社屋の中にいるカジエンという人物を探し、手助けができるか確認してほしいと頼んできた。"
		},
		Summary = "カジエンを探す"
	},
	[12008] = {
		Title = "研究員ガリンス",
		Description = {
			"アインブロックの研究所にいるガリンスを訪ね、注文品が届いたか確認しよう。カジエンからは誰にも内密にするよう言われているので、慎重に動こう。"
		},
		Summary = "アインブロックでガリンスを探す"
	},
	[12009] = {
		Title = "失敗した任務",
		Description = {
			"情報を漏らしすぎたため、カジエンからの任務に失敗してしまった。もう一度挑戦すれば、カジエンが再チャンスをくれるかもしれない……。"
		},
		Summary = "カジエン"
	},
	[12010] = {
		Title = "立ち入り禁止",
		Description = {
			"研究所の警備員を通過するのに苦労している。このままでは任務を完了できないので、カジエンに状況を知らせよう。"
		},
		Summary = "カジエン"
	},
	[12011] = {
		Title = "リョジエン",
		Description = {
			"国際線飛行船にいるリョジエンという人物を探そう。これまで通り内密にし、この仕事のことは誰にも話さないように。"
		},
		Summary = "リョジエン"
	},
	[12012] = {
		Title = "アーマン氏に会う",
		Description = {
			"イズルード空港でアーマン氏に会って任務を完了させ、リョジエンの元へ戻ろう。"
		},
		Summary = "アーマン氏に会う"
	},
	[12013] = {
		Title = "配達完了",
		Description = {
			"アーマン氏に会った後、配達が完了したことをリョジエンに知らせよう。"
		},
		Summary = "リョジエン"
	},
	[12014] = {
		Title = "追加の任務",
		Description = {
			"リョジエンによると、兄のカジエンがまた別の仕事を依頼してくるかもしれないとのことだ。"
		},
		Summary = "カジエン"
	},
	[12015] = {
		Title = "ガルシュタイン",
		Description = {
			"ガルシュタインの怪しい会話を立ち聞きしてしまった。聞いた内容についてもっと情報を集めよう。"
		},
		Summary = ""
	},
	[12016] = {
		Title = "研究所への潜入",
		Description = {
			"東スラム街住民の失踪事件を調査し、隠された研究所へ潜入して証拠を持ち帰り、ガルシュタインに報告する必要がある。"
		},
		Summary = ""
	},
	[12017] = {
		Title = "会員承認",
		Description = {
			"ジュノー近くでグシャールを探し、次の任務について聞こう。ガルシュタインと協力関係にあることを証明するため、会員カードを見せよう。"
		},
		Summary = ""
	},
	[12018] = {
		Title = "大統領との面会",
		Description = {
			"大統領の秘書に会員カードを見せよう。ワイヤストラス大統領にはPST午後8時～午後11時、および午前11時～午後2時の間のみ面会できる。"
		},
		Summary = ""
	},
	[12019] = {
		Title = "大統領の任務",
		Description = {
			"帰る前にファイルフォルダーを大統領の秘書ヘス・オニール氏に届け、その後アルデバランのカプラ本部でベニスに会い、次の任務を確認しよう。"
		},
		Summary = ""
	},
	[12020] = {
		Title = "秘密の翼メンバーの救出",
		Description = {
			"アインブロックとリヒタルゼンの間のどこかにある壊れた橋の近くで、工作員ヤルゲアを探さなければならない。彼は負傷しており、敵より先に到着する必要がある。"
		},
		Summary = ""
	},
	[12021] = {
		Title = "封印されたファイル",
		Description = {
			"ヤルゲアから封印されたファイルを受け取った。カプラ本部のベニスに報告しよう。"
		},
		Summary = ""
	},
	[12022] = {
		Title = "封印されたファイル",
		Description = {
			"封印されたファイルをリヒタルゼンのワイヤストラス大統領に届けよう。"
		},
		Summary = ""
	},
	[12023] = {
		Title = "研究員シノカス",
		Description = {
			"次の任務は、レケンベル社の秘密を知る研究員シノカスを探すことだ。彼はアインブロックのどこかで目撃されたという。"
		},
		Summary = ""
	},
	[12024] = {
		Title = "カプラ社のエージェント",
		Description = {
			"リヒタルゼンのフィールドでカプラ社のエージェントを探そう。"
		},
		Summary = ""
	},
	[12025] = {
		Title = "レッケンベルの秘密文書庫",
		Description = {
			"レッケンベルの建物に入るための通行証を使い、エージェントのレスティンと会って任務の説明を受けよう。"
		},
		Summary = ""
	},
	[12026] = {
		Title = "レッケンベルの秘密文書庫",
		Description = {
			"衛兵の交代時間に合わせて、レスティンの通行証（裏面に何かが書かれている）を使って秘密文書庫に忍び込もう。見つけられる証拠はすべて持ち帰ること。"
		},
		Summary = ""
	},
	[12027] = {
		Title = "レッケンベルの秘密文書庫",
		Description = {
			"リヒタルゼンの外にいるエスナを見つけ、秘密文書庫で見つけた情報を伝えよう。"
		},
		Summary = ""
	},
	[12028] = {
		Title = "裏切り者クレル",
		Description = {
			"秘密の翼の裏切り者クレルの報告を大統領に持ち帰ろう。その後、彼から渡された赤い毒の解毒剤を得るためにガルシュタインの元へ戻ろう。"
		},
		Summary = ""
	},
	[12029] = {
		Title = "失くした婚約指輪",
		Description = {
			"シュダの婚約者アノンが水の中に投げ捨ててしまった婚約指輪を探すのを手伝おう。何か指輪を釣り上げるための道具を用意した方がいいだろう。"
		},
		Summary = ""
	},
	[12030] = {
		Title = "婚約指輪発見",
		Description = {
			"水から釣り上げたフェンの中にシュダの婚約指輪を見つけた。彼女に返してあげよう。"
		},
		Summary = "シュダ"
	},
	[12031] = {
		Title = "アノンを探す",
		Description = {
			"シュダの元に婚約指輪が戻った今、アノンを見つけて知らせてあげよう。彼を見かけたという人が必ずいるはずだ。"
		},
		Summary = ""
	},
	[12032] = {
		Title = "アノンを捜索",
		Description = {
			"若い男が森の中へ駆け込んでいくのを見たという老人に出会った。それはアノンだったのだろうか？ 森の中で彼の足取りを探そう。"
		},
		Summary = "アノンの足跡"
	},
	[12033] = {
		Title = "血の痕",
		Description = {
			"血の痕跡を見つけた。この方向へ走っていった者は負傷していたようだ。痕跡は北へと続いている……アノンはきっと近くにいるはずだ。"
		},
		Summary = ""
	},
	[12034] = {
		Title = "アノンの事情",
		Description = {
			"さらに血の痕跡がある奇妙な場所を見つけた。アノンはここにいるはずだ……見つけたら、なぜシュダから逃げ出したのか尋ねよう。"
		},
		Summary = ""
	},
	[12035] = {
		Title = "聖なる糸",
		Description = {
			"ブントムから聖なる力を持つアイテムを作るために、以下のアイテムを持ってくるよう頼まれた：針のパック1個、糸巻き1個、固い殻1個、聖水1瓶。持っていけば地下ダンジョン第1層へ入ることができる。"
		},
		Summary = ""
	},
	[12036] = {
		Title = "石板のメッセージ",
		Description = {
			"石板の最後の欠片を見つけた今、ブントムにメッセージの内容を伝えよう。"
		},
		Summary = "シャーマン・ブントム"
	},
	[12037] = {
		Title = "さらに聖なる糸",
		Description = {
			"地下第2層へ入るため、ブントムに材料を持っていこう。聖水2個、イグドラシルの葉1個、針のパック2個、糸巻き2個を集めてくること。"
		},
		Summary = ""
	},
	[12038] = {
		Title = "サムシングタイガーを捜索",
		Description = {
			"ダンジョンの地下第2層へ入ることができる。サムシングタイガーについて何かを突き止めたかもしれない、ブントムの仲間の足取りを探そう。"
		},
		Summary = ""
	},
	[12039] = {
		Title = "ブントムの仲間",
		Description = {
			"ブントムの元へ戻り、彼の仲間について伝えよう。"
		},
		Summary = "シャーマン・ブントム"
	},
	[12040] = {
		Title = "ベンカイシュタインの日記",
		Description = {
			"二人がかつて共に過ごした楽しい日々を思い出させるため、日記をディゴッツに届けよう。"
		},
		Summary = "ディゴッツ"
	},
	[12041] = {
		Title = "ベンカイシュタインの日記",
		Description = {
			"二人がかつて共に過ごした楽しい日々を思い出させるため、日記をマクに届けよう。"
		},
		Summary = "マク"
	},
	[12042] = {
		Title = "ベンカイシュタインの日記",
		Description = {
			"ベンカイシュタインの日記をディゴッツとマクに届けた……ディゴッツの様子を見に行き、マクが日記を読んだことを知らせよう。"
		},
		Summary = "ディゴッツ"
	},
	[12043] = {
		Title = "スラムへの通行証",
