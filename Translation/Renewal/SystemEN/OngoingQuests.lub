	[14754] = {
		Title = "ゲイボルグの呪い",
		IconName = "ico_nq.bmp",
		Description = {
			"ロダフリアンは、カロモフが教えてくれた童謡の一節が自分の記憶と違っていると言い、ミョルニール近くの<NAVI>[歴史家]<INFO>mjolnir_01,135,168,0,101,0</INFO></NAVI>から忘れた一節を取り戻すことにしました。",
