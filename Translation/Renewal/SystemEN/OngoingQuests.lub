		IconName = "ico_dq.bmp",
		Description = {
			"イズガルドの蛇の巣では、魔法コアは食料のようなものなので、毎日回収する必要があるようだ。信仰があるなら、時間が経過した後に<NAVI>[ミミルガンド]<INFO>jor_nest,34,79,0,101,0</INFO></NAVI>を助けよう。"
		},
		Summary = "04:00にリセット",
		CoolTimeQuest = 1
	},
	[18141] = {
		Title = "優雅な趣味",
		IconName = "ico_dq.bmp",
		Description = {
			"蛇の巣で趣味で宝石作りをしている<NAVI>[ベルベルガンド]<INFO>jor_nest,37,75,0,101,0</INFO></NAVI>が材料を集めてほしいと頼んできた。材料は以下の通り。カラピー、蛍光液体、餌ベルフラワー、丈夫な薄い殻を各10個。これらは氷結鱗平原のモンスターから入手できる。"
