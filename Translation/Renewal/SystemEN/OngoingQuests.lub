	},
	[7258] = {
		Title = "ニャ冒険 - 絵画の完成",
		Description = {
			"船内を探索した結果、合計6枚の絵画の欠片が見つかった。足りない部分はもう見えない。<NAVI>[チャロ]<INFO>malangdo,213,202,0,101,0</INFO></NAVI>、ロージー、ロクに伝えよう。"
		},
		Summary = ""
	},
	[7259] = {
		Title = "ニャ勇気隊からの贈り物",
		Description = {
			"チャロ、ロージー、ロクが、見つけた絵画の欠片をラトに渡したいと言っている。（絵画はバラバラだが）子猫たちの愛を届けるため、<NAVI>[ラト]<INFO>malangdo,165,222,0,101,0</INFO></NAVI>に絵画を届けよう。"
		},
		Summary = ""
	},
	[7260] = {
		Title = "虫の発生源",
		Description = {
			"どれほど丁寧に掃除しても、どこからともなく虫が出てくる。クリーニャンは泣いている。もうコックに怒鳴られないように、クリーニャンは虫の発生源を見つけることにした。船ナビを注意深く調べてみよう。"
		},
		Summary = ""
	},
	[7261] = {
		Title = "猫ビスケット収集 - 船長室",
		Description = {
			"船長室の隅に隠された猫ビスケットを見つけた。猫ビスケットがあった隅は虫でいっぱいだった。虫は猫ビスケットに集まってきたようだ。"
		},
		Summary = ""
	},
	[7262] = {
		Title = "猫ビスケット収集 - 乗組員室",
		Description = {
