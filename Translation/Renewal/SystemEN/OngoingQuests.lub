	[11808] = {
		Title = "浄化の聖人",
		IconName = "ico_ep.bmp",
		Description = {
			"イスガルドへ出発する準備が整った。アルデバランにいる<NAVI>[ヘロック]<INFO>aldebaran,102,103,0,101,0</INFO></NAVI>に会い、イスガルドへ移動しよう。"
