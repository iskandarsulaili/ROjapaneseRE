	[9240] = {
		Title = "<ルエンの証言メモ>",
		Description = {
			"^0000FFルエン^000000の証言メモ: 花の咲き誇る大地を散歩していた。短い赤髪の人が急いでいるのを見た。性別は分からなかった。珍しい髪色なので見覚えがない。最初に私を発見したのはルエンだと思っていたが、実はルエンの母親が最初だった。"
		},
		Summary = ""
	},
	[9241] = {
		Title = "<ルエンの証言メモ>",
		Description = {
			"^0000FFルエン^000000の証言メモ: 花の咲き誇る大地を散歩していた。短い赤髪の人が急いでいるのを見た。珍しい髪色なので見覚えがない。父親の友人バルミンが家のそばを通りかけるのを見た。私に気づいたはずなのに、なぜただ通り過ぎただけなのだろう。"
		},
		Summary = ""
	},
	[9242] = {
		Title = "<ルエンの証言メモ>",
		Description = {
