		IconName = "ico_dq.bmp",
		Description = {
			"カミダルトンネルに積まれた<NAVI>[箱]<INFO>dic_dun01,273,113,0,101,0</INFO></NAVI>を1日1回チェシャーに運ぶことになった。時間が来たら、箱を取りに行こう。"
