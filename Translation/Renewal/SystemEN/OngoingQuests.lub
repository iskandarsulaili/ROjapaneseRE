	[7264] = {
		Title = "料理長ニャスへ",
		IconName = "ico_nq.bmp",
		Description = {
			"クリーニャンは丁寧に掃除したが、手の届かないところに置かれていた猫ビスケットがすべての事件の犯人だった。この事実を料理長の<NAVI>[ニャス]<INFO>mal_in02,187,58,0,101,0</INFO></NAVI>に伝えて、クリーニャンの無実を証明すべきだ。"
		},
		Summary = "ニャスと会話する"
	},
	[7265] = {
		Title = "料理長ニャスの激怒",
		IconName = "ico_nq.bmp",
		Description = {
			"料理長の<NAVI>[ニャス]<INFO>mal_in02,187,58,0,101,0</INFO></NAVI>に猫ビスケットと虫の話をすると、彼はとても怒った。少し落ち着くまで待つのが最善だろう。"
		},
		Summary = "ニャスと会話する"
	},
	[7266] = {
		Title = "料理長ニャスの宣言",
		Description = {
			"料理長のニャスは、これから1日1食分の猫ビスケットを提供すると脅した。猫ビスケットを作るために穀物の袋10個とおいしいソース1個を要求してきた。<NAVI>[ニャス]<INFO>mal_in02,187,58,0,101,0</INFO></NAVI>に届けよう。"
		},
		Summary = "穀物の袋10個、おいしいソース1個を届け、クリーニャンに伝言する。"
	},
	[7267] = {
		Title = "[待機中] クリーニャンとの約束の時間",
		Description = {
			"猫ビスケットの問題を解決するため、クリーニャンと協力することになった。約束の時間が過ぎたら、<NAVI>[クリーニャン]<INFO>mal_in02,76,63,0,101,0</INFO></NAVI>を訪ねよう。"
		},
		Summary = "04:00にリセット",
		CoolTimeQuest = 1
	},
	[7268] = {
		Title = "猫の硬いビスケットを探せ！",
		Description = {
			"猫たちが隠し始めた猫ビスケットを集めることにした。すぐに猫ビスケットを片付ければ、虫はもう寄ってこないだろう。猫ビスケットがよく見つかる9箇所を探索しよう。"
