		Summary = ""
	},
	[8208] = {
		Title = "ハンセンヌの依頼",
		IconName = "ico_ep.bmp",
		Description = {
			"彼はもうすぐ大丈夫になるわ。大したことじゃなかったと思えるようになるはずよ。でも問題は…リョーセンとヒューの関係が全く良くないことなの。二人が仲良くなる手伝いをしてくれない？"
		},
		Summary = ""
	},
	[8209] = {
		Title = "ヒューの報告",
		IconName = "ico_ep.bmp",
		Description = {
			"はい、これが会議室で大混乱になった時に持ち出したルーンミッドガッツ王国の報告書よ…。これをリョーセンに届けてくれない？"
		},
		Summary = ""
	},
	[8210] = {
		Title = "連合研究の職員に報告する",
		IconName = "ico_ep.bmp",
		Description = {
