	[7182] = {
		Title = "サファの来訪",
		IconName = "ico_ep.bmp",
		Description = {
			"マヌクのサファがキャンプを訪ねてきたという噂がある。アエロは私を信頼してくれているので、彼への話し役に指名した。<NAVI>[使節]<INFO>mid_campin,110,120,0,101,0,</INFO></NAVI>は2階の右側の部屋にいる。"
