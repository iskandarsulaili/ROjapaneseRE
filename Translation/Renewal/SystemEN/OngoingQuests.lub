	},
	[7870] = {
		Title = "小さな繋がり",
		IconName = "ico_nq.bmp",
		Description = {
			"リヒタルゼン空港で「アンドレア」という奇妙な人物に出会った。アンドレアは、もし線路を渡ることになったら、彼女の厚意が必要になるだろうと言い残して姿を消した。線路の近くで再び彼女に会えるだろうか？"
		},
		Summary = "アンドレアと会話する"
	},
	[7871] = {
		Title = "友人の悩み",
		IconName = "ico_nq.bmp",
		Description = {
			"アンドレアは、リヒタルゼンの鉄道を通過させる条件として、友人<NAVI>[フィッシュバーン]<INFO>lighthalzen,341,224,0,101,0</INFO></NAVI>の悩みを聞いてほしいと頼んできた。リヒタルゼンの貧民街のどこかにいる「フィッシュバーン」を探そう。"
		},
		Summary = "フィッシュバーンと会話する"
	},
	[7872] = {
		Title = "潜入",
		IconName = "ico_nq.bmp",
		Description = {
			"リヒタルゼンの貧民街で出会った<NAVI>[フィッシュバーン]<INFO>lighthalzen,341,224,0,101,0</INFO></NAVI>は、準備ができたらまた話しかけてほしいと言った。何を依頼されるのかは分からないが、まずは彼に同行しよう。"
		},
		Summary = "フィッシュバーンと会話する"
	},
	[7873] = {
		Title = "予期せぬ宝探し",
		IconName = "ico_nq.bmp",
		Description = {
			"リヒタルゼンの貧民街にいた<NAVI>[フィッシュバーン]<INFO>lighthalzen,341,224,0,101,0</INFO></NAVI>は、長期休暇で誰もいない研究者の個室で「アクセスカード」を見つけてほしいと頼んできた。こっそり調べてみよう。"
		},
		Summary = "アクセスカードを入手する"
	},
	[7874] = {
		Title = "研究所アクセスカードの効果",
		IconName = "ico_nq.bmp",
		Description = {
			"リヒタルゼンの貧民街で<NAVI>[フィッシュバーン]<INFO>lighthalzen,341,224,0,101,0</INFO></NAVI>を通じて入った部屋で研究所のアクセスカードを見つけた。このアクセスカードを使える場所がどこかにあるはずだ。部屋の中を探してみよう。"
		},
		Summary = "アクセスカードを使用する"
	},
	[7875] = {
		Title = "知ることは危険",
		IconName = "ico_nq.bmp",
		Description = {
			"リヒタルゼンの貧民街で<NAVI>[フィッシュバーン]<INFO>lighthalzen,341,224,0,101,0</INFO></NAVI>と共に調査しに行った研究所の配管通路は、別の場所へと繋がっていた。下水管に隠れている<NAVI>[フィッシュバーン]<INFO>lhz_dun02,217,7,0,101,0</INFO></NAVI>は、<NAVI>[怪しい場所]<INFO>lhz_dun02,225,102,0,101,0</INFO></NAVI>を調査するよう求めてきた。"
		},
		Summary = "怪しい場所を調査する"
	},
	[7876] = {
		Title = "地下研究所の正体",
		IconName = "ico_nq.bmp",
		Description = {
			"巨大な地下研究施設はすでに閉鎖されているようだ。内部は生物実験の被験体で溢れており、もはや危険ではない。リヒタルゼンに戻り、<NAVI>[フィッシュバーン]<INFO>lighthalzen,341,224,0,101,0</INFO></NAVI>と詳しく話し合おう。"
		},
		Summary = "フィッシュバーンと会話する"
	},
	[7877] = {
		Title = "耐え難い秘密",
		IconName = "ico_nq.bmp",
		Description = {
			"フィッシュバーンは、研究所への侵入の痕跡を消すべきだと言い、リヒタルゼン空港にいる<NAVI>[アンドレア]<INFO>lhz_airport,138,28,0,101,0</INFO></NAVI>に代わりに報告するよう頼んできた。"
