	[5944] = {
		Title = "花の配達サービス",
		IconName = "ico_dq.bmp",
		Description = {
			"お客様が書いた情報に基づいて花を配達してください。配達後には配達確認書を受け取るのを忘れないでください。",
			" ",
			"今日は<NAVI>[神殿への階段]<INFO>rachel,150,192,0,101,0</INFO></NAVI>で出会った女性に花を配達してほしいと頼まれた。女の子の名前は^0000FFバイト^000000か^0000FFモリー^000000だったはず。よく覚えていない。あまり話さなかったが、可愛らしい瞳をした綺麗な女の子だった。とにかく花を送ると言ったので、よろしく頼む。"
		},
		Summary = ""
	},
	[5945] = {
		Title = "花の配達サービス",
		IconName = "ico_dq.bmp",
		Description = {
			"お客様が書いた情報に基づいて花を配達してください。配達後には配達確認書を受け取るのを忘れないでください。",
			" ",
			"今日は<NAVI>[ヴァインス村北部]<INFO>veins,218,354,0,101,0</INFO></NAVI>で出会った女性に花を配達してほしいと頼まれた。名前は^0000FFマーサ^000000？^0000FFマーシャ^000000？発音しづらい名前の女の子だった。ヴァインスに似合わない異国風の服装をした女の子を見つけるのは難しくないはずだ。とにかく花を送ると言っていたので、よろしく頼む。"
		},
		Summary = ""
	},
	[5946] = {
		Title = "花の配達サービス",
		IconName = "ico_dq.bmp",
		Description = {
			"お客様が書いた情報に基づいて花を配達してください。配達後には配達確認書を受け取るのを忘れないでください。",
			" ",
			"今日は<NAVI>[ラヘル武器屋]<INFO>rachel,42,87,0,101,0</INFO></NAVI>で出会った女性に花を配達してほしいと頼まれた。^0000FFティリング^000000？^0000FFテリング^000000？^0000FFノーテリング^000000？黄色い髪の綺麗な女の子だった。花を送ると言っていたので、よろしく頼む。"
		},
		Summary = ""
	},
	[5947] = {
		Title = "花の配達サービス",
		IconName = "ico_dq.bmp",
		Description = {
			"お客様が書いた情報に基づいて花を配達してください。配達後には配達確認書を受け取るのを忘れないでください。",
			" ",
			"今日はラヘルで働いていて故郷の<NAVI>[グレーウルフ村]<INFO>wolfvill,269,29,0,101,0</INFO></NAVI>へ帰った女性に花を配達してほしいと頼まれた。^0000FFシェール^000000？^0000FFセール^000000？何かを急いで買うような名前の女の子だった。久しぶりに顔を見ていないからグリップ・グーマン。ふふ、花を送ったと言えば喜んでくれるだろう。よろしく頼む。"
