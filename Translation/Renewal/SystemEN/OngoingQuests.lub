		Summary = "唐辛子を30個とその他の材料をスパイシー・マリの元へ持っていく"
	},
	[8127] = {
		Title = "桃太郎遠足",
		Description = {
			"村長によると、ドケビは他人のアカウントをハッキングして2000万Zenyを稼いだらしい…… 私たち街の住人は座っておしゃべりしてばかりでレベルが低いから、ドケビを倒せないんだ…… だから代わりに頼みたいんだ。"
		},
		Summary = "ドケビを倒す"
	},
	[8128] = {
		Title = "桃太郎遠足",
		Description = {
			"さて、桃太郎の物語はこれで終わりだ。最初に会った出版社のお姉さんに話しかければ報酬がもらえるよ。"
		},
		Summary = ""
	},
	[8129] = {
		Title = "桃太郎遠足",
		Description = {
			"..本来ならここで君を帰すところだが…… だが！ チャンスをやろう。ただし失敗したら、^3163FFこの挑戦には二度と挑めなくなる^000000。それに、この依頼はかなり難しいぞ。"
		},
		Summary = "ゴブリンを討伐する"
	},
	[8130] = {
		Title = "桃太郎遠足",
		Description = {
			"君はすごいな。いい動きだったよ、若いの。出口を教えよう。楽しかったよ…… 報酬を受け取るのを忘れないようにな。"
		},
		Summary = ""
	},
	[8131] = {
		Title = "アマツ領主の母",
		Description = {
			"我が主の母上はここで静養されておる。数ヶ月前から病に伏せっておられてな。それゆえ、ここに滞在しておるのだ。"
		},
		Summary = ""
	},
	[8132] = {
		Title = "アマツ領主の母",
		Description = {
			"ルーンミッドガッツ王国から来た君なら、母上の病を治せるかもしれぬ。もし成功したら、十分に報いてしよう。……母上は宮殿の外にある屋敷にお住まいだ。治療が終わったら私のところへ来てくれ。"
		},
		Summary = "領主の母の病を治す方法を探す"
	},
	[8133] = {
		Title = "狐の歌",
		Description = {
			"お坊さん、お坊さん～ 狐が私の後をつけてくるの！ 叫いても怒っても離れてくれないの！ 北の神社のお坊さんが助けてくれるはず～ ラルラルラー ラルラルラー ラルラルラーラルラルラー～～"
		},
		Summary = ""
	},
	[8134] = {
		Title = "北の神社の少年",
		Description = {
