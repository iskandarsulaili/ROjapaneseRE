	[7179] = {
		Title = "ヴィンセンテ、この野郎！",
		IconName = "ico_jq.bmp", 
		Description = {
			"<NAVI>[ヴィンセンテ]<INFO>s_atelier,24,71,0,101,0</INFO></NAVI>からの情報を頼りに、財宝への期待を胸に訪問し石像を開けたところ、出てきたのは筆だった！財宝じゃない！今すぐ問い詰めに行こう！"
