	[5856] = {
		Title = "私の名前はモーニング",
		IconName = "ico_nq.bmp",
		Description = {
			"こんにちは！このメモを読んでくれた友達へ",
			"急いで引っ越すことになって、子どもを置いてきました。ルドゥスに放置された実験体なんです。",
			"私のことは<NAVI>[モーニング]<INFO>sp_rudus,130,200,0,101,0</INFO></NAVI>と呼んでください。",
			"譲渡するわけではありません。時間がある時は会いに来ますから、朝食の世話だけお願いします。あなたの頼みには応えます。今は引き取る余裕がないのです。お願いします。",
			"-オルグ"
		},
		Summary = "",
		NpcSpr = "4_EP17_MORNING",
		NpcNavi = "sp_rudus",
		NpcPosX = 130,
		NpcPosY = 200
	},
	[5857] = {
		Title = "モーニングと友達になる",
		IconName = "ico_nq.bmp",
		Description = {
			"こんにちは！このメモを読んでくれた友達へ",
			"朝食を作ってくれてありがとうございます。少し前にポリンの話をしたせいか、ポリンが大好きなんです。ポリンのペットが1匹でもいれば、寂しくなくなるのに。",
			"それで、<ITEM>[ポリンの卵]<INFO>9001</INFO></ITEM>を手に入れてモーニングに渡してくれませんか？お願いします、友達。",
			"-オルグ"
		},
		Summary = "ポリンの卵",
		NpcSpr = "4_EP17_MORNING",
		NpcNavi = "sp_rudus",
