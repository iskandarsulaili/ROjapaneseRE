			"アルベルタの2箇所に手紙を届け、返事を受け取りました。ウォルターの上部建物にいる<NAVI>[イアナ・オペルタ]<INFO>jalbe_in.gat,67,95,0,101,0</INFO></NAVI>の元へ戻りましょう。"
		},
		Summary = "イアナ・オペルタと会話する"
	},
	[16815] = {
		Title = "ルナフォルマからの知らせ",
		IconName = "ico_ep.bmp",
		Description = {
			"アルベルタで用事を頼まれた理由を聞きました。新たな任務が与えられ、カルトの脱出者たちが到着したルナフォルマに戻る時間です。行って<NAVI>[イヴァン・ウィグナー]<INFO>jor_mbase.gat,233,277,0,101,0</INFO></NAVI>の話を聞きましょう。"
		},
		Summary = "イヴァン・ウィグナーに話しかける"
	},
	[16816] = {
		Title = "正体不明の幽霊船",
		IconName = "ico_ep.bmp",
		Description = {
			"ついに海に浮かぶ謎の幽霊船の正体を明かせるようです。アルベルタ<NAVI>[港]<INFO>jor_albe.gat,191,186,0,101,0</INFO></NAVI>で待っているマリステラと合流し、幽霊船に乗り込みましょう。"
		},
		Summary = "マリステラ・ウォルターに話しかける"
	},
	[16817] = {
		Title = "幽霊船の正体",
		IconName = "ico_ep.bmp",
		Description = {
			"漂流する幽霊船の正体を知りました。心の渇望が葬り去られた今、マリステラと共にアルベルタ<NAVI>[港]<INFO>jor_albe.gat,191,186,0,101,0</INFO></NAVI>へ戻りましょう。"
		},
		Summary = "マリステラ・ウォルターに話しかける"
	},
	[16818] = {
		Title = "ルナフォルマへ戻る",
		IconName = "ico_ep.bmp",
		Description = {
			"アルベルタでできることはほぼ終わったようです。それでは、ルナフォルマにいる<NAVI>[トリス]<INFO>mbase_in.gat,92,123,0,101,0</INFO></NAVI>の元へ戻りましょう。"
		},
		Summary = "トリスに話しかける"
	},
	[16819] = {
		Title = "魔術師からの伝言",
		IconName = "ico_ep.bmp",
		Description = {
			"アルベルタ港でマリステラに話しかけている間に、<NAVI>[ウィグナー商人]<INFO>jor_albe.gat,192,189,0,101,0</INFO></NAVI>が突然彼女の後ろで待っていた。"
