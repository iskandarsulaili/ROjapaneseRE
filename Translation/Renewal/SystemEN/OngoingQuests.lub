	[11058] = {
		Title = "臆病な少年ミハイル",
		Description = {
			"私の息子ミハイルが、私の留守中に大切にしていたマトリョーシカを壊してしまい、怖さのあまり家を出てから戻ってこないのです。"
		},
		Summary = "ミハイルを探してきてください。町の外には出ないと言っていました。"
	},
	[11059] = {
		Title = "臆病な少年ミハイル",
		Description = {
			"クックック。あいつは馬鹿で友達もいない。でも村人なら、^0000FFリンゴの木亭の女将^000000がミハイルに優しくしてくれるだろう。"
		},
		Summary = "手がかりはリンゴの木亭だけだ。行ってみよう。"
	},
	[11060] = {
		Title = "臆病な少年ミハイル",
		Description = {
			"宿泊客かどうかは知りませんね。通りすがりの旅人に施しをしているようなものですから。うちの宿に泊まると約束してくれるなら、お望みの情報をお教えしましょう。いかがですか？"
		},
		Summary = "宿に一泊して、女将にミハイルについて聞いてみよう。"
	},
	[11061] = {
		Title = "臆病な少年ミハイル",
		Description = {
			"大切なものを壊したとか、顔が青いとか、強力な接着剤が必要だとか、なぜそんなことを言うのかしら？酒場には男がたくさんいるから、そこへ行ってみてはどうかしら。"
		},
		Summary = "ミハイルは酒場に行ったようだ。酒場へ行ってミハイルを探そう。"
	},
	[11062] = {
		Title = "臆病な少年ミハイル",
		Description = {
			"接着剤のことはよく知らないが、詳しい人物を知っているから紹介しよう。酒場の隅にいるビクターという男だ。"
		},
		Summary = "ミハイルは酒場にいないようだ。宿の主人が紹介してくれたビクターにミハイルについて聞いてみよう。"
	},
	[11063] = {
		Title = "臆病な少年ミハイル",
		Description = {
