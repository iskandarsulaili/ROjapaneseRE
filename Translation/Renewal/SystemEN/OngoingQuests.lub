		Summary = ""
	},
	[8024] = {
		Title = "工場の点検",
		Description = {
			"コンベアの動きがぎこちなく不安定だ。機械の腕も、運んでいる荷重に耐えるほど強力ではないようだ……調査結果をゼルメトに報告しよう。"
		},
		Summary = ""
	},
	[8025] = {
		Title = "工場の点検",
		Description = {
