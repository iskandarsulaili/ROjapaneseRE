		IconName = "ico_ep.bmp",
		Description = {
			"ホームツリーから葉を手に入れることで傷つけることは禁止されている。だが、創造主自身が提供するなら問題ないかもしれない。しかし、前回ロバートはホームツリーの前にただ置き去りにされていたのではなかったか？"
		},
		Summary = "ロバートの再訪"
	},
	[12300] = {
		Title = "エトランを再訪する",
		IconName = "ico_ep.bmp",
		Description = {
			"ホームツリーの葉を見せ、エトランを励ます。ロバートが首飾りを受け取るのを拒否したことは重大だったが……"
		},
		Summary = "エトランを再訪"
	},
	[12301] = {
		Title = "残る二人の友",
		IconName = "ico_ep.bmp",
		Description = {
			"ロバートとエトランは最後まで自らの運命を全うするだろう。過去の地（彼らにとっては現在の地だが……）が、現在の豊かな大地となるまで。彼らの出会いを可能にしたヒールとクレバーに話しかけよう。"
		},
		Summary = "残る二人の友"
	},
	[12302] = {
		Title = "サリム・ハミド",
		Description = {
			"サリム・ハミドというマーチャントの案内人と話した。"
		},
		Summary = "マーチャントの案内人に話しかける"
	},
	[12303] = {
		Title = "交易商人志願者",
		Description = {
			"100Zeny所持している者だけが、サリム・ハミドの有名なマーチャント講義を受ける資格があるという。大した額ではないので、アイテムを探して売る必要がある。"
		},
		Summary = "100Zenyを獲得する"
	},
	[12304] = {
		Title = "商学入門",
		Description = {
			"マーチャントには合法的に金銭を得るための様々なスキルがある。サリム・ハミドの隣にいる執事から説明を聞こう。"
		},
		Summary = "交渉の秘訣"
	},
	[12305] = {
		Title = "能力値について",
		Description = {
