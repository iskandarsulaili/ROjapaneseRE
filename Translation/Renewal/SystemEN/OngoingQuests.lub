	-- Note: These quests from iRO are different from kRO's (They're used on Cat Pub quests)
	[17000] = {
		Title = "バンプ神父に会う",
		IconName = "ico_ep.bmp",
		Description = {
			"国際飛行船の職員によると、バンプ神父がプロンテラの教会であなたを待っているらしい。会いに行ったほうがよさそうだ。"
		},
		Summary = "バンプ神父と話す"
	},
	[17001] = {
		Title = "ラルジェスに会う",
		IconName = "ico_ep.bmp",
		Description = {
			"バンプ神父によると、高位の役人が突然行方不明になり、最後に目撃されたのはコモドだという。ラルジェスを探せば、行方不明の役人捜索を手伝ってくれるだろう。"
		},
		Summary = "ラルジェスと話す"
	},
	[17002] = {
		Title = "バンプ神父に報告する",
		IconName = "ico_ep.bmp",
		Description = {
			"ラルジェスによると、その役人はアルナフェルツの組織によって誘拐されたらしい。バンプ神父に報告すべきだ。"
		},
		Summary = "バンプ神父と話す",
		RewardEXP = "300000",
		RewardJEXP = "300000"
	},
	[17003] = {
		Title = "ラヘルへ向かう",
		IconName = "ico_ep.bmp",
		Description = {
			"バンプ神父が、行方不明の役人の調査を続けるため、彼の代わりにラヘルへ行くように頼んできた。"
		},
		Summary = "イズルード飛行船でラヘルへ"
	},
	[17004] = {
		Title = "ヴァインスへ向かう",
		IconName = "ico_ep.bmp",
		Description = {
			"隣の席の会話を盗み聞きした後、ヴァインスでヴァインス縞模様のトゲウオをもっと見つけられるかどうか確かめるため、ヴァインスへ行くことにした。"
		},
		Summary = "ヴァインス"
	},
	[17005] = {
		Title = "悩める判事",
		IconName = "ico_ep.bmp",
		Description = {
			"アル・ハマド判事は、見知らぬ人に自分の問題を話すのは気が進まないと言う……状況を知っていそうな人物を探そう。"
		},
		Summary = "",
		RewardEXP = "300000",
		RewardJEXP = "300000"
	},
	[17006] = {
		Title = "尋問された密輸業者",
		IconName = "ico_ep.bmp",
		Description = {
			"密輸業者が連行される前に、判事が尋問できたかどうか確認すべきだ。"
		},
		Summary = "アル・ハマド判事"
	},
	[17007] = {
		Title = "書面命令",
		IconName = "ico_ep.bmp",
		Description = {
			"密輸業者についてもっと詳しく知りたいのなら、高位の役人からの書面命令をアル・ハマドに持っていく必要がある。"
		},
		Summary = ""
	},
	[17008] = {
		Title = "調査中",
		IconName = "ico_ep.bmp",
		Description = {
			"ジェッド大司教は他の事柄で手一杯だが、ニレン大司教ならヴァインスの密輸業者について何か知っているかもしれない。"
		},
		Summary = "ニレン大司教"
	},
	[17009] = {
		Title = "追加調査",
		IconName = "ico_ep.bmp",
		Description = {
			"ニレン大司教から、ルーンミッドガッツ王国の高位の役人がまだ生きているかどうか確かめてほしいと頼まれた。アル・ハマド判事の元へ行けば、旅に役立つ情報を提供してくれるだろう。"
		},
		Summary = "アル・ハマド判事"
	},
	[17010] = {
		Title = "さらなる調査",
		IconName = "ico_ep.bmp",
		Description = {
			"アル・ハマド判事は、密輸業者とルーンミッドガッツ王国の高位の役人との関係について詳しく説明してくれた。ヴァインスへ行き、彼らの失踪について何か知っている人がいないか確かめるべきだ。"
		},
		Summary = ""
	},
	[17011] = {
		Title = "クルディの父",
		IconName = "ico_ep.bmp",
		Description = {
			"酔っ払いが海に出る幽霊について何か言っていた。クルディの父は漁師なので、何か知っているかもしれない。彼に聞いてみよう。"
		},
		Summary = "クルディの父"
	},
	[17012] = {
		Title = "カリンの船",
		IconName = "ico_ep.bmp",
		Description = {
			"カリンの父は今、海に出ることを禁じられている。しかしカリンによれば、船を借りるなら問題ないらしい。南の浜辺にある唯一の船なので、見つけるのは難しくないだろう。"
		},
		Summary = ""
	},
	[17013] = {
		Title = "島へ",
		IconName = "ico_ep.bmp",
		Description = {
			"ラルジェスがずっとあなたを尾けていたことを明かし、修道院へ船を出す手助けを申し出てきた。島に着いたら調査しよう。"
		},
		Summary = "",
		RewardEXP = "600000",
		RewardJEXP = "600000",
		RewardItemList = {
			{ ItemID = 25723, ItemNum = 20 }
		}
	},
	[17014] = {
		Title = "島の調査",
		IconName = "ico_ep.bmp",
		Description = {
			"ラルジェスは船で待つことにし、あなたは島の謎を調査することになった。"
		},
		Summary = ""
	},
	[17015] = {
		Title = "研究ノート",
		IconName = "ico_ep.bmp",
		Description = {
			"血で赤く染まった日記を見つけた。内容は読み取りにくいが、ある項目にはクリーチャーを召喚する方法を学んだと書かれている。調査を続けるべきだ。"
		},
		Summary = ""
	},
	[17016] = {
		Title = "王殺し",
		IconName = "ico_ep.bmp",
		Description = {
			"死体を調べたところ、王のトークンを持っていることが分かった……つまり彼はトリスタム3世だったのだ……。ラルジェスの元へ戻り、これを知らせるべきだ。"
		},
		Summary = "ラルジェス"
	},
	[17017] = {
		Title = "王の死を報告する",
		IconName = "ico_ep.bmp",
		Description = {
			"トリスタム3世の死という衝撃的な知らせは軽く受け止めるべきではない。これを報告し、研究ノートをニレン大司教に届けるべきだ。"
		},
		Summary = "ニレン大司教"
	},
	[17018] = {
		Title = "患者の状態",
