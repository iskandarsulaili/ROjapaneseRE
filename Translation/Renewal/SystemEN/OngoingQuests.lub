		},
		Summary = ""
	},
	[8026] = {
		Title = "工場の点検",
		Description = {
			"見つけたパイプは、長期間の過負荷圧力によって膨張し、摩耗していた。爆発していないのが不思議なくらいだ。調査結果をゼルメトに報告しよう。"
		},
		Summary = ""
	},
	[8027] = {
		Title = "工場の点検",
		Description = {
			"最後にゼルメトが点検を頼んだのは、より大きく強力なコンベアだ。見つけて調査結果をゼルメトに報告しよう。"
		},
		Summary = ""
	},
	[8028] = {
		Title = "工場の点検",
		Description = {
			"この最後のコンベアには、小さいバージョンと同様の問題があるようだ。動きが不器用で、不規則で、弱く、ネジのほぼすべてが錆びている。調査結果をゼルメトに報告しよう。"
		},
		Summary = ""
	},
	[8029] = {
		Title = "工場の点検",
		Description = {
			"ゼルメトは、修理に必要な材料を確保するため、監督官に工場修理予算の増額を申請する必要があると言っている。監督官を探そう。"
