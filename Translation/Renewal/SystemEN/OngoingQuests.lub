	[18139] = {
		Title = "大切な食料",
		IconName = "ico_dq.bmp",
		Description = {
			"蛇の巣で出会った<NAVI>[ミミルガンド]<INFO>jor_nest,34,79,0,101,0</INFO></NAVI>は、依然として邪悪な者たちの魔法を回復させたいと願っている。罪とは原始Rganと最下級Rganを指しているようだ。罪を排除し、Rganの下級魔法コア 30個を回収しよう。"
