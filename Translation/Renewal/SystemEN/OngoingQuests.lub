	},
	[14004] = {
		Title = "ヴァルキリーリング",
		Description = {
			"ヴァルキリーリングの箱を受け取れ。"
		},
		Summary = ""
	},
	[14118] = {
		Title = "ウハリの悩み",
		IconName = "ico_ep.bmp",
		Description = {
			"ウハリは牢獄にいる弟を心配している。牢獄への道を見つけ、ウハリの心のこもった手紙を牢獄の弟に届けてほしい。"
		},
		Summary = ""
	},
	[14119] = {
		Title = "忍耐の試練",
		IconName = "ico_ep.bmp",
		Description = {
			"話しかけても囚人は反応しない。私の忍耐を試しているようだ。"
		},
		Summary = "囚人との対話"
	},
	[14120] = {
		Title = "忍耐の試練2",
		IconName = "ico_ep.bmp",
		Description = {
			"何度話しかけても囚人はまだ反応しない。もう一度試してみよう。"
		},
		Summary = "囚人との対話"
	},
	[14121] = {
		Title = "忍耐の試練3",
		IconName = "ico_ep.bmp",
		Description = {
			"何を言ってもその男は口を閉ざしたままだ。他に方法はないのだろうか。"
		},
		Summary = "囚人との対話"
	},
	[14122] = {
		Title = "二人だけの時間",
		IconName = "ico_ep.bmp",
		Description = {
			"ウハリの手紙はウフルに届けられた。彼は手紙を読むために少し時間が欲しいと言った。彼が手紙を読んでいる間は邪魔をしないように。"
		},
		Summary = "手紙を読む時間を与える"
	},
	[14123] = {
		Title = "ウフルの頼み",
		IconName = "ico_ep.bmp",
		Description = {
			"弟の手紙を読んだ後、ウフルは自身の話を詳しく語り始め、弟によろしく伝えてほしいと頼んできた。ウハリのところへ戻り、弟の言葉を伝えよう。"
		},
		Summary = "ウハリへ伝言を送る"
	},
	[14124] = {
		Title = "最初の依頼",
		Description = {
			"昨晩、ジェイドの動物が盗まれた。調査して何が起きたか報告せよ。"
		},
		Summary = "ジェイドの家"
	},
	[14125] = {
		Title = "周辺の調査",
		IconName = "ico_ep.bmp",
		Description = {
			"ウハリはウフルの体を取り戻す方法を探している。しかし、どうすればいいのか分からない。近くの地域の人々なら何か知っているのではないか？周辺の地域を調査しよう。"
		},
		Summary = "街の人々に話を聞く"
	},
	[14126] = {
		Title = "ミセスゴーティーを探す",
		IconName = "ico_ep.bmp",
		Description = {
			"マシオネ氏はあまり何も知らないと言った。しかし、こうしたことにずっと鋭いミセスゴーティーを紹介してくれた。"
		},
		Summary = "ミセスゴーティーを探せ"
	},
	[14127] = {
		Title = "ミセスゴーティーの夫を探す",
		IconName = "ico_ep.bmp",
		Description = {
			"ミセスゴーティーは、ウフルが紙切れを空中で振り回してとても喜んでいたと話した。その紙について尋ねると、夫がもっと詳しく知っているかもしれないと言った。"
		},
		Summary = "ミセスゴーティーの夫を探せ"
	},
	[14128] = {
		Title = "研究報告書の入手",
		IconName = "ico_ep.bmp",
		Description = {
			"ウフルと常に親しかったスベリー氏は、何かを知っていた。ウフルが牢獄に連れて行かれる前に残した手紙の中に研究報告書があった。それをウハリに届けよう。"
		},
		Summary = "報告書の配達"
	},
	[14131] = {
		Title = "分析の時間",
		Description = {
			"ウハリは報告書を受け取ったが、分析には少し時間がかかると言った。後でもう一度話しかけてみよう。勉強中の人を邪魔してはいけない。"
		},
		Summary = "分析の時間"
	},
	[14132] = {
		Title = "私たちの研究",
		Description = {
			"動物が見つかった後、まず何が起きているのか調査しなければならない。"
		},
		Summary = "私たちの研究"
	},
	[14133] = {
		Title = "もう一つの頼み",
		IconName = "ico_ep.bmp",
		Description = {
			"ウハリは研究報告書を分析したが、弟の体を取り戻す方法についてはまだ確信が持てなかった。最初にウフルの研究参加を依頼したラピンを見つけて聞いてみよう。"
		},
		Summary = "証拠の入手"
	},
	[14134] = {
		Title = "鋭いミセス・ゴーティ",
		IconName = "ico_ep.bmp",
		Description = {
			"スベリー氏のところを訪ねて詳しい話を聞いたが、彼は高位ラピンについて何も知らないという。しかし、こうしたことに詳しい妻に聞いてみてはどうかと提案された。"
		},
		Summary = "ゴーティ夫人の元へ"
	},
	[14135] = {
		Title = "ポンペ氏を捜して",
		IconName = "ico_ep.bmp",
		Description = {
			"高位ラピンの行方について尋ねたが、ゴーティ夫人はあまり知らなかった。しかし、街の住人であるポンペ氏が、畑でラピンを見かけ、その後姿を消したと話してくれた。ポンペ氏に詳しく聞いてみよう。"
		},
		Summary = "ポンペ氏からの話を聞く"
	},
	[14136] = {
		Title = "畑の凄惨な光景",
		IconName = "ico_ep.bmp",
		Description = {
			"ポンペ氏は畑に出るのを恐れている。高位ラピンが凄惨な死を遂げて以来、大きな死体が横たわっているという。畑を調査しよう。"
		},
		Summary = "畑の調査"
	},
	[14137] = {
		Title = "興味深い提案",
		IconName = "ico_ep.bmp",
		Description = {
			"一人のラピンの少女が興味深い提案をした。どうやらウフフに研究報告書を渡したラピンは、彼女が探している行方不明の父親のようだ。一緒に探してみよう。"
		},
		Summary = "畑の調査"
	},
	[14138] = {
		Title = "大きな死体",
		IconName = "ico_ep.bmp",
		Description = {
			"そこには、しばらく前から横たわっていると思われる大きな死体があった。それは皆が探していたラピンだった。この悪い知らせを少女に伝えなければならない。"
		},
		Summary = "ジラニへの報告"
	},
	[14139] = {
		Title = "ウフフの元へ",
		IconName = "ico_ep.bmp",
		Description = {
			"少女はその死体が父親のものだと確認した。目的のラピンが死亡したため、手ぶらでウハリの元へ戻らなければならない。その前に、一緒に仕事をしていたラピンのことをウフフに伝えよう。"
		},
		Summary = "ウフフの元へ"
	},
	[14140] = {
		Title = "ウハリの元へ",
		IconName = "ico_ep.bmp",
		Description = {
			"ウフフはすべての話をしてくれたが、それをそのままウハリに伝えることはできない。ラピンが死亡したことだけでもウハリに伝えに行こう。"
		},
		Summary = "ウハリへの報告"
	},
	[14141] = {
		Title = "研究の材料",
		IconName = "ico_ep.bmp",
		Description = {
			"ウハリが自分で研究するための材料を求めてきた。ウハリに必要な材料を渡そう。（翼の破片1個、丈夫な髪の毛1個、ブラディウム1個、闇のルーン1個、血のルーン1個）"
		},
		Summary = "アイテムを入手！"
	},
