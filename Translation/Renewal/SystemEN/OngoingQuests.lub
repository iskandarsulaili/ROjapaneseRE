	[12505] = {
		Title = "未完成の亀裂の封印",
		IconName = "ico_ev.bmp",
		Description = {
			"一見未完成に見える亀裂から、不吉なエネルギーが滲み出している。オスカーさえ気づかなかった歪んだ時空があるとしたら、深刻な問題を引き起こす可能性がある。",
