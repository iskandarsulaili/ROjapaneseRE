		Summary = "氷の城の食堂へ向かう"
	},
	[17640] = {
		Title = "混乱する蛇の巣",
		IconName = "ico_ep.bmp",
		Description = {
			"あなたが持っているルガンとは何ですか？氷の城にある私の<NAVI>[家]<INFO>icas_in,247,116,0,101,0</INFO></NAVI>はここから近いので、そこへ行きましょう。"
		},
		Summary = "ホルの家へ向かう"
	},
	[17641] = {
		Title = "混乱する蛇の巣",
		IconName = "ico_ep.bmp",
		Description = {
			"解毒剤を作りますので、ルガンの下級魔法核を20個だけ持って<NAVI>[氷の城]<INFO>icas_in,247,116,0,101,0</INFO></NAVI>へ来てください。"
		},
		Summary = "ルガンの下級魔法核 20個"
	},
	[17642] = {
		Title = "混乱する蛇の巣",
		IconName = "ico_ep.bmp",
		Description = {
			"氷の城のホルの家で<NAVI>[ジュンシア]<INFO>icas_in,243,117,0,101,0</INFO></NAVI>が目を覚まし、何かを心配している様子だ。この状況なら、ほぼ確信が持てそうだ。"
		},
		Summary = "ジュンシアを説得する"
	},
	[17643] = {
		Title = "混乱する蛇の巣",
		IconName = "ico_ep.bmp",
		Description = {
			"<NAVI>[オーレリー]<INFO>icas_in,249,113,0,101,0</INFO></NAVI>が自ら知らせを伝えるため、氷の城のホルの家に現れた。何か大きなことでもあったのだろうか？"
