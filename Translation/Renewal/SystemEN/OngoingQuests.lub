	},
	[7397] = {
		Title = "ムンバキ・ポンの助言",
		Description = {
			"ムンバキ・ポンは、霊から逃げるのではなく、受け入れ、なだめるべきだと言った。供え物として、少なくとも気品ある花3個、不思議な花3個、美しい花3個を用意しよう。供えるための花を探そう。近くの動物やモンスターから花を手に入れることができる。"
		},
		Summary = "気品ある花3個、不思議な花3個、美しい花3個"
	},
	[7398] = {
		Title = "ムンバキが推奨する供え物のブーケ",
		Description = {
			"ムンバキ・ポンが持って行った花を祝福し、供え物のブーケを作ってくれた。このブーケを渡し船の幽霊ディワタに持って行こう。"
