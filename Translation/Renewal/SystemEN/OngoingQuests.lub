		IconName = "ico_nq.bmp",
		Description = {
			"販売露店／購入露店でアルバイトを雇うには、商人連盟が配布する雇用証明書が必要だ。1日1回、商人連盟のマシャからの依頼を解決することで、難易度に応じた異なるレベルの雇用証明書を入手できる。さあ、依頼を解決しよう。"
		},
		Summary = ""
	},
	[8368] = {
		Title = "露店を利用しますか？ - 待機",
		Description = {
			"7日に1回可能だが、先生の依頼がなくても、宣伝目的で1日1回、1週間無料の12時間雇用証明書を提供する。"
		},
		Summary = "04:00にリセット",
		CoolTimeQuest = 1
	},
