	[11861] = {
		Title = "厄除けの肖像画",
		IconName = "ico_ev.bmp",
		Description = {
			"新年を祝い、チュルホは新年の厄除けの絵を描いてくれると言い、筆と紙、墨を持ってきてほしいと頼んだ。まず、筆を手に入れるためにアルベルタの<NAVI>[サンピル]<INFO>alberta,105,80,0,101,0</INFO></NAVI>に会おう。"
