	[7450] = {
		Title = "オーブの点灯室",
		IconName = "ico_ep.bmp",
		Description = {
			"<NAVI>[参謀]<INFO>ecl_in03,245,93,0,101,0</INFO></NAVI>がなぜオーブの点灯室へ誘い込もうとしているのか分からないが、その理由を確かめるためにも行ってみることにした。今は彼の望みに沿って動こう。"
		},
		Summary = "参謀についていく"
	},
	[7451] = {
		Title = "裏切り",
		IconName = "ico_ep.bmp",
		Description = {
			"すべてが混乱している。点灯室で戦ったモンスターは魔王の部下ではなかった。彼らは私の知らぬ間に私を操っていた。参謀のシュナイムがすべてを裏切ったのだ！<NAVI>[Kardui]<INFO>ecl_in03,41,90,0,101,0</INFO></NAVI>に知らせなければならない。"
		},
		Summary = "カルドゥイに報告する"
	},
	[7452] = {
		Title = "参謀を探せ！",
		IconName = "ico_ep.bmp",
		Description = {
			"これらすべての事態の元凶である参謀のシュナイムが、行方をくらましてしまった。ヒジエの情報筋によれば、ビフレストに微弱な魔力の残留が感じられるという。"
		},
		Summary = "ビフレスト北部を調査する",
		NpcSpr = "4_FAIRYDEADLEAF",
		NpcNavi = "bif_fild02",
		NpcPosX = 311,
		NpcPosY = 91
	},
	[7453] = {
		Title = "参謀の最期",
		IconName = "ico_ep.bmp",
		Description = {
			"ビフレストの北から南への道。かつては開かれていた道だが、現在は南の巨大な裂け目によって遮断されている。その裂け目へ向かう途中で、参謀の死体が見つかった。<NAVI>[Kardui]<INFO>ecl_in03,41,90,0,101,0</INFO></NAVI>に報告しよう。"
		},
		Summary = "カルドゥイに報告する"
	},
