		IconName = "ico_jq.bmp",
		Description = {
			"エルマは高位精霊の召喚について知りたがっているようだ。キランに話しかけよう。"
		},
		Summary = "キランに話しかける"
	},
	[11675] = {
		Title = "エレメンタルマスターへの転職",
		IconName = "ico_jq.bmp",
		Description = {
			"キランは教えられることは何もないと言った。"
		},
		Summary = "エルマに話しかける"
	},
	[11676] = {
		Title = "エレメンタルマスターへの転職",
		IconName = "ico_jq.bmp",
		Description = {
			"エルマはキランが^ff0000ヴァルムント邸^000000を訪れているのを見たという。まず、ヴァルムント邸の^ff0000動力室^000000で手がかりを探してみよう。"
		},
		Summary = "動力室の調査"
	},
	[11677] = {
		Title = "エレメンタルマスターへの転職",
		IconName = "ico_jq.bmp",
		Description = {
			"モンスターのせいで調査に集中できないという。^ff0000マジカルドロールを10体とアンリーシュドマジックを10体倒そう^000000。"
		},
		Summary = "邪魔なモンスターを倒す"
	},
	[11678] = {
		Title = "エレメンタルマスターへの転職",
		IconName = "ico_jq.bmp",
		Description = {
			"動力室からは精霊の召喚に関する手がかりは得られなかった。^ff0000ヴァルムントの図書館^000000を調べてみよう。"
		},
		Summary = "ヴァルムント図書館の調査"
	},
	[11679] = {
		Title = "エレメンタルマスターへの転職",
		IconName = "ico_jq.bmp",
		Description = {
			"本が逃げ回って読めない。^ff0000ローミングスペルブックを10体捕まえ^000000、エルマが調べていた本棚に戻ろう。"
		},
		Summary = "ローミングスペルブックを回収する"
	},
	[11680] = {
		Title = "エレメンタルマスターへの転職",
		IconName = "ico_jq.bmp",
		Description = {
			"回収した魔術書からは必要な情報は見つからなかった。もう一度本棚を調べてみよう。"
		},
		Summary = "もう一度本棚を調べる"
	},
	[11681] = {
		Title = "エレメンタルマスターへの転職",
		IconName = "ico_jq.bmp",
		Description = {
			"本棚を調べると、小さな妖精が召喚された。移動した場所にいる妖精に話しかけよう。"
		},
		Summary = "ユクに話しかける"
	},
	[11682] = {
		Title = "エレメンタルマスターへの転職",
		IconName = "ico_jq.bmp",
		Description = {
			"ユクは自分を召喚したように、シェズとイヴァンを召喚してほしいと言った。ユクの案内に従い、指示に沿ってシェズとイヴァンを召喚しよう。"
		},
		Summary = "シェズとイヴァンを召喚する"
	},
	[11683] = {
		Title = "エレメンタルマスターへの転職",
		IconName = "ico_jq.bmp",
		Description = {
			"ユクの頼み通り召喚を完了したが、騒ぎが原因でエグノロリア師匠に見つかってしまった。"
		},
		Summary = "師匠に話しかける"
	},
	[11684] = {
		Title = "ジャックとジャックの奇妙な目",
		IconName = "ico_ev.bmp",
		Description = {
			"悲しそうなジャックは、ニブルヘイムの南にいるジャックからニャーと仲良くなる方法を学びたがっている。ニブルヘイムの南にいるジャックに話しかけよう。"
		},
		Summary = "ニブルヘイムの南にいるジャックの元へ行く"
	},
	[11685] = {
		Title = "ジャックとジャックの奇妙な目",
		IconName = "ico_ev.bmp",
		Description = {
			"ジャックの猫がウィズについていったらしい。道の左側にいるウィズに話しかけよう。"
		},
		Summary = "ウィズに話しかける"
	},
	[11686] = {
		Title = "ジャックとジャックの奇妙な目",
		IconName = "ico_ev.bmp",
		Description = {
			"ニャーの話を聞きたいなら、スケルトンの骨を2個持ってきてほしいと言われた。スケルトンの骨を2個手に入れてウィズの元へ戻ろう。"
		},
		Summary = "スケルトンの骨 2個"
	},
	[11687] = {
		Title = "ジャックとジャックの奇妙な目",
		IconName = "ico_ev.bmp",
		Description = {
			"スケルトンの骨を1個受け取ったウィズは、もう1個をニブルヘイムの南にいるジャックに渡せと言った。スケルトンの骨をジャックに届けよう。"
		},
		Summary = "ニブルヘイムの南にいるジャックの元へ行く"
	},
	[11688] = {
		Title = "ジャックとジャックの奇妙な目",
		IconName = "ico_ev.bmp",
