	[21201] = {
		Title = "行方不明者の捜索",
		Description = {
			"モロクで出会った老学者が、アサシンギルドを探しに行くと言って一人で出かけた弟子の捜索を依頼してきた。アサシンギルドがあるモロクの南東の砂漠へ行ってみよう。"
