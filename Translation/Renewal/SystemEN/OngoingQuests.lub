	[17639] = {
		Title = "偵察報告への同行",
		IconName = "ico_ep.bmp",
		Description = {
			"私も氷の城へ向かうところなので、ご一緒しましょう。食事は済ませましたので、<NAVI>[食堂]<INFO>icas_in,34,189,0,101,0</INFO></NAVI>でお待ちしています。"
