		Summary = "フレイヤの泉へ向かう"
	},
	[8123] = {
		Title = "アユタヤの世界名物、トムヤムクン",
		Description = {
			"トムヤムクンなら誰でも作れるけど、^0000FFスパイシー・マリ^000000を訪ねてみることをお勧めするわ。彼女は最高の料理人よ。彼女に作ってもらうよう頼んでみたら？"
