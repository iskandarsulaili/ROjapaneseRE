		IconName = "ico_dq.bmp",
		Description = {
			"グレイウルフ村の<NAVI>[エルイン]<INFO>wolfvill,202,166,0,101,0</INFO></NAVI>は、明日も手伝ってほしいと思っているようだ。"
		},
		Summary = "04:00にリセット",
		CoolTimeQuest = 1
	},
	[8690] = {
