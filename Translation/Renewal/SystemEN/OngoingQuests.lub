	},
	[3001] = {
		Title = "バードへの転職 - 授業料は花？",
		IconName = "ico_jq.bmp",
		Description = {
			"<NAVI>[バードのラロ]<INFO>comodo,211,155,0,101,0</INFO></NAVI>は花を持ってくれば歌い方を教えてくれるという。どんな花でもいいわけではないので、<ITEM>[歌う花]<INFO>629</INFO></ITEM>、<ITEM>[ヒナレ]<INFO>703</INFO></ITEM>、<ITEM>[アロエ]<INFO>704</INFO></ITEM>、<ITEM>[メント]<INFO>708</INFO></ITEM>、<ITEM>[イジドール]<INFO>709</INFO></ITEM>、<ITEM>[枯れないバラ]<INFO>748</INFO></ITEM>、<ITEM>[氷のバラ]<INFO>749</INFO></ITEM>、<ITEM>[幻覚の花]<INFO>710</INFO></ITEM>の中から選ぼう。"
		},
		Summary = "ラロが欲しがる花1つ"
	},
	[3002] = {
		Title = "バードへの転職 - バードへの第一歩",
		IconName = "ico_jq.bmp",
		Description = {
			"バードのラロが、ルティエにいる喋る雪だるまを見つけて、彼からプレゼントを受け取ってほしいと言っている。"
		},
		Summary = "喋る雪だるまと仲良くなろう"
	},
	[3003] = {
		Title = "バードへの転職 - 一緒に歌おう",
		IconName = "ico_jq.bmp",
		Description = {
			"<NAVI>[バードのラロ]<INFO>comodo,211,155,0,101,0</INFO></NAVI>が長い間歌い続けており、間違えずに一緒に歌ってほしいと言っている。正しく一緒に歌えればバードになれるらしい…"
		},
		Summary = "バードのラロの歌についていこう"
	},
	[3004] = {
		Title = "バードへの転職 - 最後の関門",
		IconName = "ico_jq.bmp",
		Description = {
			"<NAVI>[バードのラロ]<INFO>comodo,211,155,0,101,0</INFO></NAVI>が、<ITEM>[木の枝]<INFO>1019</INFO></ITEM>、<ITEM>[細かい木の枝]<INFO>1066</INFO></ITEM>、<ITEM>[丈夫な木の枝]<INFO>1067</INFO></ITEM>、<ITEM>[枯れた木の枝]<INFO>1068</INFO></ITEM>の中から同じ種類のものを60個持ってくれば、バードに転職した記念品を作ってくれるという。"
		},
		Summary = "同じ種類の木の枝60個"
