	[8125] = {
		Title = "アユタヤの世界名物、トムヤムクン",
		Description = {
			"スパイシー・マリは近くにとても良いレモンの木を見つけたのだけど、そのレモンは売り物ではなかったわ。レモンの木の持ち主からレモンを手に入れなければならないわ。"
