		Summary = ""
	},
	[3119] = {
		Title = "Z団指名手配 - 指名手配書",
		Description = {
			"ルーンミッドガッツ王国の治安維持局は、Z団を捕らえた者に報奨金を与えるという。挑戦してみてはどうだろうか？もう少し情報を集めてみよう。"
		},
		Summary = ""
	},
	[3120] = {
		Title = "Z団指名手配 - Z団について",
		Description = {
			"Z団のメンバーは3人。ルイス・フォン・シロケンズ通称ルイス、マーサ・ヘルティザン通称マーサ、そしてキャットフォイイ通称キャットフォイイを捕らえなければならない！ヴァルデスという騎士からさらに情報が得られるだろう。"
		},
		Summary = ""
	},
	[3121] = {
		Title = "Z団指名手配 - ヴァルデスの頼み",
		Description = {
			"ヴァルデスを見つけたが、彼は酔っ払っている。モロクフルーツワインを5本持ってこなければ、情報は一切教えないという。"
		},
		Summary = "モロクフルーツワイン 5本"
	},
	[3122] = {
		Title = "Z団指名手配 - ヴァルデスからの情報",
		Description = {
			"Z団を見つけるためには、ローグギルドのエージェントと接触することをお勧めする。ローグのエージェント、マリベルを見つけて情報を得よう。彼女に伝えるべき合言葉は\"^3355FF夜明けはまだ来ない^000000\"だ。"
		},
		Summary = ""
	},
	[3123] = {
		Title = "Z団指名手配 - マリベルの試練",
		Description = {
			"マリベルはあなたを試そうとしている。パヨンの伝説のギャンブラー、ムンホ・アンから推薦状を入手できれば信用するという。"
		},
		Summary = ""
	},
	[3124] = {
		Title = "Z団指名手配 - ムンホ・アンへの挑戦",
		Description = {
			"ムンホ・アンは、準備ができたらまた来るようにと言う。推薦状を得るには、彼に勝たなければならない。"
		},
		Summary = ""
	},
	[3125] = {
		Title = "Z団指名手配 - ムンホ・アンへの挑戦",
		Description = {
			"ムンホ・アンに勝利した。推薦状を持ってマリベルの元に戻ろう。"
		},
		Summary = ""
	},
	[3126] = {
		Title = "Z団指名手配 - マリベルからの情報",
		Description = {
			"Z団は大陸中のトラブルのほとんどに関与している。Z団の密偵を見つけなければならない。Z団はモロクで密かに密偵を募集している。"
		},
		Summary = ""
	},
	[3127] = {
		Title = "Z団指名手配 - Z団の襲撃",
		Description = {
			"モロクで情報を集めている最中に怪しい男に襲われた。どこへ逃げたのだ？…この怪しい男はZ団と関係があるようだ。追跡しよう！"
		},
		Summary = ""
	},
	[3128] = {
		Title = "Z団指名手配 - Z団の襲撃",
		Description = {
			"Z団の密偵を見つけた。Z団のアジトはモロクの砂漠のどこかにあるようだ…マリベルの元に戻ろう。"
		},
		Summary = ""
	},
	[3129] = {
		Title = "Z団指名手配 - 怪しい手紙",
		Description = {
			"マリベルはZ団の密偵から暗号化された封筒に入った白紙の手紙を手に入れ、パヨンの暗号解読者、グホ・アンに暗号解読を依頼した。"
		},
		Summary = ""
	},
	[3130] = {
		Title = "Z団指名手配 - 手紙の解読…",
		Description = {
			"白紙の手紙に見えるが、適切な熱と光を加えれば内容が読める。そのための材料が必要だ。^0000ff燃えている炭 20個、マッチ箱 1個、アルコール 2個、燃える心臓 10個^000000を集めよう。"
		},
		Summary = ""
	},
	[3131] = {
		Title = "Z団指名手配 - 暗号解読！",
		Description = {
