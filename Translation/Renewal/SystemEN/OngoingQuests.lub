	},
	[8196] = {
		Title = "三国同盟の確執",
		IconName = "ico_ep.bmp",
		Description = {
			"最近、研究者たちがよく文句を言っているの。彼らはひどくストレスを抱えていて、誰かが彼らの不満を聞いてあげるべきだわ。特に書類を扱っている人たちは、何度も言い争いをしているの。まずは彼らに話を聞いてみるといいわ。"
		},
		Summary = ""
	},
	[8197] = {
		Title = "書類の配達",
		IconName = "ico_ep.bmp",
		Description = {
			"それでは、この書類をヒューとハンセンヌに届けてちょうだい。ヒューはシュバルツバルトの書類を、ハンセンヌはアルナフェルツの書類を担当しているわ。シュバルツバルトの事務所にいるヒューに会いに行って。そうしないと彼、また文句を言うから。"
		},
		Summary = "書類をヒューとハンセンヌに届け、リョーセンのもとへ戻る"
	},
	[8198] = {
		Title = "連合研究の職員に報告する",
		IconName = "ico_ep.bmp",
		Description = {
			"まあ、覆水盆に返らず、ですわ。好き嫌いは言っていられません。この書類を連合研究の職員に届けてちょうだい。その間に、私は会議の準備をしておきますわ。"
		},
		Summary = "書類を連合研究の職員に届ける"
	},
	[8199] = {
		Title = "連合研究職員の依頼",
		IconName = "ico_ep.bmp",
		Description = {
			"お願いですから、会議には参加して、何か問題が起きたら仲介してください！まずはあの3人に会って、会議の準備状況を確認してきてちょうだい。武器なんか準備していないといいけれど。"
		},
		Summary = ""
	},
	[8200] = {
		Title = "リョーセンの書類の依頼",
		IconName = "ico_ep.bmp",
		Description = {
			"アルナフェルツの事務所に書類を依頼したんだけど、まだ届かないの。ハンセンヌから取ってきてくれない？会議に必要な書類なのに、彼ってば全然送ってくれないのよ。また忘れてるに違いないわ！"
		},
		Summary = ""
	},
	[8201] = {
		Title = "紛失した書類",
		IconName = "ico_ep.bmp",
		Description = {
			"落としちゃったの。橋で宝探しをした時に、川に落としたかもしれないの！でもね、南西にいるあの猫たちが釣りを教えてくれるって聞いたわ。川で釣りをすれば、その書類も釣れるかもしれないわ！"
		},
		Summary = "釣り上げた書類を持ってハンセンヌのもとへ戻る"
	},
	[8202] = {
		Title = "書類の修復",
		IconName = "ico_ep.bmp",
		Description = {
			"シュバルツバルトの人たちは、こういうものを修復する才能があるのよ…。ヒューに修復をお願いしてみたら？彼ったら大声で叫んで、窓ガラスを割っちゃうかもしれないけれど。"
		},
		Summary = ""
	},
	[8203] = {
		Title = "書類の修復",
		IconName = "ico_ep.bmp",
		Description = {
			"完全に濡れちゃってるわ…。まずこれを乾かして、しわを伸ばさないと。それから文字を修復するわね。材料が必要だから、あなたの手を借りるわ。^0000ff猫幽霊の扇子 1個、古びたフライパン 1個、炎の石 1個、イカ墨 1個^000000が必要なの。"
		},
		Summary = "猫幽霊の扇子 1個、古びたフライパン 1個、炎の石 1個、イカ墨 1個を持ってくる"
	},
	[8204] = {
		Title = "リョーセン",
		IconName = "ico_ep.bmp",
		Description = {
			"製本が緩んでいたから、並べ直して製本し直したわ。遅くならないうちに、この書類を届けてちょうだい。"
		},
		Summary = ""
	},
	[8205] = {
		Title = "連合研究の職員に報告する",
		IconName = "ico_ep.bmp",
		Description = {
			"連合研究の職員に少し待ってもらえるか聞いてくれない？会議用のもう一つの書類を探さなきゃいけないの。"
