			"レッケンベル社の<NAVI>[秘書]<INFO>lhz_in01,286,226,0,101,0</INFO></NAVI>は会話を早く終わらせようとしているようだ。今回は別のことを聞いてみよう。"
		},
		Summary = "少し違う質問"
	},
	[17270] = {
		Title = "企業",
		IconName = "ico_nq.bmp",
		Description = {
			"レッケンベルの<NAVI>[秘書]<INFO>lhz_in01,286,226,0,101,0</INFO></NAVI>は研究所について詳しく話したがらない。今回はボルセフについて聞いてみよう。"
		},
		Summary = "重要な質問"
	},
	[17271] = {
		Title = "企業",
		IconName = "ico_nq.bmp",
		Description = {
