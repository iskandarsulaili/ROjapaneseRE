		},
		Summary = ""
	},
	[8211] = {
		Title = "シュランクの講義",
		Description = {
			"バッシュの使い方を学んできましたか？バッシュスキルこそが剣術の真髄だと、私は固く信じています！"
		},
		Summary = "バッシュを習得してシュランクのもとへ戻る"
	},
	[8212] = {
		Title = "シュランクの講義",
		Description = {
			"バッシュについて少しは理解できたようですね。ですが、まだまだ足りません。"
		},
		Summary = "バッシュを習得してシュランクのもとへ戻る"
	},
	[8213] = {
		Title = "シュランクの講義",
		Description = {
			"バッシュの熟練度が上がったようですね。ですが、まだ足りません。"
		},
		Summary = "バッシュを習得してシュランクのもとへ戻る"
	},
	[8214] = {
		Title = "シュランクの講義",
		Description = {
			"そのタコ…！あのような手を持つ者は、バッシュを極めた者だけです。見事です、ソードマン。大いに感心しました。"
		},
		Summary = "シュランクの講義を聞く"
	},
	[8215] = {
		Title = "シュランクの講義",
		Description = {
			"さて、HP回復力向上スキルについては十分ご存知でしょう。次回は、プロボックスキルについてお教えしましょう。"
		},
		Summary = "シュランクの講義を聞く"
	},
	[8216] = {
		Title = "シュランクの命令",
		Description = {
			"^5D478Bゲフェン^000000にいる^5D478Bデクイ^000000という騎士を探してほしい。よく聞け、これが伝言だ：^0000FF例の殺人犯はどうなった？^0000FF犯人が誰か分かったか？もし分かったなら、我々はどうすべきだ？^000000"
		},
		Summary = "シュランクの伝言をゲフェンのデクイに届ける"
	},
	[8217] = {
		Title = "デクイの伝言",
		Description = {
			"シュランクが「例の殺人犯はどうなった？犯人が誰か分かったか？もし分かったなら、我々はどうすべきだ？」と聞いてきたな。犯人が誰かはまだ確定していない。だが、容疑者のリストはある。まもなく特定できるだろう。"
		},
		Summary = "デクイの伝言をイズルードのシュランクに届ける"
	},
	[8218] = {
		Title = "シュランクの講義",
		Description = {
			"プロボックをまだ習得していないのか？では次に、プロボックの使い方を修行してもらおう。"
		},
		Summary = "プロボックを習得してシュランクのもとへ戻る"
	},
	[8219] = {
		Title = "シュランクの講義",
		Description = {
			"む。プロボックについて基本的な理解はあるようだな。だが、そのスキルの使い方をより深く理解できるよう、いくつか詳細を教えておこう。"
		},
		Summary = "プロボックを習得してシュランクのもとへ戻る"
	},
	[8220] = {
		Title = "シュランクの講義",
		Description = {
			"ほう、プロボックについてかなり理解が進んでいるようだな。次に話す時は、^5D478Bインデュア^000000について知っていることを教えよう。学ぶ準備ができたら、また来なさい。"
		},
		Summary = "シュランクの講義を聞く"
	},
	[8221] = {
		Title = "シュランクの講義",
		Description = {
			"インデュアを発動すれば、敵の攻撃を受け流すことができる。ダメージは受けるが、敵の攻撃による行動の阻害が軽減される。つまり、反撃することも、必要なら逃げることもできるということだ。よし。次はインデュアの使い方を修行してもらおう。立派なソードマンになれるぞ。"
		},
		Summary = "インデュアを習得してシュランクのもとへ戻る"
	},
	[8222] = {
		Title = "シュランクの命令",
		Description = {
			"ああ、またしてもお前にやってもらいたいことがある。ゲフェンのデクイを訪ねてくれ。何か頼み事があるようだ。急いでデクイに会い、彼の依頼を完了させたら私のもとへ戻ってこい。"
		},
		Summary = "デクイのもとへ向かう"
	},
	[8223] = {
		Title = "デクイの命令",
		Description = {
			"さて、モロクへ行って4人の容疑者を尋問してこい。名前は^5D478Bムエトロ^000000、^5D478Bガイル^000000、^5D478Bハンス^000000、そして^5D478Bバンクレー^000000だ。難しくないはずだ。全員と話したら、戻って報告しろ。"
		},
		Summary = "モロクで証拠を見つけ、デクイのもとへ戻る"
	},
	[8224] = {
		Title = "手がかり",
		Description = {
			"TheisWesomeof...、よし、いいだろう。あとはこれが何を意味するか解読するだけだ。これは非常に難しい。解読しなければならない、我々が持っている唯一の手がかりなのだから…。"
		},
		Summary = ""
	},
	[8225] = {
		Title = "デクイの推論",
		Description = {
			"よし！バンクレーが犯人のようだな！100%信じることはできないが、この証拠はかなり決定的だ。急いでモロクへ行き、バンクレーを監視しろ。彼が何か極端な行動に出るかもしれない。何かあったら、すぐに報告しろ！"
		},
		Summary = "モロクでバンクレーを監視する"
	},
	[8226] = {
		Title = "バンクレーの死",
		Description = {
			"-彼は死んでいる！バンクレーの顔には悲しく哀れな表情が浮かんでいた。頬の色がまだ鮮やかなことから、つい先ほど死んだばかりのようだ。胸に長く深い傷があり、右手には血に濡れたナイフが握りしめられている。-"
		},
		Summary = "バンクレーの死をデクイに報告する"
	},
	[8227] = {
		Title = "シュランクのもとへ戻る",
		Description = {
			"自殺…？何か裏があるな！残りの3人の容疑者については、ソードマン協会の者に監視させる。とりあえずこの事件は一段落したようだ。再び、協力に感謝する。シュランクに報告して戻ってはどうだ？彼はまだ剣術の極意を教えたいようだからな。"
		},
		Summary = "シュランクのもとへ戻る"
	},
	[8228] = {
		Title = "シュランクの講義",
		Description = {
			"これが私からあなたへの最後の講義となる。マグナムブレイクについて全てお話しするから、よく聞いてください。"
		},
		Summary = "シュランクの講義を聞く"
	},
	[8229] = {
		Title = "グアルニエンの講義",
		Description = {
			"売るための商品を運ぶこともできないなら、マーチャントとは呼べません。所持量増加スキルをLv4まで習得しなさい。それができたら、真のマーチャントになるための話を続けましょう。"
		},
		Summary = "所持量増加を習得してグアルニエンのもとへ戻る"
	},
	[8230] = {
		Title = "グアルニエンの講義",
		Description = {
			"マモナイトスキルについてお話ししましょう。アイテム鑑定のような基本スキルですがね。さて、ここらで骨の折れる講義から少し休憩させてください。"
		},
		Summary = "グアルニエンの講義を聞く"
	},
	[8231] = {
		Title = "グアルニエンの講義",
		Description = {
