		Summary = "浄化用の聖遺物を購入する"
	},
	[8692] = {
		Title = "浄化の聖遺物 (2)",
		IconName = "ico_ep.bmp",
		Description = {
			"浄化用の聖遺物を購入した。グレイウルフ村の<NAVI>[水桶]<INFO>wolfvill,104,234,0,101,0</INFO></NAVI>に持っていけば、綺麗な水が手に入るだろう。"
