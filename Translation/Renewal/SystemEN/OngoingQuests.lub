	[18143] = {
		Title = "安全な作業のために",
		IconName = "ico_dq.bmp",
		Description = {
			"蛇の巣で氷の採取を担当している<NAVI>[ハナデル・サラガンド]<INFO>jor_nest,257,26,0,101,0</INFO></NAVI>は、外部の生物が脅かして氷の採取が困難だと言っている。氷河に浮かぶリマキナとカルマリングを倒そう。"
