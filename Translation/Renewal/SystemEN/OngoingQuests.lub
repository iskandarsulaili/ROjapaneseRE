	[18137] = {
		Title = "[待機] 迷子の捜索",
		IconName = "ico_dq.bmp",
		Description = {
			"イズガルドで誘拐された大陸の人々の捜索は一時中断し、後で続けることにした。約束の時間が過ぎたら、<NAVI>[ミリアム]<INFO>icas_in,48,252,0,101,0</INFO></NAVI>の元へ行き、捜索する地域を分けよう。"
