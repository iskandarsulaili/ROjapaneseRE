		IconName = "ico_ev.bmp",
		Description = {
			"パヨンの<NAVI>[ナイト]<INFO>payon,230,111,0,101,0</INFO></NAVI>は、休日料理体験フェスティバルで魚の下ごしらえを担当している。社長は白身魚より青魚が好きだそうで、青魚が必要だと言っている。それでも美味しい。必要なのは<ITEM>[魚の尾]<INFO>1023</INFO></ITEM> 3個と<ITEM>[食用油]<INFO>7457</INFO></ITEM> 2個だけだ。"
		},
		Summary = "アイテムの調達"
	},
	[8925] = {
		Title = "帰省しない記念の帽子",
		IconName = "ico_ev.bmp",
		Description = {
			"3つの料理作り体験をすべて完了したら、イベント本部へ！ <NAVI>[ラナイ]<INFO>payon,217,109,0,101,0</INFO></NAVI>から特別な記念品を受け取ろう！ ただし、これは自分で<ITEM>[手作りソンピョン]<INFO>103463</INFO></ITEM>を持ってきた人限定……。"
		},
		Summary = "手作りソンピョンをラナイに持っていく"
	},
	[8926] = {
		Title = "ゴマの葉のホットケーキ作り",
