		Summary = "待機後、衛兵に案内してもらう"
	},
	[7417] = {
		Title = "カルドゥイの依頼",
		IconName = "ico_ep.bmp",
		Description = {
			"<NAVI>[村長ジュン]<INFO>ecl_in03,41,90,0,101,0</INFO></NAVI>は私の真摯な話に耳を貸さず、むしろエクルラージュにもっと貢献するなら話を聞くと言った。エクルラージュで助けを必要としているラピネスたちの面倒を見よう。"
		},
		Summary = "エクルラージュのために働く"
	},
	[7418] = {
		Title = "エクルラージュのために 1",
		IconName = "ico_ep.bmp",
		Description = {
			"忙しすぎる<NAVI>[エクルラージュ衛兵]<INFO>ecl_in01,82,70,0,101,0</INFO></NAVI>のために、ヤイを飾るための材料を集めてほしい。ヒルズライオンの角、ミスティックの角、馬の蹄、それぞれ5個ずつあれば十分だろう。"
		},
		Summary = "ヒルズライオンの角5個、ミスティックの角5個、馬の蹄5個"
	},
	[7419] = {
		Title = "エクルラージュのために 2",
		IconName = "ico_ep.bmp",
		Description = {
			"通信が途絶えてビフレストの端で困っている伝令<NAVI>[ロイ]<INFO>ecl_fild01,205,86,0,101,0</INFO></NAVI>のために、スペンディードの<NAVI>[連絡将校]<INFO>splendide,267,368,0,101,0</INFO></NAVI>からの手紙を届けることにした。"
		},
		Summary = "スペンディードの連絡将校と郵便箱"
	},
	[7420] = {
		Title = "エクルラージュのために 3",
		IconName = "ico_ep.bmp",
		Description = {
			"甘いものが好きな<NAVI>[レオ]<INFO>eclage,112,40,0,101,0</INFO></NAVI>のために、スペンディード製のピンギキュラの果実漬けとルシオラの蜂蜜ジャムを手に入れてあげよう。果実漬けと蜂蜜ジャムは前線基地でコインを使って手に入れることができる。"
