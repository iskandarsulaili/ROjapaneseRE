		Summary = "ヴィンセンテに話しかける"
	},
	[7178] = {
		Title = "鍵の行方",
		IconName = "ico_jq.bmp",
		Description = {
			"欺瞞、幻影、快楽の3つの鍵は、タナトスタワーの隠された石像のためのものだ。<NAVI>[光の柱]<INFO>tha_t01,149,228,0,101,0</INFO></NAVI>が出現するタナトスタワー1階へ行こう。"
