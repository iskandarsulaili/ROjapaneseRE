	[11809] = {
		Title = "浄化の聖人",
		IconName = "ico_ep.bmp",
		Description = {
			"再びイスガルドに到着した。フリーデリケと共に<NAVI>[氷の城]<INFO>icecastle,23,123,0,101,0</INFO></NAVI>へ向かおう。"
