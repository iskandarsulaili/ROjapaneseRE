	[11860] = {
		Title = "厄除けの肖像画",
		IconName = "ico_ev.bmp",
		Description = {
			"マラン島タコ祭りの主催者が2022年のマスコットである<NAVI>[チュルホ]<INFO>malangdo,164,139,0,101,0</INFO></NAVI>を紹介してくれた。"
