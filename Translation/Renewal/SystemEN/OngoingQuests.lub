	[11078] = {
		Title = "毒王",
		Description = {
			"宋之毒がこの致命的な毒瓶を作り、洛陽の領主への復讐を企てていることをナガッシュ・アルセスに伝えた。"
		},
		Summary = "彼には一人になるための時間が必要なようだ。"
	},
	[11079] = {
		Title = "毒王",
		Description = {
