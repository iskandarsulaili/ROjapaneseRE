	[7443] = {
		Title = "研究を妨害せよ！",
		IconName = "ico_ep.bmp",
		Description = {
			"カルドゥイとヒジエはアヴァンが何を研究しているのかを知り、それを妨害したいと考えている。これは兄弟のささやかな復讐だろうか？アヴァンの<NAVI>[Yai]<INFO>eclage,304,234,0,101,0</INFO></NAVI>を見つけて研究を妨害しよう！"
