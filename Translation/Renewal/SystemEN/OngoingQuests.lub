		Summary = ""
	},
	[3050] = {
		Title = "サタン モロクの復活 - モロクからの知らせ",
		Description = {
			"砂漠の街モロクに封印されていたサタン モロクが復活し、周辺地域を破壊してソグラト砂漠へ移動しました。名誉ある冒険者の方々、モロク村の大陸警備隊のチーフ・バルログを探してください。"
		},
		Summary = "チーフ・バルログ"
	},
	[3051] = {
		Title = "サタン モロクの復活 - 資格試験",
		Description = {
			"モロクの討伐部隊である大陸警備隊に所属する冒険者は、誰でもなれるわけではありません。それほど自信があるなら、私にあなたの実力を証明してください。燃えさかる炭30個を手に入れて、私に持ってきてください。"
		},
		Summary = "燃えさかる炭30個"
	},
	[3052] = {
		Title = "サタン モロクの復活 - 資格試験2",
		Description = {
			"大陸警備隊の一員になるのがこんなに簡単だと思いましたか？試験はまだ終わっていません。氷の洞窟から氷の心臓50個を手に入れて、私に持ってきてください。"
		},
		Summary = "氷の心臓50個"
	},
	[3053] = {
		Title = "サタン モロクの復活 - 討伐隊の隊員",
		Description = {
			"あなたの実力と努力を認め、大陸警備隊に所属する冒険者として認定します。あなたの任務は、サタン モロクとその配下を倒し、完全な復活を阻止することです。命を懸ける覚悟を決めてください。"
		},
		Summary = ""
	},
	[3054] = {
		Title = "サタン モロクの復活 - 魔王を討て！",
		Description = {
			"サタン モロクとの血戦の末、彼をミッドガルド大陸から撤退させることに成功しました。彼が逃げ込んだ時空の亀裂に、サタン モロクの痕跡が見られます。"
		},
		Summary = ""
	},
	[3055] = {
		Title = "サタン モロクの復活 - 時空の亀裂",
		Description = {
			"時空の亀裂でサタン モロクの皮膚の破片を発見しました。これがサタン モロクを倒した決定的な証拠となるでしょう。"
		},
		Summary = ""
	},
	[3056] = {
		Title = "サタン モロクの復活 - 報酬の刻",
		Description = {
			"本当に素晴らしい働きでした。あなたのおかげで、この大陸と王国は平和を取り戻しました。王国を代表して、感謝いたします。以下の3つの報酬から、受け取るものを選んでください。"
		},
		Summary = ""
	},
	[3060] = {
		Title = "ヴァインスの子供たち - 妹はどこ？",
		Description = {
			"カリンという名の子供が、ヴァインスのトール火山に行った際に妹を失くしてしまいました。妹のカーディを探すのを手伝ってあげてください。"
		},
		Summary = ""
	},
	[3061] = {
		Title = "ヴァインスの子供たち - 手枷を外す方法を探せ！",
		Description = {
			"カリンの妹は手枷で拘束されています。彼女を自由にする方法を見つけるため、ヴァインスの街に戻らなければなりません。"
		},
		Summary = ""
	},
	[3062] = {
		Title = "ヴァインスの子供たち - 鍵屋を探せ！",
		Description = {
			"カリンの妹は手枷で拘束されています。彼女を自由にする方法を見つけるため、ヴァインスの街に戻らなければなりません。"
		},
		Summary = ""
	},
	[3063] = {
		Title = "ヴァインスの子供たち - ロケンロックさん？",
		Description = {
			"ロケンロックという名の鍵の専門家を探してください。このロケンロック氏は市場の通りで酔っ払っているはずです。イエローポーションを1個持っていかなければなりません。"
		},
		Summary = ""
	},
	[3064] = {
		Title = "ヴァインスの子供たち - オーガニック・カメレプー石鹸",
		Description = {
			"ロケンロック氏は、鍵の型を取るためにカメレプー石鹸が必要だと言っています。市場の石鹸職人、アイボリーさんから石鹸を購入できます。"
		},
		Summary = ""
	},
	[3065] = {
		Title = "ヴァインスの子供たち - 石鹸の材料",
		Description = {
			"カメレプー石鹸は現在すべて売り切れています。しかし、材料を持っていけば石鹸を作ってくれるそうです。"
		},
		Summary = "ミルク10個、緑ハーブ100個、ゼロピー50個、空き瓶5個"
	},
	[3066] = {
		Title = "ヴァインスの子供たち - カメレプー石鹸を作るには…",
		Description = {
			"材料を持って、ラクダ牧場のオーナーであるサラマンさんのところへ行きましょう。彼が材料の使い方を教えてくれるはずです。さあ、行きましょう！"
		},
		Summary = ""
	},
	[3067] = {
		Title = "ヴァインスの子供たち - ラクダの食欲促進剤",
		Description = {
			"ラクダの糞の塊を手に入れるには、まずラクダに食欲を刺激する餌を与える必要があります。食欲促進剤を手に入れましょう！"
		},
		Summary = "モンスターの餌5個、未熟なリンゴ1個、イエローポーション1個、空き瓶1個"
	},
	[3068] = {
		Title = "ヴァインスの子供たち - ラクダの糞を手に入れろ",
		Description = {
			"食欲促進剤を集めることに成功しました。集めたものをラクダに与えて、ラクダの糞の塊を5個手に入れましょう。"
		},
		Summary = ""
	},
	[3069] = {
		Title = "ヴァインスの子供たち - シルクサンドラクダはどこ？",
		Description = {
			"変だ…ラクダが促進剤に反応しません。サラマンさんのところに戻って、何が起きているのか確かめましょう。"
		},
		Summary = ""
	},
	[3070] = {
		Title = "ヴァインスの子供たち - シルクサンドラクダが逃げた！",
		Description = {
			"シルクサンドラクダが牧場から逃げ出して消えてしまいました。サラマンさんのためにシルクサンドラクダを見つけて、ラクダの糞の塊を5個手に入れましょう。ラクダはそれほど遠くへは行っていないはずです。"
