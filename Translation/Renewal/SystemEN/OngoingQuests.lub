	},
	[8691] = {
		Title = "浄化の聖遺物 (1)",
		IconName = "ico_ep.bmp",
		Description = {
			"グレイウルフ村のブダンが、飲料水用の浄化の聖水をラヘルで買ってきてほしいと頼んできた。新鮮な何かが必要なようだ。<NAVI>[聖遺物販売員]<INFO>rachel,103,141,0,101,0</INFO></NAVI>を探そう。"
