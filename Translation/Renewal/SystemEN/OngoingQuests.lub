		Summary = ""
	},
	[3071] = {
		Title = "ヴァインスの子供たち - シルクサンドラクダを発見！",
		Description = {
			"ついにシルクサンドラクダを見つけました。ラクダの糞の塊を5個手に入れましょう。糞の塊1つにつき、いくつかの材料が必要になります。"
