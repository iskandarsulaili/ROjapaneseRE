	},
	[2257] = {
		Title = "8周年記念",
		Description = {
			"ゼラは話す前に調査能力を示すよう求めてきた。彼女の後ろにある本を読み、手がかりを組み合わせて彼女の謎かけを解こう。"
		},
		Summary = "「メッツさんの子供の頃のそりの名前は何だった？」 -ゼラ"
	},
	[2258] = {
		Title = "8周年記念",
		Description = {
