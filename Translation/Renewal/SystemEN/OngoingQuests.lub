	[8020] = {
		Title = "工場の点検",
		Description = {
			"自動圧力調整器を見つけ、慎重に確認したところ、奇妙なきしむ音がしており、表面のネジのいくつかが緩んでいることが分かった。調査結果をゼルメトに報告しよう。"
