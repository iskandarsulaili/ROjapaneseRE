		Summary = "学生と会話する"
	},
	[21202] = {
		Title = "先の道を塞ぐ者たち",
		IconName = "ico_dq.bmp",
		Description = {
			"砂漠の片隅で見つけた老学者の弟子は、サンドマンのせいでこれ以上進めないと言い、サンドマンを倒して^0000FF砂の破片 5個^000000を集めてほしいと頼んできた。"
		},
		Summary = "砂の破片 5個"
	},
	[21203] = {
		Title = "ミーアのような、ミーアでない、ミーアのような",
		IconName = "ico_dq.bmp",
		Description = {
			"少年の行動が気になり、砂漠の遺憾な思いやアサシンギルドについて放っておけなくなった。気になるなら、一度戻ってみよう。"
		},
		Summary = "04:00にリセット",
		CoolTimeQuest = 1
	},
	[21204] = {
		Title = "腰が痛いので何かください。",
		Description = {
			"モロクの外、ピラミッド前のオアシスにいる老学者が、ピラミッド地下でベリットに奪われた^0000FFフィールドシャベル^000000を取り戻してほしいと依頼してきた。"
		},
		Summary = "フィールドシャベル 1個"
	},
	[21205] = {
		Title = "ファイアウィンドカイトの討伐",
		IconName = "ico_dq.bmp",
		Description = {
			"盗賊ギルドに住むルミンの依頼だ。ギルドの地下に生息するベリットとミノタウロスのせいでギルド員が困っている。ベリットとミノタウロスを退治しよう。"
		},
		Summary = ""
	},
	[21206] = {
		Title = "一日中寝てばかりいないよね？",
		IconName = "ico_dq.bmp",
		Description = {
			"機会があれば、毎日ピラミッドの地下を掃除してほしいというルミンの依頼だ。その気があれば、また戻ってみよう。"
		},
		Summary = "04:00にリセット",
		CoolTimeQuest = 1
	},
	[21207] = {
		Title = "迷宮の向こうの友人の行方",
		Description = {
			"エルニストが、一緒に課題をやりに来た友人とはぐれてしまったと言い、ピラミッドに入った友人を探して安否を確認してほしいと頼んできた。ピラミッドをゆっくり上ってみよう。"
		},
		Summary = "学長マクシムと会話する"
	},
	[21208] = {
		Title = "古い青い箱と良い夢",
		Description = {
			"エルネストの友人たちは、死者の遺品が古い青い箱だと信じている。ミイラを倒して手に入れ、もう一度確かめてみよう……"
		},
		Summary = "死者の遺品 1個"
	},
	[21209] = {
		Title = "迷宮の向こうの友人の行方-2",
