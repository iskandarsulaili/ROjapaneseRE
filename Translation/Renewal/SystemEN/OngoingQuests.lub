	[7448] = {
		Title = "何かがおかしい",
		IconName = "ico_ep.bmp",
		Description = {
			"カルドゥイとヒジエで話し合った結果、やはり<NAVI>[参謀]<INFO>ecl_in03,245,93,0,101,0</INFO></NAVI>が最も怪しいという結論に至った。彼がカルドゥイのオーブに対する行動に抵抗する理由とは何なのだろうか？"
