		Summary = "カチに手紙を届ける"
	},
	[8037] = {
		Title = "サイコロの勝負師",
		Description = {
			"ハレンの手紙をカチに届けた。彼女が何を知っているのか確認したほうがよさそうだ……"
		},
		Summary = ""
	},
	[8038] = {
		Title = "サイコロの勝負師",
		Description = {
			"カチはハレンのいとこだった。質問に答えた後、彼女はゲームに戻っていった。他に誰が彼らの過去を知っているだろうか？"
		},
		Summary = ""
	},
	[8039] = {
		Title = "飛行船の秘密",
		Description = {
			"ハレンは、飛行船の仕組みについてもっと学ぶのが自分のプロジェクトだと言っている。飛行船に詳しい人に自分で尋ね、調査結果をハレンに報告すると良いだろう。"
		},
		Summary = ""
	},
	[8040] = {
		Title = "飛行船の秘密",
		Description = {
			"「本当か……？ それは本当か？ イミルの心臓の欠片の模造品だと。どこでそんな話を聞いたことがあったかな？ むー、思い出させてくれ……」"
		},
		Summary = "ハレンに話し続ける"
	},
	[8041] = {
		Title = "飛行船の秘密",
		Description = {
			"カチが、サイコロゲームでリンゴを賭けて遊ぶといつもイミルの心臓について口にする酔っ払いのことを教えてくれた！"
		},
		Summary = ""
	},
	[8042] = {
		Title = "飛行船の秘密",
		Description = {
			"アインブロックの研究所の所長がイミルの心臓の欠片を持っていることが分かった。調査する価値がある……"
		},
		Summary = ""
	},
	[8043] = {
		Title = "飛行船の秘密",
		Description = {
			"ここから離れたほうがいい。衛兵が定期的に巡回しているので、ほぼ確実に見つかってしまうだろう。うーん、後で飛行船のところに会いに来てくれ、いいか？ さあ、急げ！"
		},
		Summary = "フェルロックに会いに行かなければならない"
	},
	[8044] = {
		Title = "ユスランの婚約者",
		Description = {
			"「……本当にティエリを探しに行ってくれるのか？ ああ、本当にありがとう！",
			"あなたの親切な申し出がどれほど私にとって意味があるか分からないでしょう。",
			"ティエリは、医者が私の病気に必要だと言った薬を見つけるために、飛行船に乗って旅に出たの。」"
		},
		Summary = ""
	},
	[8045] = {
		Title = "カチからの助言",
		Description = {
			"「ああ、分かった！ 飛行船の船長に協力を頼んでみるわ。彼なら乗客名簿と行き先のリストを持っているはずだから。」"
		},
		Summary = "船長から乗客名簿を確認する"
	},
	[8046] = {
		Title = "フェルロックの乗客名簿",
		Description = {
			"それによると、彼が最後に乗ったのはヒューゲル行きの飛行船だということ以外は、何も書かれていない。"
		},
		Summary = ""
	},
	[8047] = {
		Title = "ユスランの願い",
		Description = {
			"「機会があれば、ヒューゲルにいる兄のユクランを訪ねて、私のティエリがどこにいるか聞いていただけないか。」"
		},
		Summary = ""
	},
	[8048] = {
		Title = "ユクランの証言",
		Description = {
			"「ああ、ティエリは1ヶ月ほど前にここを通って、オーディン神殿に行かなければならないと言っていました。その時はよく分かりませんでしたが、今思えば、彼は私の姉を助けようとしていたのでしょう。」"
		},
		Summary = ""
	},
	[8049] = {
		Title = "ティエリの願い",
		Description = {
			"「詳しいことは話せませんが、私はユスランの病気の治療法を見つけるためにこの仕事をしています。現代の医学では治せない病気なんです……」"
		},
		Summary = ""
	},
	[8050] = {
		Title = "ティエリに迫る危機",
		Description = {
			"「ティエリは我々の真の目的に気づいたようだ。だから研究の進行を遅らせているのだろう。手遅れになる前に彼を始末した方がよさそうだ。」"
		},
		Summary = ""
	},
	[8051] = {
		Title = "ユスランの薬",
		Description = {
			"「私がどうなっても構いませんが、ユスランだけは救わなければならないのです。薬を完成させるには、あと闇のルーンが5個必要です。どうか助けてください、冒険者さん……」"
		},
		Summary = "闇のルーンを5個集める"
	},
	[8052] = {
		Title = "ティエリの願い",
		Description = {
			"「彼女に一刻も早く会いたいのは山々ですが、レケンベルの捜索員が私を探している間は待つしかありません。どうかその薬をできるだけ早くユスランに届けてください。彼女の命がかかっているのです。」"
		},
		Summary = "薬をユスランに届ける"
	},
	[8053] = {
		Title = "ポステルを探す",
		Description = {
			"「アレンの息子のポステルを探して、薬を持ってくるように伝えてくれ！東へ向かい、街の外に出ればポステルが見つかるはずだ。」"
		},
		Summary = ""
	},
	[8054] = {
		Title = "ポステルからの伝言",
		Description = {
			"ポステルは、父親がこれ以上問題を起こさないように見守ってほしいと頼んできた。"
		},
		Summary = "アレンの元へ戻る"
	},
	[8055] = {
		Title = "アレンの看病",
		Description = {
			"「ポ、ポステルが薬を持ってくる前にまた潰瘍の発作が起きたらどうしよう！？生きていけるか分からないぞ！あ、冒険者さん、息子が来るまでそばにいてくれないか？」"
		},
		Summary = "アレンの看病をする"
	},
	[8056] = {
		Title = "ささやかなお礼",
		Description = {
			"「薬の引き出しの中を見て、好きなものを自由に持っていってくれ」～アレン"
		},
		Summary = "薬の引き出しの中を見る"
	},
	[8057] = {
		Title = "不満げなマナンヌ",
		Description = {
			"マナンヌに慰めの木について話す"
		},
		Summary = ""
	},
	[8058] = {
		Title = "エルシャットに話す",
		Description = {
			"「この木はこの街の皆にとって特別な思い出があり、とても大切なものなの。でもエルシャットって人は、自分の店のためにその木を切り倒そうとしているの……」～マナンヌ"
		},
		Summary = ""
	},
	[8059] = {
		Title = "ペルフィッツに話す",
		Description = {
			"エルシャットは、父親が昔からここに店を建てたがっていると言っている。父親のペルフィッツに話を聞いて、彼の考えを確認しよう。"
		},
		Summary = ""
	},
	[8060] = {
		Title = "頑固なエルシャット",
		Description = {
			"「嬉しくはあるが、何かがおかしい気がするんだ。あいつ、木を切ることに興奮しすぎている。この老人の疑い深さかもしれないがね……」～ペルフィッツ"
		},
		Summary = ""
	},
	[8061] = {
		Title = "過去の物語",
		Description = {
			"エルシャットは、かつては命を懸けてでもその木を守ろうとした時期があったが、それは過去に埋葬すべきだと言う。彼の過去を知る誰かを見つけるべきだ。"
		},
		Summary = ""
	},
	[8062] = {
		Title = "カナンヌ",
		Description = {
			"「今のエルシャットは冷酷な金の亡者よ……！あの人は完全に変わってしまった。姉さんが生きていたら、今の彼を見て棺桶の中で寝返るでしょうね……」～マナンヌ"
		},
		Summary = ""
	},
	[8063] = {
		Title = "カナンヌの魂",
		Description = {
