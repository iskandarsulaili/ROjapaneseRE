		Summary = "ルーキーに話しかける"
	},
	[18015] = {
		Title = "イリュージョントラッカー",
		IconName = "ico_ep.bmp",
		Description = {
			"エルミナがイリュージョンを追跡できるトラッカーを作ってくれることになった。トラッカーの作成に必要な素材は、<ITEM>[蛍光液体]<INFO>7326</INFO></ITEM> 10個と<ITEM>[壊れた剣]<INFO>7110</INFO></ITEM> 10個だ。"
		},
		Summary = "蛍光液体と壊れた剣をエルミナに届ける"
	},
	[18016] = {
		Title = "作戦会議",
		IconName = "ico_ep.bmp",
		Description = {
			"エストと共に、隠れたハートハンターとイリュージョンを見つけるため、ヴァルムントの屋敷を捜索する作戦を練ろう。"
		},
		Summary = "エストに話しかける"
	},
	[18017] = {
		Title = "害虫駆除作戦",
		IconName = "ico_ep.bmp",
		Description = {
