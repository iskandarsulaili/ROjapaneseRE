	[7177] = {
		Title = "リヒタルゼンの工房",
		IconName = "ico_jq.bmp",
		Description = {
			"ハレドは、自分の手がかりが財宝の隠し場所を示さなかったことに動揺し、最後の手がかりを持つリヒタルゼン支部の管理者である<NAVI>[ヴィンセンテ]<INFO>s_atelier,24,71,0,101,0</INFO></NAVI>の元へ行くよう告げた。"
