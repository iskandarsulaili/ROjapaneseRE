		Summary = "04:00にリセット",
		CoolTimeQuest = 1
	},
	[18030] = {
		Title = "ゲオボーグ家の呪い",
		Description = {
			"ああ、本当にありがとう！私が飛行船をどれほど恐れているか想像もつかないでしょう。さて、ジュノーの図書館の近くにいる^ff0000カーロモフ氏^000000にこの本を届けてくれませんか？"
		},
		Summary = "04:00にリセット",
		CoolTimeQuest = 1
	},
	[18031] = {
		Title = "ゲオボーグ家の呪い",
		Description = {
			"この報告書を彼女にすぐ届けてくれれば大変助かります。ああ、彼女の名前はロダフリアンです。あの砂漠の町のどこかで彼女を見つけられるはずです。"
		},
		Summary = "ロダフリアン"
	},
	[18032] = {
		Title = "ゲオボーグ家の呪い",
		Description = {
			"ミョルニール山にいるモンドを探してください。偉大な蛇が海を飲み込んだ。虹の鷲が蛇を飲み込んだ。そして鷲は巣を作った。飲み込まれた海の上に。という物語をあなたの言葉で彼に伝えてください。"
		},
		Summary = "04:00にリセット",
		CoolTimeQuest = 1
	},
	[18033] = {
		Title = "ゲオボーグ家の呪い",
		Description = {
			"ああ、もっと知りたいなら、その歌を歌っていた子供を探してみるといいでしょう。うーん、彼は^3131ddこの近くの川^000000のあたりにいるかもしれません。そう難しくなく見つけられるでしょう。"
		},
		Summary = "ぼんやりした少年"
	},
	[18034] = {
		Title = "ゲオボーグ家の呪い",
		Description = {
