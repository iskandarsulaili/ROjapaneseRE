		Summary = "04:00にリセット",
		CoolTimeQuest = 1
	},
	[21309] = {
		Title = "跳ねる鉱物",
		Description = {
			"アインベチ鉱山の2階でミネラルとオブシディアンが暴れまわって、鉱夫たちが困っているという。ミネラルとオブシディアンを対処しよう。"
		},
		Summary = "鉱物と黒曜石の駆除"
