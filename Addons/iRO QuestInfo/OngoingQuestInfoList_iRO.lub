		},
		Summary = "クラヌクス・ヘフロン"
	},
	[19102] = {
		Title = "ヘリオンの目",
		Description = {
			"チリアス・ティウス卿の依頼を断った。もう一度考え直したほうがいいかもしれない…"
		},
		Summary = ""
	},
	[19103] = {
		Title = "ヘリオンの目",
		Description = {
			"プロンテラ南東にある古い剣士訓練場を手がかりを求めて捜索しよう。"
		},
		Summary = ""
	},
	[19104] = {
		Title = "ヘリオンの目",
		Description = {
			"クラノックス・ヘフロンを怒らせてしまったかもしれない。任務を完了させるためにも、彼と関係を修復しようとするべきだ。"
		},
		Summary = ""
	},
	[19105] = {
		Title = "ヘリオンの目",
		Description = {
			"^0000FF「野菜のおばさん N9 W3 BINGO」^000000と書かれたメッセージを見つけた。"
		},
		Summary = ""
	},
	[19106] = {
		Title = "ヘリオンの目",
		Description = {
			"クラノックス・ヘフロンから歯車を受け取った。見つけたメッセージに^0000FF「野菜のおばさん N9 W3 BINGO」^000000と書かれていたことを思い出そう。"
		},
		Summary = ""
	},
	[19107] = {
		Title = "ヘリオンの目",
		Description = {
			"野菜のおばさんからあるパスワード^0000FF 3847147298^000000を受け取った。クランナクス・ヘフロンにそれを伝えよう。"
		},
		Summary = ""
	},
	[19108] = {
		Title = "ヘリオンの目",
		Description = {
			"野菜のおばさんから教えてもらったパスワードを、正体不明の機械に入力しよう。パスワードは^0000FF 3847147298^000000。"
		},
		Summary = ""
	},
	[19109] = {
		Title = "ヘリオンの目",
		Description = {
			"プロンテラの石板を受け取った。モロクのチリアス・ティウス卿のもとへ持ち帰ろう。"
		},
		Summary = ""
	},
	[19110] = {
		Title = "ヘリオンの目",
		Description = {
			"発見した詳細をすべてクランナクス・ヘフロンに話すのはやめた。調査結果をモロクのチリアス・ティウス卿に報告しよう。"
		},
		Summary = ""
	},
	[19111] = {
		Title = "ヘリオンの目",
		Description = {
			"チリアス・ティウスは、次の石板の欠片はパヨンにあると確信している。パヨンでグルーチ・トゥッコックを探そう。"
		},
		Summary = ""
	},
	[19112] = {
		Title = "ヘリオンの目",
		Description = {
			"グルーチから乙女のスカートを受け取り、見つけた場所がミニマップに記された。"
		},
		Summary = ""
	},
	[19113] = {
		Title = "ヘリオンの目",
		Description = {
			"櫓の天井に「この衣服はフリーサイズだ」と書かれているのを見つけた。このメッセージをグルーチに伝えよう。"
		},
		Summary = ""
	},
	[19114] = {
		Title = "ヘリオンの目",
		Description = {
			"「かつてここで穏やかな日々を祈っていた」と書かれた石の山を見つけた。このメッセージをグルーチに伝えよう。"
		},
		Summary = ""
	},
	[19115] = {
		Title = "ヘリオンの目",
		Description = {
			"「緑ハーブは魚の臭い消しにとても役立つ」というメッセージが添えられた干物を見つけた。このメッセージをグルーチに伝えよう。"
		},
		Summary = ""
	},
	[19116] = {
		Title = "ヘリオンの目",
		Description = {
			"「さてどちらにしようか？ワインかブドウジュースか？いや、私は断然ワインが好みだな」というメッセージが書かれた樽を見つけた。このメッセージをグルーチに伝えよう。"
		},
		Summary = ""
	},
	[19117] = {
		Title = "ヘリオンの目",
		Description = {
			"ティウスからのメッセージを見つけた。グルーチのもとへ戻り、木の床の下で見つけた内容を知らせよう。"
		},
		Summary = ""
	},
	[19118] = {
		Title = "ヘリオンの目",
		Description = {
			"木の床の下の石板に書かれていたことをグルーチに伝えた。彼は北のアーチャーの里にある巨大な石像を調べるようにと言った。"
		},
		Summary = ""
	},
	[19119] = {
		Title = "ヘリオンの目",
		Description = {
			"仏像からパヨンの石板を手に入れた。モロクのチリアス・ティウスのもとへ持ち帰ろう。"
		},
		Summary = ""
	},
	[19120] = {
		Title = "ヘリオンの目",
		Description = {
			"モロクの石板を受け取った。チリアス・ティウスはゲフェンへ行き、ウェルシューンという人物を探すようにと言った。"
		},
		Summary = ""
	},
	[19121] = {
		Title = "ヘリオンの目",
		Description = {
			"ウェルシューンから、ゲフェンタワーにいる弟子のエノズを探し、「ゲフェン周辺のモンスター生態」という報告書を持っているか確認してほしいと頼まれた。"
		},
		Summary = ""
	},
	[19122] = {
		Title = "ヘリオンの目",
		Description = {
			"暴言を吐いたのはあまり良い考えではなかったようだ。ウェルシューンと仲直りをしよう。"
		},
		Summary = ""
	},
	[19123] = {
		Title = "ヘリオンの目",
		Description = {
			"ウェルシューンが喉が渇いたと言っている。ポーションを持っていき、彼の渇きを癒してあげよう。"
		},
		Summary = ""
	},
	[19124] = {
		Title = "ヘリオンの目",
		Description = {
			"エノズがモンスター生態の本を失くしてしまったようだ。ウェルシューンのもとへ戻り、それを知らせよう。"
		},
		Summary = ""
	},
	[19125] = {
		Title = "ヘリオンの目",
		Description = {
			"本をゲフェンタワーのエノズに届け、戻る際にブルージェムストーンを1個持ち帰るようにとウェルシューンが言った。"
		},
		Summary = ""
	},
	[19126] = {
		Title = "ヘリオンの目",
		Description = {
