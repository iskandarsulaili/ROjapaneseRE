		Summary = "マーティンに話しかける"
	},
	[21305] = {
		Title = "シャドウマイナー",
		Description = {
			"アインブロックの鉱山で問題になっているピットマンの討伐を依頼された。アインベチ鉱山は村の中にある。炭鉱の1階に集中しよう。"
		},
		Summary = "ピットマンの駆除"
	},
	[21306] = {
		Title = "シャドウマイナー [待機]",
		Description = {
