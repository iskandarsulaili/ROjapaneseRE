	[18023] = {
		Title = "スパイのヴィトレ",
		Description = {
			"秘密警察がスパイ行為の罪でヴィトレを連行しました。ヴィトレに何が起こったかをラスダに知らせるため、彼の元へ戻るべきでしょう。"
