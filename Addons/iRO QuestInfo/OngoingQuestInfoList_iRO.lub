		Summary = "恐ろしいバーバ・ヤーガ"
	},
	[18075] = {
		Title = "人々の言葉を封じる",
		Description = {
			"3人の声を探して封じ込めなければならない。子供、若者、中年の3人だ。それぞれ異なる3人から「冬が来ないでほしい」という願いの言葉を封じ込める必要がある。"
		},
		Summary = ""
	},
	[18076] = {
		Title = "人々の言葉を封じる",
