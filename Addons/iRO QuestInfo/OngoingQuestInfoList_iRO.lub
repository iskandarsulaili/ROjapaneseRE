	[21900] = {
		Title = "こんにちは！",
		Description = {
			"イズルードには冒険者を支援する学院やギルドがある。イズルード北部のクリトゥラ学院の<NAVI>スプラキ<INFO>iz_ac01,102,44,0,101,0</INFO></NAVI>に会おう。。"
		},
		Summary = "スプラキに話しかける"
	},
	[21901] = {
		Title = "知っておくべきサービス",
		Description = {
			"スプラキは冒険するために知っておくべきことがあると言い、イズルード中心部にいる<NAVI>カプラ職員<INFO>izlude,128,148,0,101,0</INFO></NAVI>に会うよう頼みました。"
		},
		Summary = "カプラ職員に話しかける"
	},
	[21902] = {
		Title = "初めての依頼ですか？",
		Description = {
			"カプラ職員から<NAVI>モリス<INFO>izlude_in,69,116,0,101,0</INFO></NAVI>へ配達箱を届けるよう頼まれました。モリスはイズルードの道具屋にいます。"
		},
		Summary = "箱をモリスに届ける"
	},
	[21903] = {
		Title = "レノを見ていない人は？",
		Description = {
			"道具屋のモリスから、薬草を見に行った「赤髪の検察官レノ」の行方を探してほしいと頼まれました。「レノ」に関する情報を集めましょう。"
		},
		Summary = "ウルに話しかける"
	},
	[21904] = {
		Title = "薬草追跡者の行方",
		Description = {
			"修行に没頭するレノに代わって薬草畑を確認することにしました。実は、レノの代わりに彼に会いに行った友達がいるのですが……。"
		},
		Summary = "子供に話しかける"
	},
	[21905] = {
		Title = "????????",
		Description = {
			"ルナティックを倒して「クローバー」を手に入れる賭けをしました。一方的ですが……。「ルナティック」は近くにいるので、さっそく倒しましょう。"
		},
		Summary = "子供へのクローバーのお返し"
	},
	[21906] = {
		Title = "????????",
		Description = {
			"ルミンから、子供の近くに薬草があると教えてもらいました。集めた薬草と共に修行中の<NAVI>レノとウル<INFO>prt_fild08,320,230,0,101,0</INFO></NAVI>の元へ戻りましょう。"
		},
		Summary = "ウルに話しかける"
	},
	[21907] = {
		Title = "?????",
		Description = {
			"ウルから検察官のことを聞きました。手に入れた薬草を<NAVI>モリス<INFO>izlude_in, 69,116,0,101,0</INFO></NAVI>に届けましょう。"
		},
		Summary = "モリスに話しかける"
	},
	[21908] = {
		Title = "緊急の時のために",
		Description = {
			"道具屋のモリスから「コンビネーションキット」を受け取り、「クリトゥラ学院」の保健室にいる<NAVI>セラピスト<INFO>iz_ac01,60,43,0,101,0</INFO></NAVI>に会って使い方を教わろう。"
		},
		Summary = "治療師に話しかける"
	},
	[21909] = {
		Title = "ゼロピーでできること",
		Description = {
			"イズルードで出会った弓使いの<NAVI>マルブロン<INFO>izlude,115,103,0,101,0</INFO></NAVI>は、矢分裂のスキルに使う素材として「ゼロピー」を3個欲しがっています。「ゼロピー」は「ポリン」から入手できます。"
		},
		Summary = "ゼロピー3個をマルブロンに届ける"
	},
	[21910] = {
		Title = "プロンテラへ！",
		Description = {
			"立派な楽園の一員となり、「プロンテラ大聖堂」の難題を解決することになりました。<NAVI>仲間<INFO>prt_fild08,182,359,0,101,0</INFO></NAVI>に会い、合流しましょう。"
		},
		Summary = "レノに話しかける"
	},
	[21911] = {
		Title = "3枚のビラ",
		Description = {
			"プロンテラ北側の内壁にビラを貼ることにしました。大通りを上がると、「ブラン」の目印がついた壁が見えるかもしれません……。"
		},
		Summary = "ビラを貼る"
	},
	[21912] = {
		Title = "ビラの内容",
		Description = {
			"指定された場所にビラを貼った後、「ルミン」が気になることを言い残して消えました。2枚目のビラ貼り場所を探しましょう。"
		},
		Summary = "ビラを貼る"
	},
	[21913] = {
		Title = "再びプロンテラへ！",
		Description = {
			"ビラの件で「プロンテラ大聖堂」の延期問題を解決するため、プロンテラ大聖堂の<NAVI>ローム神父<INFO>prt_church,107,99,0,101,0</INFO></NAVI>に会うことにしました。"
		},
		Summary = "ローム神父に話しかける"
	},
	[21914] = {
		Title = "子供たちの安全のために",
		Description = {
			"プロンテラ大聖堂のローム神父から、「プロンテラ東部フィールド」のモンスターを整理してほしいと頼まれました。子供たちが安全に遊べるように「ルナティック」と「ファブル」を倒しましょう。"
		},
		Summary = "ルナティック、ファブルを倒す"
	},
	[21915] = {
		Title = "ちらばったベリーたち",
		Description = {
			"プロンテラ大聖堂のローム神父から、帰らない子供たちを探してほしいと頼まれました。プロンテラ中の「ラズベリー」「ブルーベリー」「クランベリー」を探しましょう。"
		},
		Summary = "子供を探してロームに話しかける"
	},
	[21916] = {
		Title = "ラズベリーを発見！",
		Description = {
			"製錬所の前でラズベリーを見つけました。<NAVI>ブルーベリー<INFO>prontera,78,104,0,101,0</INFO></NAVI>は執務室の近く、<NAVI>クランベリー<INFO>prontera,162,324,0,101,0</INFO></NAVI>は王宮の前にいるそうです。"
		},
		Summary = ""
	},
	[21917] = {
		Title = "ブルーベリーを発見！",
		Description = {
			"執務室の前でブルーベリーを見つけました。<NAVI>ラズベリー<INFO>prontera,170,183,0,101,0</INFO></NAVI>は製錬所の近く、<NAVI>クランベリー<INFO>prontera,162,324,0,101,0</INFO></NAVI>は王宮の前にいるそうです。"
		},
		Summary = ""
	},
	[21918] = {
		Title = "クランベリーを発見！",
		Description = {
			"王宮の前でクランベリーを見つけました。<NAVI>ブルーベリー<INFO>prontera,78,104,0,101,0</INFO></NAVI>は執務室の近く、<NAVI>ラズベリー<INFO>prontera,170,183,0,101,0</INFO></NAVI>は製錬所の近くにいるそうです。"
		},
		Summary = ""
	},
	[21919] = {
		Title = "女神の信者を探せ 1",
		Description = {
			"慈悲の騎士団から、怪しいビラの配布を主導した「ブラン」の捜索への協力を求められました。<NAVI>レノ<INFO>prt_fild05,335,225,0,101,0</INFO></NAVI>を探しましょう。"
		},
		Summary = "戦闘痕跡の調査"
	},
	[21920] = {
		Title = "女神の信者を探せ 2",
		Description = {
			"レノによると、怪しい動きの痕跡は南へと続いているそうです。すぐに追跡しましょう。"
		},
		Summary = "折れた茂みの調査"
	},
	[21921] = {
		Title = "女神の信者を探せ 3",
		Description = {
			"レノが見つけた手がかりによると、近くの「ロッカー」から逃げたそうです。「ロッカー」を確保しましょう。"
		},
		Summary = "ロッカーを討伐する"
	},
	[21922] = {
		Title = "女神の信徒を探せ 4",
		Description = {
			"レノが不審な動きの痕跡は東へ向かっていると言った。すぐに追いかけよう。"
		},
		Summary = "兵士たちに話しかける"
	},
	[21923] = {
		Title = "まずは、ここだ。",
		Description = {
			"さしあたり、イズルードクリトゥラ学院の<NAVI>スプラキ<INFO>iz_ac01,102,44,0,101,0</INFO></NAVI>に捜索の結果を報告することにした。"
		},
		Summary = "スプラキに話しかける"
	},
	[21924] = {
		Title = "修行の助言",
		Description = {
			"スプラキは「パヨン」でやるべきことがあるかもしれないと言い、「パヨン」へ行くことを勧めた。<NAVI>イズルード広場のカプラ職員<INFO>izlude,128,148,0,101,0</INFO></NAVI>を通じて「パヨン」へ行こう。"
		},
		Summary = "カプラ職員に話しかける"
	},
	[21925] = {
		Title = "冒険者ギルドからの呼び出し",
		Description = {
			"イズルードの「クリトゥラ学院」から至急の連絡を受けた。<NAVI>スプラキ<INFO>iz_ac01,102,44,0,101,0</INFO></NAVI>の元へ行こう。"
		},
		Summary = "スプラキに話しかける"
	},
	[21926] = {
		Title = "女神の信徒を追跡せよ",
		Description = {
			"騎士メリックが「アルベルタ」の「ブラン」について情報を得たという。「ブラン」の居場所を確認するため、アルベルタの<NAVI>ピーターワナ<INFO>alberta,175,138,0,101,0</INFO></NAVI>から情報を確認しよう。"
		},
		Summary = "ピーターワナに話しかける"
	},
	[21927] = {
		Title = "不審な難破船",
		Description = {
			"ピーターワナが「ブラン」は船を借りて難破船に向かったと言った。船に入る前に難破船の周辺を調査しよう。"
		},
		Summary = "難破船の島へ"
	},
	[21928] = {
		Title = "ポリン村",
		Description = {
			"プロンテラ周辺で広まっている「ポリン村」の噂の真偽を、楽園からの依頼で確認する必要がある。「プロンテラ西側」で情報を集めよう。"
		},
		Summary = ""
	},
	[21929] = {
		Title = "難破船の島へ",
		Description = {
			"「ブラン」は難破船の島に隠れているようだ。アルベルタの港近くの船員を通じて難破船へ移動し、調査しよう。"
		},
		Summary = "不審な難破船の調査"
	},
	[21930] = {
		Title = "再び咲く花の指輪",
		Description = {
			"メリック騎士から渡された「強化の花の指輪」は祝福を受けることができる。プロンテラ大聖堂を訪れ、<NAVI>ロアム聖職者<INFO>prt_church,107,99,0,101,0</INFO></NAVI>に指輪を渡そう。"
		},
		Summary = "ロアム聖職者に話しかける"
	},
	[21931] = {
		Title = "西側にビラを貼ろう。",
		Description = {
			"北側の内壁の東にビラが貼られていた。なぜ「ルミネ」は女神フレイヤについて話したのだろうか？プロンテラ北側の内壁の<NAVI>[西側]<INFO>prontera,133,303,0,101,0</INFO></NAVI>にも神聖な刻印があるか確認しよう。"
		},
		Summary = "中央西側の壁にビラを貼る"
	},
	[21932] = {
		Title = "すべてのビラを貼った！",
		Description = {
			"プロンテラ北側の内壁の<NAVI>[北側]<INFO>prontera,168,304,0,101,0</INFO></NAVI>、<NAVI>[東側]<INFO>prontera,179,293,0,101,0</INFO></NAVI>、<NAVI>[西側]<INFO>prontera,133,303,0,101,0</INFO></NAVI>にすべてビラを貼った。「ルミネ」が話したアルナフェルツとはどんな国なのだろうか？"
		},
		Summary = ""
	},
	[21933] = {
		Title = "ジョブレベル10を目指せ！",
		Description = {
			"真の冒険者として生まれ変わるためには、ジョブを取得する必要がある。近くのフィールドで狩りを行い^4d4dffジョブレベル10に達した^000000ら、<NAVI>[セラピスト]<INFO>iz_ac01,60,43,0,101,0</INFO></NAVI>に報告しよう。"
		},
		Summary = "ジョブレベル10に到達する"
	},
	[21934] = {
		Title = "ルミネの伝言",
		IconName = "ico_nq.bmp",
		Description = {
			"パヨンで出会ったルミネが、井戸へ行ったレノが戻らないと言う。<NAVI>[井戸のそばのお爺さん]<INFO>payon,192,109,0,101,0</INFO></NAVI>にレノを見かけたか尋ね、ギルドを呼んで立ち去る彼に事情を話すよう頼もう。"
		},
		Summary = "井戸のそばのお爺さんに話しかける"
	},
	[21935] = {
		Title = "休息の時間",
		IconName = "ico_nq.bmp",
		Description = {
			"パヨン洞窟で苦労したレノが村のどこかで休んでいるようだ。<NAVI>[レノ]<INFO>payon,182,172,0,101,0</INFO></NAVI>と話したいなら、そこへ行こう。"
		},
		Summary = "レノに話しかける"
	},
	[21936] = {
		Title = "最後のイチゴを探せ",
		IconName = "ico_nq.bmp",
		Description = {
			"ロアム聖職者が、別の世話をする子供を見つけてほしいと頼んだ。プロンテラで<NAVI>[グースベリー]<INFO>prontera,248,212,0,101,0</INFO></NAVI>を見つけよう。彼は何か面倒なことに巻き込まれているかもしれない。"
		},
		Summary = "グースベリーに話しかける"
	},
	[21937] = {
		Title = "夕食への招待",
		IconName = "ico_nq.bmp",
		Description = {
			"聖職者リアムを通じて、時間が許す限り楽園を訪れてほしいというウルの頼みを聞いた。<NAVI>[楽園の食堂]<INFO>moc_para01,175,21,0,101,0</INFO></NAVI>へ行こう。"
