	},
	[60721] = {
		Title = "メギンギョルズの封印",
		Description = {
			"レバレフ・ドグに出発することを伝えよう。あ、でもその前に「最終任務」についてもっと詳しく調べておこう。"
		},
		Summary = ""
	},
	[60722] = {
		Title = "メギンギョルズの封印",
		Description = {
			"使用されていません"
		},
		Summary = ""
	},
	[60723] = {
		Title = "メギンギョルズの封印",
		Description = {
			"司書ジェカンに第1小隊の最終任務の書類が見つかったか尋ねよう。彼は目が悪いので、拡大鏡とランタンを必要としている。"
		},
		Summary = ""
	},
	[60724] = {
		Title = "メギンギョルズの封印",
		Description = {
			"司書ジェカンは忙しそうだ。しばらく「書類を読む」ふりをして、彼が「第3中隊の記録」をどこで確認すべきか見つけるまで棚を調べよう。"
		},
		Summary = ""
	},
	[60725] = {
		Title = "メギンギョルズの封印",
		Description = {
			"ジェカンが記録の写しを作るには、いくつかのアイテムが必要だ。アマツの油紙2枚と紙1枚、モロクの鳥の羽3枚、そしてゲフェンの青ジェムストーン20個だ。"
		},
		Summary = "これらのアイテムをジェカンに届けて、複製を早く完成させよう"
	},
	[60726] = {
		Title = "メギンギョルズの封印",
		Description = {
			"複製した記録には奇妙な検索魔法がかかっている。特定の情報を見つけるには、まず大まかな主題を調べ、それから絞り込んでいく必要がある：クルセイダー 第3中隊 第3小隊 第1分隊。"
		},
		Summary = "各隊員の名前を調べて、彼らが今どこにいるのかを突き止めよう"
	},
	[60727] = {
		Title = "メギンギョルズの封印",
		Description = {
			"ゲフェンの鍛冶ギルドにいるザン・ファドクを探そう。彼らの極秘最終任務についていきなり聞き出す前に、礼儀正しく彼の調子を尋ねよう。そう、それが近道だ！"
		},
		Summary = ""
	},
	[60728] = {
		Title = "メギンギョルズの封印",
		Description = {
			"ザン・フアドクから聞けることはすべて聞いたようだな。最後に目撃されたのは宿屋だという「クアケ・ドノン」を探しにモロクへ向かうといい。モロクでは頑固に攻める必要があるかもしれんぞ。"
		},
		Summary = ""
	},
	[60729] = {
		Title = "メギンギョルズの封印",
		Description = {
			"クアケ・ドノンはローグギルドの隠れ家にいる。おそらく「セントダメイン要塞（南）」だ（マップは Ctrl + ` で確認）。侵入のパスワードは「アラガムは強化アイテムを溜め込まなかった」のはずだ。"
		},
		Summary = "クアケは重度のPTSDに苦しんでおり「パニック」を起こす。彼が幼い子供であるかのように接するのがいいだろう、人形でもあればなおいいかも、ははは。"
	},
	[60730] = {
		Title = "メギンギョルズの封印",
		Description = {
			"クアケは小隊が「メギンギョルズ」を見つけ、口論になったと言った……その口論についてもっと知る必要がある。アルベルタの波止場にいるジャック・オーが手がかりを知っているかもしれない。"
		},
		Summary = "彼はまだ現役のクルセイダーなので、彼に話を聞くのはもっと素直なやり取りになりそうだ"
	},
	[60731] = {
		Title = "メギンギョルズの封印",
		Description = {
			"ジャック・オーは「緑ハーブ」でいくらか救われたようだ。この助言を他のクルセイダーたちにも伝えよう。エマ・サースはアルデバランにいる。イズルードへの船とカプラ転送を使えばすぐに着く！"
		},
		Summary = "クルセイダーたちの記憶を助けるものを考えてみよう。「ライドワード」から手に入る「しおり」のような、彼らの場所を思い出す助けになるものを。"
	},
	[60732] = {
		Title = "メギンギョルズの封印",
		Description = {
			"「ザ・ナインボール」に会いに急がなければ。彼はジャワイの宿屋の用心棒をしているらしい。プロンテラ中央の酒場にジャワイの元バーテンがいると聞いた。結婚しなくてもジャワイへ行く方法を知っているかもしれない！"
		},
		Summary = "ナインボールという名の用心棒は、かなり口の重いタイプのようだ。私の質問に少なくとも何らかの反応を返すまで、話し続けよう。"
	},
	[60733] = {
		Title = "メギンギョルズの封印",
		Description = {
			"蝶の羽でジャワイから脱出するか、飲んでルーンミッドガッツ王国へ戻るといい。コモドの南のカジノにいる「ロイヤル・ミスト」に会いに行こう。モロクからコモドへワープするのが通常一番簡単なルートだ。"
		},
		Summary = "「アルコール」を「数杯」飲ませば、ロイヤル・ミストの口も緩むかもしれない……"
	},
	[60734] = {
		Title = "メギンギョルズの封印",
		Description = {
			"生存している全クルセイダーに話を聞いた。何かが起こり、責任の押し付け合いが生じ、その過程でクルセイダーのエグニジェムが命を落としたようだ。プロンテラ城に戻り、調査結果を報告しよう。"
		},
		Summary = "プロンテラにセーブしていなければ、カプラ転送でコモドからモロク、プロンテラへ行くのが早い。"
	},
	[60735] = {
		Title = "メギンギョルズの封印",
		Description = {
			"第1班の最後のメンバーである故エグニゲムに話しかけるべきだ。カプラ転送でプロンテラからモロク、コモド、アンバラへ向かい、そこから北へ生命の木を抜けてニブルヘイムへ行けば会えるだろう。"
		},
		Summary = "エグニジェムの話を聞き、この事態をどう収めればよいか考えよう"
	},
	[60736] = {
		Title = "メギンギョルズの封印",
		Description = {
			"オーディンの慈悲よ、なんて恐ろしいことだ。聖なるクルセイダーがメギンギョルズの力を得るためにこんな邪悪な行いをするとは。勇気を出してクルセイダー本部へ戻り、マックス・フォン・シェドーに全てを伝えよう。"
		},
		Summary = ""
	},
	[60737] = {
		Title = "メギンギョルズの封印",
		Description = {
			"マックス・フォン・シェドーは報告を受け入れ、その内容に深く心を痛めている。しかし、善意があったにせよ、政治的な現実が介入して正義が実現することを妨げるかもしれないと、心のどこかで信じている。"
		},
		Summary = "少なくとも結果をエグニジェムに伝えなければ。彼は自分が何のために死んだのか、知るに値する。"
	},
	[60738] = {
		Title = "メギンギョルズの封印",
		Description = {
			"エグニジェムは残せる力のすべてをあなたに授けてくれた。彼が自分の運命を知ってほしいと願う特別な人物が一人いるはずだ。エマ・サースに彼の運命を伝えなければならない。"
		},
		Summary = ""
	},
	[60739] = {
		Title = "メギンギョルズの封印",
		Description = {
			"エマは思い出せないが、喪失感を感じている。正義への信頼は今や弱まっている……マックス・フォン・シェドーに、彼が裁く者であり、この罪の重荷を分かち合うべきだと伝えなければならない。"
		},
		Summary = "プロンテラ城のマックス・フォン・シェドーの元へ戻ろう"
	},
	[60801] = {
		Title = "WoEペットブリーダー",
		Description = {
			"WoE領域外のペットブリーダーから新たに乗り物を借りるには、タイマーの期限が切れるまで待つ必要がある。"
		},
		Summary = ""
	},
	[60810] = {
		Title = "限定VIPアクセス",
		Description = {
			"3日間、割引されたカプラサービス、Primo d'Buffer、VIPサービス転送、おじいさんから2つの討伐クエストと転送を利用できるようになります。タイマーの期限が切れると、アクセスできなくなります。"
		},
		Summary = "※VIP経験値ボーナス、追加キャラクタースロット、600倉庫はこのアクセスには含まれません"
	},
