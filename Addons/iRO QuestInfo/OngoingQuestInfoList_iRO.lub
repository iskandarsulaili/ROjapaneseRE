		Summary = ""
	},
	[21001] = {
		Title = "難破船からの脱出",
		IconName = "ico_gq.bmp",
		Description = {
			"嵐の後、無人島に難破した船から脱出しなければならない。船上に残された負傷者を探そう。"
		},
		Summary = "船長に話しかける"
	},
	[21002] = {
		Title = "最初の戦い",
		Description = {
			"ポリンに盗まれた船の修理材料を探そう。乗組員から<ITEM>木材<INFO>6008</INFO></ITEM>を2つ持ち帰るよう頼まれた。ポリンを倒して木材を取り戻そう。"
		},
		Summary = "木材を2つ乗組員に届ける"
	},
	[21003] = {
		Title = "乗り物酔いの特効薬",
		Description = {
			"旅で出会った友人レノの乗り物酔いを和らげるものを見つけて助けよう。^0000FFクリエイチュラ学院の診療所^000000にいる^0000FFセラピストにハーブ薬について聞いてみよう^000000。"
		},
		Summary = "セラピストにハーブ薬について聞く"
	},
	[21004] = {
		Title = "基礎的なハーブ薬",
		Description = {
			"セラピストがポーションの材料である赤い草を探してほしいと言っている。^0000FFクリエイチュラ学院の正門前^000000で^0000FF赤い草^000000を探そう。"
		},
		Summary = "クリエイチュラ学院の外で赤い草を探す"
	},
	[21005] = {
		Title = "位置を保存！",
		Description = {
			"無事に手に入れた。"
		},
		Summary = ""
	},
	[21006] = {
		Title = "レノへの良い知らせ",
		Description = {
			"セラピストから受け取ったものをレノに渡そう。"
		},
		Summary = "レノに話しかける"
	},
	[21007] = {
		Title = "初めての友人",
		Description = {
			"良い友人ができた。"
		},
		Summary = ""
	},
	[21008] = {
		Title = "最初の戦い",
		IconName = "ico_gq.bmp",
		Description = {
			"ポリンに盗まれた船の修理材料を探そう。乗組員から<ITEM>木材<INFO>6008</INFO></ITEM>を2つ持ち帰るよう頼まれた。ポリンを倒して木材を取り戻そう。"
		},
		Summary = "木材を2つ乗組員に届ける"
	},
	[21009] = {
		Title = "スプラキの呼び出し",
		Description = {
			"楽園からの依頼があり、ギルドからの呼び出しもある。イズルード北部のクリトゥラ学校の<NAVI>スプラキ<INFO>iz_ac01,102,44,0,101,0</INFO></NAVI>に会おう。"
		},
		Summary = "スプラキに話しかける"
	},
	[21011] = {
		Title = "デュラバックの酒",
		Description = {
			"パヨンにいる老人から、井戸に入れた酒を汲み上げてほしいと頼まれた。さっそく隣の井戸から酒を汲み上げてみよう。"
		},
		Summary = "井戸からの汲み上げ"
	},
	[21012] = {
		Title = "孫の行方",
		Description = {
			"パヨン北部の弓術の町からこっそり抜け出した祖父の孫を見つけなければならない。弓術の町にいる洞窟前のガードに尋ねよう。"
		},
		Summary = "洞窟のガードに話しかける"
	},
	[21013] = {
		Title = "一人見つけたが、誰もいない",
		Description = {
			"孫を探しに行ったレノはまだ洞窟にいる。彼は迎えに行くよう指名されたため、動けない。パヨン洞窟でレノを探そう。"
		},
		Summary = "洞窟内のレノに話しかける"
	},
	[21014] = {
		Title = "臭くて滑りやすい幽霊",
		Description = {
			"ゾンビなら、レノが驚くために周囲のゾンビを5体倒す必要がある。"
		},
		Summary = "レノのためにゾンビを狩る"
	},
	[21015] = {
		Title = "アンデッド戦争",
		IconName = "ico_dq.bmp",
		Description = {
			"ゾンビとスケルトンが増え続け、パヨンガードは参っている。数を減らすため、ゾンビ10体とスケルトン20体を倒すよう頼まれた。スケルトンは洞窟の奥に進まないと出現しない。"
		},
		Summary = "パヨン洞窟アンデッド処理"
	},
	[21016] = {
		Title = "アンデッド戦争・休憩",
		IconName = "ico_dq.bmp",
		Description = {
			"絶えず現れるアンデッドに対処するため、着実に排除する必要がある。"
		},
		Summary = "04:00にリセット",
		CoolTimeQuest = 1
	},
	[21017] = {
		Title = "魂の浄化の儀式",
		IconName = "ico_dq.bmp",
		Description = {
			"過去に失われた村の埋葬された魂を浄化するために、「半身の夫婦」が必要だ。本体を制圧し、半身の夫婦を集めよう。ムナックと主人公はパヨン洞窟の3階に出現する。"
		},
		Summary = "半身の夫婦 15体"
	},
	[21018] = {
		Title = "魂の浄化の儀式・休憩",
		IconName = "ico_dq.bmp",
		Description = {
			"強くなるたびに、浄化の儀式が必要だと言われている。時間が来たらいつでも行こう。"
		},
		Summary = "04:00にリセット",
		CoolTimeQuest = 1
	},
	[21019] = {
		Title = "酒で悲しみを癒す",
		IconName = "ico_dq.bmp",
		Description = {
			"気性の激しい僧侶が、澄んだ酒で鬼火を鎮め、魂の呼吸10個を受け取ってほしいと頼んでいる。澄んだ酒はパヨンのお祖父さんから入手でき、鬼火はパヨン洞窟4階の封鎖された村に出現する。"
		},
		Summary = "魂の呼吸 10個"
	},
	[21020] = {
		Title = "酒で悲しみを断ち切る",
		IconName = "ico_dq.bmp",
		Description = {
			"パヨン洞窟の廃村にはどれほど悲しい魂がいるのだろうか。僧侶は夜が明けたら戻って助けてほしいと頼んだ。"
		},
		Summary = "04:00にリセット",
		CoolTimeQuest = 1
	},
	[21021] = {
		Title = "反魔法の痕跡",
		IconName = "ico_dq.bmp",
		Description = {
			"魔法の痕跡を見つけるために少女のハンカチが必要な理由はわからないが、若い学者の依頼で、少女のハンカチが3枚必要だ。少女のハンカチはパヨン洞窟の封鎖された村に出現するソヒーから入手できる。"
		},
		Summary = "少女のハンカチ 3枚"
	},
	[21022] = {
		Title = "反魔法の処理",
		IconName = "ico_dq.bmp",
		Description = {
			"少女のハンカチに執着する若い学者は、可能であれば毎日手伝ってほしいと言っている。少女のハンカチという研究材料を集めることに興味があるなら、戻ろう。"
		},
		Summary = "04:00にリセット",
		CoolTimeQuest = 1
	},
	[21023] = {
		Title = "狐狩り",
		IconName = "ico_dq.bmp",
		Description = {
			"魂が仏の村に縛られているのは、狐の妖怪ウォルヤファの仕業だ。パヨンの長老たちはウォルヤファを倒すことを決めた。^0000FF倒した後に得た狐玉を持った弓術師^000000がいる仏像のある町へ行こう。"
		},
		Summary = "玉を習得した後、仏像前の長老に話しかける"
	},
	[21024] = {
		Title = "狐狩り続行",
		IconName = "ico_dq.bmp",
		Description = {
			"ウォルニャのウォルファファは様々な手口で偽の命を与え、村から離れさせない。すでに死によって取り残された他の魂と同じ魂なのかもしれない。"
		},
		Summary = "04:00にリセット",
		CoolTimeQuest = 1
	},
	[21025] = {
		Title = "ずっと昔の話",
		Description = {
			"パヨンの町の成り立ちを長老から聞いた。"
		},
		Summary = ""
	},
	[21026] = {
		Title = "薪を待つ燃える心",
		Description = {
			"薪作りをしたいと言っていた息子が戻ってこない。息子の「ドンドン」はパヨン南部の森に薪を拾いに行ったようだ。探しに行こう。"
		},
		Summary = "のんきな仲間に話しかける"
	},
	[21027] = {
		Title = "あの木は何だ？",
		Description = {
			"木を手に入れたいなら、ウィローを捕まえて「乾いた木片」を手に入れる必要があるが、彼には難しすぎるとドンドンは言った。代わりにウィローを3匹捕まえて「乾いた木片」を2つ手に入れよう。"
		},
		Summary = "乾いた木片 2個"
	},
	[21028] = {
		Title = "蜜のように甘い仕事",
		IconName = "ico_dq.bmp",
		Description = {
			"息子の代わりに木を届けることにした。パヨン南部の森で「ウィロー」から「木片」を3つ手に入れ、待ちきれないでいる中年のおじさんに届けよう。"
		},
		Summary = "乾いた木片 3個"
	},
	[21029] = {
		Title = "待機中",
		IconName = "ico_dq.bmp",
		Description = {
			"パヨンの中年の男は、息子の代わりに木を植えてほしいとまだ思っている。"
		},
		Summary = "04:00にリセット",
		CoolTimeQuest = 1
	},
	[21030] = {
		Title = "子供たちのための行動",
		Description = {
			"パヨン東部の森からやってくるボアのせいで子供が怪我をするのではないかと心配している少女のために、ボアを倒そう。"
		},
		Summary = "ボア狩り"
	},
	[21031] = {
		Title = "プロの蛇ハンター",
		IconName = "ico_dq.bmp",
		Description = {
			"パヨン東部の森のボアを着実に捕まえることにした。今日はボアを5匹倒そう。"
		},
		Summary = "ボア狩り"
	},
	[21032] = {
		Title = "プロスネークハンター [待機]",
		IconName = "ico_dq.bmp",
		Description = {
			"パヨンの少女は、子供たちが安全に遊べるように誰かにボアを着実に狩ってほしいと思っているようだ。またあちらに行って助けよう。"
		},
		Summary = "04:00にリセット",
		CoolTimeQuest = 1
	},
	[21033] = {
		Title = "奇妙な玉葱",
		Description = {
			"パヨンのお祖母さんは森の中で奇妙な形の玉葱を見たと言った。「ワームテール」と呼ばれるその玉葱が本物の玉葱かどうか確かめたいそうだ。ワームテイルを捕まえて「鱗のある茎」を1つ手に入れよう。"
		},
		Summary = "鱗 1個"
	},
	[21034] = {
		Title = "有害な玉葱だ。",
		IconName = "ico_dq.bmp",
		Description = {
			"ワームテールが紛らわしい存在だと気づいたお祖母さんは、ワームテールを倒してほしいと頼んだ。ワームテールはパヨン東部の森で見られる。"
		},
		Summary = "ワームテール狩り"
	},
	[21035] = {
		Title = "有害なタマネギだ。 [待機]",
		IconName = "ico_dq.bmp",
		Description = {
			"ワームテール狩りは続く。日が来たらまたパヨンのお祖母さんを訪ねよう。"
		},
		Summary = "04:00にリセット",
		CoolTimeQuest = 1
	},
	[21036] = {
		Title = "奇妙なキノコ",
		Description = {
			"パヨンのお祖父さんは東の森で怪しいキノコを見たと言った。料理がはっきりしているので、「スポラ」と呼ばれるキノコを倒してほしいと頼んだ。"
		},
		Summary = "スポア狩り"
	},
	[21037] = {
		Title = "キノコ天国の前に。",
		IconName = "ico_dq.bmp",
		Description = {
			"パヨンのお祖父さんはスポアの繁殖力に驚いているようだ。胞子で覆われる前に東の森で倒してほしいと頼んでいる。スポアを狩ろう！"
		},
		Summary = "スポア狩り"
	},
	[21038] = {
		Title = "キノコ天国の前に。 [待機]",
		IconName = "ico_dq.bmp",
		Description = {
			"スポアの悩みを根絶する準備ができたら、戻ろう。"
		},
		Summary = "04:00にリセット",
		CoolTimeQuest = 1
	},
	[21039] = {
		Title = "君しか信じない！",
		Description = {
			"ドンドンが代わりに木をくれた。とにかく、知らせを待っているドンドンが父親を訪ねて話そう。"
		},
		Summary = "待ちきれない中年の男に話しかける"
	},
	[21040] = {
		Title = "脱獄を夢見る囚人たち",
		IconName = "ico_dq.bmp",
		Description = {
			"グラスヘイムの地下牢獄では、闇のエネルギーによって既に死んでいる囚人がアンデッドとして蘇っている。終わりのなく湧き出るゾンビの対処に疲れたカロン神父は、スケルフリズナーとゾンビフリズナーの討伐を依頼した。"
		},
		Summary = "スケルフリズナー、ゾンビフリズナーを倒す"
	},
	[21041] = {
		Title = "脱獄を夢見る囚人たち [待機]",
		IconName = "ico_dq.bmp",
		Description = {
			"このクエストはデイリークエストで、待機時間が過ぎると再受注できる。楽園の掲示板またはグラストヘイムのカロンを通じてクエストを受注できる。"
		},
		Summary = "04:00にリセット",
		CoolTimeQuest = 1
	},
	[21042] = {
		Title = "悪辣な参謀",
		IconName = "ico_dq.bmp",
		Description = {
			"グラスヘイムの地下監獄は混沌とする悪魔たちに悩まされているという。カロンを助けたが、ナディルは苦戦しており、力が足りなかった。ナディルはリビオの討伐を依頼してきた。"
		},
		Summary = "キエル・リビオ"
	},
	[21043] = {
		Title = "悪徳相談役 [待機]",
		IconName = "ico_dq.bmp",
		Description = {
			"このクエストはデイリークエストであり、待機時間が終了すると再び受けることができます。楽園の掲示板またはグラスヘイムのナディルを通じてクエストを受けることができます。"
		},
		Summary = "04:00にリセット",
		CoolTimeQuest = 1
	},
	[21044] = {
		Title = "高貴な味",
		IconName = "ico_dq.bmp",
		Description = {
