	},
	[21316] = {
		Title = "可愛くて恐ろしい..",
		Description = {
			"アインブロック近くの野外で、熊の形をした悪質な自動人形が人を襲って問題になっている。アインブロックのアイゼンは、可愛らしい外見に騙されず、テディベアを破壊してほしいと頼んできた。"
		},
		Summary = "クマ人形を駆除"
	},
	[21317] = {
		Title = "可愛くて恐ろしい.. [待機]",
		Description = {
